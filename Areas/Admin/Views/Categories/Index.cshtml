@model AdminListViewModel<Category>
@{
    ViewData["Title"] = "Categories";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    var named = Model.Items.Count(c => !string.IsNullOrWhiteSpace(c.Description));

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Catalogue",
        Title = "Categories",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "The shelves everything else is filed under. Renaming a category updates " +
               "the public filters, the Explore sidebar and the content grid together.",
        ActionText = "New category",
        ActionUrl = Url.Action("Create"),
        ActionIcon = "ri-price-tag-3-line",
        Chips =
        {
            new AdminHeroChip("ri-file-text-line", named.ToString("N0"), "with a description"),
            new AdminHeroChip("ri-layout-list-line", Model.Items.Count.ToString("N0"), "on this page"),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", Model.Search!, "search", true));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-folder-2-line" aria-hidden="true"></i>
                Shelves
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search category..." aria-label="Search categories" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-price-tag-3-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nothing matches that search." : "No categories yet.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Icon</th>
                                <th class="fhp-num" style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.Items)
                            {
                                <tr>
                                    <td class="fhp-table__title">@cat.Name</td>
                                    <td class="fhp-dcell-meta">
                                        @(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(cat.IconUrl))
                                        {
                                            <img class="fhp-dthumb" src="@cat.IconUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="fhp-dmuted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fhp-drow">
                                            <a class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm" asp-action="Edit" asp-route-id="@cat.CategoryId">
                                                <i class="ri-edit-line" aria-hidden="true"></i>
                                                <span>Edit</span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@cat.CategoryId" method="post"
                                                  onsubmit="return confirm('Delete the @cat.Name category? Items in it must be moved first.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="AdminPagerViewModel.From(Model)" />

</div>
