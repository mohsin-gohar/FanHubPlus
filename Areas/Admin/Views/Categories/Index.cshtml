@model AdminListViewModel<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title h3 mb-0">🏷 Categories</h1>
    <a asp-action="Create" class="btn btn-primary">＋ New category</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width:360px;">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search category..." />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="small text-muted">@(c.Description?.Length > 80 ? c.Description[..80] + "…" : c.Description)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete category @c.Name?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No categories found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page - 1)">«</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page + 1)">»</a>
            </li>
        </ul>
    </nav>
}
