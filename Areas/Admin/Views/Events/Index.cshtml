@model AdminListViewModel<EventItem>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title h3 mb-0">📅 Events (@Model.TotalItems)</h1>
    <a asp-action="Create" class="btn btn-primary">＋ New event</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width:360px;">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search title or city..." />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>City</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@e.Title</td>
                        <td class="small">@e.City</td>
                        <td><span class="badge bg-secondary rounded-pill">@(e.Type ?? "Event")</span></td>
                        <td class="small text-muted">@e.EventDate.ToString("MMM d, yyyy HH:mm")</td>
                        <td>
                            @if (e.EventDate >= DateTime.UtcNow)
                            {
                                <span class="badge bg-success">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Past</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete event @e.Title?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No events found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page - 1)">«</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page + 1)">»</a>
            </li>
        </ul>
    </nav>
}
