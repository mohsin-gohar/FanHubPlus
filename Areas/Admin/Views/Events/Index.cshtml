@model AdminListViewModel<EventItem>
@{
    ViewData["Title"] = "Events";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    var now = DateTime.UtcNow;
    var upcoming = Model.Items.Count(e => e.EventDate >= now);
    var mapped = Model.Items.Count(e => e.Latitude != 0 && e.Longitude != 0);

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Community",
        Title = "Events",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "Conventions, screenings and signings. Latitude and longitude are what drop " +
               "a pin on the public map, so fill them in for anything on tour.",
        ActionText = "New event",
        ActionUrl = Url.Action("Create"),
        ActionIcon = "ri-calendar-event-line",
        Chips =
        {
            new AdminHeroChip("ri-time-line", upcoming.ToString("N0"), "still to come"),
            new AdminHeroChip("ri-map-pin-line", mapped.ToString("N0"), "mapped on this page"),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", Model.Search!, "search", true));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-calendar-event-line" aria-hidden="true"></i>
                Schedule
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search title or city..." aria-label="Search events" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-calendar-event-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nothing matches that search." : "No events scheduled.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>City</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="fhp-num" style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Items)
                            {
                                <tr>
                                    <td class="fhp-table__title">@e.Title</td>
                                    <td>@e.City</td>
                                    <td><span class="fhp-pill fhp-pill--neutral">@(e.Type ?? "Event")</span></td>
                                    <td class="fhp-dcell-meta">@e.EventDate.ToString("MMM d, yyyy HH:mm")</td>
                                    <td>
                                        <span class="fhp-pill @(e.EventDate >= now ? "fhp-pill--ok" : "fhp-pill--bad")">
                                            @(e.EventDate >= now ? "Upcoming" : "Past")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fhp-drow">
                                            <a class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm" asp-action="Edit" asp-route-id="@e.EventId">
                                                <i class="ri-edit-line" aria-hidden="true"></i>
                                                <span>Edit</span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post"
                                                  onsubmit="return confirm('Delete event @e.Title?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="AdminPagerViewModel.From(Model)" />

</div>
