@model EventFormViewModel
@{
    var isEdit = Model.EventId != 0;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
    var mapped = Model.Latitude != 0d && Model.Longitude != 0d;

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Community",
        Title = isEdit ? "Edit event" : "New event",
        Accent = isEdit ? Model.Title : null,
        Lede = isEdit
            ? "Date and location decide whether the event shows as upcoming and where its pin lands on the map."
            : "Give it a date, a city and coordinates if you want it on the public map.",
        BackText = "Back to events",
        BackUrl = Url.Action("Index"),
        Chips =
        {
            new AdminHeroChip("ri-map-pin-line", mapped ? "Yes" : "No", "mapped"),
            new AdminHeroChip("ri-calendar-line", Model.EventDate.ToString("d MMM yyyy"), "date"),
        }
    };
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-calendar-event-line" aria-hidden="true"></i>
                Event details
            </h2>
            <span class="fhp-panel__hint">@(isEdit ? $"Editing #{Model.EventId}" : "New record")</span>
        </header>
        <div class="fhp-panel__body">
            <form class="fhp-dform" action="@(isEdit ? Url.Action("Edit", new { id = Model.EventId }) : Url.Action("Create"))"
                  method="post">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="EventId" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label"></label>
                        <input asp-for="Type" class="form-control" placeholder="Convention, Screening..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Latitude" class="form-label"></label>
                        <input asp-for="Latitude" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Latitude" class="text-danger small"></span>
                        <div class="form-text">Used for the Leaflet map pin (e.g. 35.6812).</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Longitude" class="form-label"></label>
                        <input asp-for="Longitude" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Longitude" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="TicketUrl" class="form-label"></label>
                        <input asp-for="TicketUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <div class="col-12">
                        <label asp-for="Story" class="form-label"></label>
                        <textarea asp-for="Story" class="form-control" rows="5"
                                  placeholder="Event description / story..."></textarea>
                        <span asp-validation-for="Story" class="text-danger small"></span>
                    </div>
                </div>

                <hr />
                <div class="fhp-dform__actions">
                    <button type="submit" class="fhp-dbtn fhp-dbtn--gold">
                        <i class="ri-save-3-line" aria-hidden="true"></i>
                        <span>Save event</span>
                    </button>
                    <a asp-action="Index" class="fhp-dbtn fhp-dbtn--ghost">
                        <i class="ri-close-line" aria-hidden="true"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
