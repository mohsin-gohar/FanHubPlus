@model MerchFormViewModel
@{
    var isEdit = Model.ItemId != 0;
    ViewData["Title"] = isEdit ? "Edit merchandise" : "New merchandise";

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Store",
        Title = isEdit ? "Edit merchandise" : "New merchandise",
        Accent = isEdit ? Model.Name : null,
        Lede = isEdit
            ? "The tag and the release date drive the ribbons and the availability badge on the public store."
            : "Name, shelf, price ribbon and a release date is all the store card needs.",
        BackText = "Back to merchandise",
        BackUrl = Url.Action("Index"),
        Chips =
        {
            new AdminHeroChip("ri-price-tag-3-line", Model.Tag.ToString(), "tag"),
            new AdminHeroChip("ri-time-line", Model.IsUpcoming ? "Upcoming" : "Available", "status"),
        }
    };
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-shirt-line" aria-hidden="true"></i>
                Item details
            </h2>
            <span class="fhp-panel__hint">@(isEdit ? $"Editing #{Model.ItemId}" : "New record")</span>
        </header>
        <div class="fhp-panel__body">
            <form class="fhp-dform" action="@(isEdit ? Url.Action("Edit", new { id = Model.ItemId }) : Url.Action("Create"))"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="ItemId" />
                    <input type="hidden" asp-for="ImageUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Tag" class="form-label"></label>
                        <select asp-for="Tag" class="form-select" asp-items="Html.GetEnumSelectList<MerchTag>()"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReleaseDate" class="form-label"></label>
                        <input asp-for="ReleaseDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="IsUpcoming" class="form-check-input" />
                            <label asp-for="IsUpcoming" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="fhp-dform__preview">
                                <img src="@Model.ImageUrl" alt="current image" />
                                <span>Leave empty to keep the current image.</span>
                            </div>
                        }
                    </div>
                </div>

                <hr />
                <div class="fhp-dform__actions">
                    <button type="submit" class="fhp-dbtn fhp-dbtn--gold">
                        <i class="ri-save-3-line" aria-hidden="true"></i>
                        <span>Save item</span>
                    </button>
                    <a asp-action="Index" class="fhp-dbtn fhp-dbtn--ghost">
                        <i class="ri-close-line" aria-hidden="true"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
