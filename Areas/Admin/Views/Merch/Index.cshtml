@model AdminListViewModel<MerchandiseItem>
@{
    ViewData["Title"] = "Merchandise";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title h3 mb-0">🛍 Merchandise (@Model.TotalItems)</h1>
    <a asp-action="Create" class="btn btn-primary">＋ New item</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width:360px;">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name..." />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px;">Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Tag</th>
                    <th>Release</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(m.ImageUrl))
                            {
                                <img src="@m.ImageUrl" alt="" style="width:56px;height:40px;object-fit:cover;border-radius:6px;" />
                            }
                            else
                            {
                                <div class="cover-fallback" style="width:56px;height:40px;font-size:.6rem;border-radius:6px;padding:.2rem;">🛍</div>
                            }
                        </td>
                        <td class="fw-semibold">@m.Name</td>
                        <td><span class="badge bg-secondary rounded-pill">@m.Category.Name</span></td>
                        <td>
                            @if (m.Tag != MerchTag.None)
                            {
                                <span class="badge rounded-pill @(m.Tag == MerchTag.LimitedEdition ? "bg-danger" : m.Tag == MerchTag.PreOrder ? "bg-info" : "bg-warning text-dark")">@m.Tag</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small text-muted">@(m.ReleaseDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td>
                            @if (m.IsUpcoming)
                            {
                                <span class="badge bg-warning text-dark">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@m.ItemId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@m.ItemId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete @m.Name? Its image file is removed too.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No merchandise found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page - 1)">«</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Model.Page + 1)">»</a>
            </li>
        </ul>
    </nav>
}
