@model AdminListViewModel<MerchandiseItem>
@{
    ViewData["Title"] = "Merchandise";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    var limited = Model.Items.Count(m => m.Tag == MerchTag.LimitedEdition);
    var upcoming = Model.Items.Count(m => m.IsUpcoming);

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Store",
        Title = "Merchandise",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "The store shelf. Tags drive the ribbons the public sees, and the release " +
               "date decides whether a drop is announced as upcoming or available.",
        ActionText = "New item",
        ActionUrl = Url.Action("Create"),
        ActionIcon = "ri-shirt-line",
        Chips =
        {
            new AdminHeroChip("ri-gem-line", limited.ToString("N0"), "limited editions"),
            new AdminHeroChip("ri-time-line", upcoming.ToString("N0"), "pre-order or upcoming"),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", Model.Search!, "search", true));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-shopping-bag-3-line" aria-hidden="true"></i>
                Shelf
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search name..." aria-label="Search merchandise" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-shirt-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nothing matches that search." : "The shelf is empty.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th style="width:70px;">Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Tag</th>
                                <th>Release</th>
                                <th>Status</th>
                                <th class="fhp-num" style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Items)
                            {
                                var tagPill = m.Tag switch
                                {
                                    MerchTag.LimitedEdition => "fhp-pill--bad",
                                    MerchTag.PreOrder => "fhp-pill--info",
                                    _ => "fhp-pill--warn"
                                };
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(m.ImageUrl))
                                        {
                                            <img class="fhp-dthumb" src="@m.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="fhp-dthumb-fallback" aria-hidden="true"><i class="ri-shirt-line"></i></span>
                                        }
                                    </td>
                                    <td class="fhp-table__title">@m.Name</td>
                                    <td><span class="fhp-pill fhp-pill--neutral">@m.Category.Name</span></td>
                                    <td>
                                        @if (m.Tag != MerchTag.None)
                                        {
                                            <span class="fhp-pill @tagPill">@m.Tag</span>
                                        }
                                        else
                                        {
                                            <span class="fhp-dmuted">—</span>
                                        }
                                    </td>
                                    <td class="fhp-dcell-meta">@(m.ReleaseDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                    <td>
                                        <span class="fhp-pill @(m.IsUpcoming ? "fhp-pill--warn" : "fhp-pill--ok")">
                                            @(m.IsUpcoming ? "Upcoming" : "Available")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fhp-drow">
                                            <a class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm" asp-action="Edit" asp-route-id="@m.ItemId">
                                                <i class="ri-edit-line" aria-hidden="true"></i>
                                                <span>Edit</span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@m.ItemId" method="post"
                                                  onsubmit="return confirm('Delete @m.Name? Its image file is removed too.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="AdminPagerViewModel.From(Model)" />

</div>

