@model AdminListViewModel<Feedback>
@{
    ViewData["Title"] = "Feedback";
    var statusFilter = (FeedbackStatus?)ViewBag.StatusFilter;
}

<h1 class="page-title h3 mb-3">💬 Feedback moderation</h1>

@* ---- Status filter tabs ---- *@
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(statusFilter is null ? "active" : "")" asp-action="Index">All</a>
    </li>
    @foreach (var s in Enum.GetValues<FeedbackStatus>())
    {
        <li class="nav-item">
            <a class="nav-link @(statusFilter == s ? "active" : "")"
               asp-action="Index" asp-route-status="@s">@s</a>
        </li>
    }
</ul>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:110px;">Type</th>
                    <th>Message</th>
                    <th style="width:130px;">From</th>
                    <th style="width:120px;">Date</th>
                    <th style="width:150px;">Status</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Items)
                {
                    <tr>
                        <td><span class="badge rounded-pill @(f.Type == FeedbackType.Bug ? "bg-danger" : f.Type == FeedbackType.Suggestion ? "bg-info" : "bg-secondary")">@f.Type</span></td>
                        <td class="small">@f.Message</td>
                        <td class="small">@(f.User?.Name ?? "Visitor")</td>
                        <td class="small text-muted">@f.CreatedAt.ToString("MMM d, HH:mm")</td>
                        <td>
                            <form asp-action="UpdateStatus" asp-route-id="@f.FeedbackId" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <select name="status" class="form-select form-select-sm"
                                        asp-items="Html.GetEnumSelectList<FeedbackStatus>()"
                                        selected="@f.Status"></select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">✔</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@f.FeedbackId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this feedback?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No feedback in this view.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link" href="?status=@statusFilter&page=@(Model.Page - 1)">«</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link" href="?status=@statusFilter&page=@(Model.Page + 1)">»</a>
            </li>
        </ul>
    </nav>
}
