@model AdminListViewModel<CharacterProfile>
@{
    ViewData["Title"] = "Characters";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    var fanzine = Model.Items.Count(c => !string.IsNullOrWhiteSpace(c.Fandom));

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Universe",
        Title = "Characters",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "The cast behind the titles. Each profile carries a portrait, the fandom it " +
               "belongs to and the shelf it is filed under on the public site.",
        ActionText = "New character",
        ActionUrl = Url.Action("Create"),
        ActionIcon = "ri-contacts-book-2-line",
        Chips =
        {
            new AdminHeroChip("ri-team-line", fanzine.ToString("N0"), "tagged with a fandom"),
            new AdminHeroChip("ri-layout-list-line", Model.Items.Count.ToString("N0"), "on this page"),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", Model.Search!, "search", true));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-contacts-book-2-line" aria-hidden="true"></i>
                Cast
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search name..." aria-label="Search characters" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-contacts-book-2-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nothing matches that search." : "No characters yet.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th style="width:70px;">Image</th>
                                <th>Name</th>
                                <th>Fandom</th>
                                <th>Category</th>
                                <th class="fhp-num" style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.ImageUrl))
                                        {
                                            <img class="fhp-dthumb fhp-dthumb--round" src="@c.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="fhp-dthumb-fallback fhp-dthumb-fallback--round" aria-hidden="true">
                                                <i class="ri-user-3-line"></i>
                                            </span>
                                        }
                                    </td>
                                    <td class="fhp-table__title">@c.Name</td>
                                    <td class="fhp-dcell-meta">@(c.Fandom ?? "—")</td>
                                    <td><span class="fhp-pill fhp-pill--neutral">@c.Category.Name</span></td>
                                    <td>
                                        <div class="fhp-drow">
                                            <a class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm" asp-action="Edit" asp-route-id="@c.CharacterId">
                                                <i class="ri-edit-line" aria-hidden="true"></i>
                                                <span>Edit</span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@c.CharacterId" method="post"
                                                  onsubmit="return confirm('Delete @c.Name? Its image file is removed too.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="AdminPagerViewModel.From(Model)" />

</div>
