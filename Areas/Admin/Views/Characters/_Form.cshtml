@model CharacterFormViewModel
@{
    var isEdit = Model.CharacterId != 0;
    ViewData["Title"] = isEdit ? "Edit character" : "New character";

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Universe",
        Title = isEdit ? "Edit character" : "New character",
        Accent = isEdit ? Model.Name : null,
        Lede = isEdit
            ? "The portrait and bio feed the character page and the public cast rail."
            : "Name, portrait and the shelf it belongs to are enough to get started.",
        BackText = "Back to characters",
        BackUrl = Url.Action("Index"),
        Chips =
        {
            new AdminHeroChip("ri-team-line", string.IsNullOrWhiteSpace(Model.Fandom) ? "—" : Model.Fandom!, "fandom"),
            new AdminHeroChip("ri-price-tag-3-line", Model.Categories.Count.ToString("N0"), "categories available"),
        }
    };
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-contacts-book-2-line" aria-hidden="true"></i>
                Profile
            </h2>
            <span class="fhp-panel__hint">@(isEdit ? $"Editing #{Model.CharacterId}" : "New record")</span>
        </header>
        <div class="fhp-panel__body">
            <form class="fhp-dform" action="@(isEdit ? Url.Action("Edit", new { id = Model.CharacterId }) : Url.Action("Create"))"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="CharacterId" />
                    <input type="hidden" asp-for="ImageUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Fandom" class="form-label"></label>
                        <input asp-for="Fandom" class="form-control" placeholder="e.g. Naruto, Marvel..." />
                        <span asp-validation-for="Fandom" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" class="form-control" accept="image/*" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="fhp-dform__preview fhp-dform__preview--round">
                                <img src="@Model.ImageUrl" alt="current image" />
                                <span>Leave empty to keep the current image.</span>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="6"
                                  placeholder="Character biography / background..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>
                </div>

                <hr />
                <div class="fhp-dform__actions">
                    <button type="submit" class="fhp-dbtn fhp-dbtn--gold">
                        <i class="ri-save-3-line" aria-hidden="true"></i>
                        <span>Save character</span>
                    </button>
                    <a asp-action="Index" class="fhp-dbtn fhp-dbtn--ghost">
                        <i class="ri-close-line" aria-hidden="true"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
