@model AdminListViewModel<Article>
@{
    ViewData["Title"] = "Articles";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    var timeline = Model.Items.Count(a => a.IsTimeline);

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Community",
        Title = "Articles",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "News posts and the canon timeline. Both are authored here and published to " +
               "the Blog and News pages the moment they go live.",
        ActionText = "New article",
        ActionUrl = Url.Action("Create"),
        ActionIcon = "ri-quill-pen-line",
        Chips =
        {
            new AdminHeroChip("ri-timeline-line", timeline.ToString("N0"), "timeline entries on this page"),
            new AdminHeroChip("ri-layout-list-line", Model.Items.Count.ToString("N0"), "on this page"),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", Model.Search!, "search", true));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-newspaper-line" aria-hidden="true"></i>
                Stories
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Search title..." aria-label="Search articles" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-newspaper-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nothing matches that search." : "No articles yet.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Author</th>
                                <th>Published</th>
                                <th>Kind</th>
                                <th class="fhp-num" style="width:150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Items)
                            {
                                <tr>
                                    <td class="fhp-table__title">@a.Title</td>
                                    <td><span class="fhp-pill fhp-pill--neutral">@a.Category.Name</span></td>
                                    <td class="fhp-dcell-meta">@(a.Author?.Name ?? "—")</td>
                                    <td class="fhp-dcell-meta">@a.PublishedAt.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <span class="fhp-pill @(a.IsTimeline ? "fhp-pill--warn" : "fhp-pill--ok")">
                                            @(a.IsTimeline ? "Timeline" : "News")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fhp-drow">
                                            <a class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm" asp-action="Edit" asp-route-id="@a.ArticleId">
                                                <i class="ri-edit-line" aria-hidden="true"></i>
                                                <span>Edit</span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@a.ArticleId" method="post"
                                                  onsubmit="return confirm('Delete this article?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="AdminPagerViewModel.From(Model)" />

</div>
