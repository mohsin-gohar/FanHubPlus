@model ArticleFormViewModel
@{
    var isEdit = Model.ArticleId != 0;
    ViewData["Title"] = isEdit ? "Edit article" : "New article";

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Community",
        Title = isEdit ? "Edit article" : "New article",
        Accent = isEdit ? Model.Title : null,
        Lede = isEdit
            ? "The post is already on the site - edits appear immediately on the News and Blog pages."
            : "Write it, pick a category, and flip Is Timeline when it belongs to the canon order.",
        BackText = "Back to articles",
        BackUrl = Url.Action("Index"),
        Chips =
        {
            new AdminHeroChip("ri-price-tag-3-line", Model.Categories.Count.ToString("N0"), "categories available"),
            new AdminHeroChip(Model.IsTimeline ? "ri-timeline-line" : "ri-newspaper-line",
                Model.IsTimeline ? "Timeline" : "News", "kind"),
        }
    };
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-quill-pen-line" aria-hidden="true"></i>
                Story
            </h2>
            <span class="fhp-panel__hint">@(isEdit ? $"Editing #{Model.ArticleId}" : "New record")</span>
        </header>
        <div class="fhp-panel__body">
            <form class="fhp-dform" action="@(isEdit ? Url.Action("Edit", new { id = Model.ArticleId }) : Url.Action("Create"))"
                  method="post">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="ArticleId" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PublishedAt" class="form-label"></label>
                        <input asp-for="PublishedAt" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="IsTimeline" class="form-check-input" />
                            <label asp-for="IsTimeline" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Body" class="form-label"></label>
                        <textarea asp-for="Body" class="form-control" rows="12"
                                  placeholder="<p>Write the article body (HTML allowed - admins only)...</p>"></textarea>
                        <span asp-validation-for="Body" class="text-danger small"></span>
                        <div class="form-text">HTML is allowed — only admin accounts can author articles (trusted input).</div>
                    </div>
                </div>

                <hr />
                <div class="fhp-dform__actions">
                    <button type="submit" class="fhp-dbtn fhp-dbtn--gold">
                        <i class="ri-save-3-line" aria-hidden="true"></i>
                        <span>Save article</span>
                    </button>
                    <a asp-action="Index" class="fhp-dbtn fhp-dbtn--ghost">
                        <i class="ri-close-line" aria-hidden="true"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
