@model ArticleFormViewModel
@{
    var isEdit = Model.ArticleId != 0;
    ViewData["Title"] = isEdit ? "Edit article" : "New article";
}

<h1 class="page-title h3 mb-3">@(isEdit ? "✏️ Edit article" : "＋ New article")</h1>
 
<div class="card border-0 shadow-sm" style="max-width:860px;">
    <div class="card-body p-4">
        <form action="@(isEdit ? Url.Action("Edit", new { id = Model.ArticleId }) : Url.Action("Create"))"
              method="post">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input type="hidden" asp-for="ArticleId" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="PublishedAt" class="form-label"></label>
                    <input asp-for="PublishedAt" class="form-control" type="datetime-local" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="IsTimeline" class="form-check-input" />
                        <label asp-for="IsTimeline" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Body" class="form-label"></label>
                    <textarea asp-for="Body" class="form-control" rows="12"
                              placeholder="<p>Write the article body (HTML allowed - admins only)...</p>"></textarea>
                    <span asp-validation-for="Body" class="text-danger small"></span>
                    <div class="form-text">HTML is allowed — only admin accounts can author articles (trusted input).</div>
                </div>
            </div>

            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save article</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
