@model List<AdminUserRowViewModel>
@{
    ViewData["Title"] = "Users";
    var search = (string?)ViewBag.Search;
    var pageNum = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
    var searching = !string.IsNullOrWhiteSpace(search);

    var admins = Model.Count(r => r.Roles.Contains("Admin"));
    var locked = Model.Count(r => r.User.LockoutEnd is not null && r.User.LockoutEnd > DateTimeOffset.UtcNow);

    // Paging keeps whatever is in the search box.
    var pager = AdminPagerViewModel.Build(pageNum, totalPages,
        p => $"?page={p}&search={Uri.EscapeDataString(search ?? "")}");

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · System",
        Title = "Users",
        Accent = totalItems.ToString("N0"),
        Lede = "Every account on the portal, with the roles it holds and whether it is " +
               "locked out. Role changes take effect on the member's next request.",
        Chips =
        {
            new AdminHeroChip("ri-shield-user-line", admins.ToString("N0"), "admins on this page"),
            new AdminHeroChip("ri-lock-2-line", locked.ToString("N0"), "locked right now", true),
        }
    };
    if (searching)
    {
        hero.Chips.Add(new AdminHeroChip("ri-search-line", search!, "search"));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-group-line" aria-hidden="true"></i>
                Members
            </h2>
            <span class="fhp-panel__hint">@Model.Count of @totalItems</span>
        </header>
        <div class="fhp-panel__body">
            <form method="get" class="fhp-dtools fhp-dtoolbar">
                <div class="fhp-dsearch fhp-dtools__grow">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="text" name="search" value="@search"
                           placeholder="Search e-mail or name..." aria-label="Search users" />
                    <button type="submit" title="Search"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></button>
                </div>
                <button class="fhp-dbtn fhp-dbtn--gold" type="submit">Search</button>
                @if (searching)
                {
                    <a class="fhp-dbtn fhp-dbtn--ghost" asp-action="Index">Reset</a>
                }
            </form>

            @if (Model.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-group-line" aria-hidden="true"></i>
                    <span>@(searching ? "Nobody matches that search." : "No users yet.")</span>
                </div>
            }
            else
            {
                <div class="fhp-table-wrap">
                    <table class="fhp-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>E-mail</th>
                                <th>Roles</th>
                                <th>Joined</th>
                                <th>Status</th>
                                <th class="fhp-num" style="width:190px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var u = row.User;
                                var isLocked = u.LockoutEnd is not null && u.LockoutEnd > DateTimeOffset.UtcNow;
                                <tr>
                                    <td class="fhp-table__title">@u.Name</td>
                                    <td class="fhp-dcell-meta">@u.Email</td>
                                    <td>
                                        @if (row.Roles.Count == 0)
                                        {
                                            <span class="fhp-dmuted">—</span>
                                        }
                                        @foreach (var role in row.Roles)
                                        {
                                            <span class="fhp-pill @(role == "Admin" ? "fhp-pill--bad" : "fhp-pill--neutral")">@role</span>
                                        }
                                    </td>
                                    <td class="fhp-dcell-meta">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <span class="fhp-pill @(isLocked ? "fhp-pill--warn" : "fhp-pill--ok")">
                                            @(isLocked ? "Locked" : "Active")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fhp-drow">
                                            <form asp-action="ToggleRole" asp-route-id="@u.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm">
                                                    <i class="ri-shield-user-line" aria-hidden="true"></i>
                                                    <span>@(row.Roles.Contains("Admin") ? "Demote" : "Promote")</span>
                                                </button>
                                            </form>
                                            <form asp-action="ToggleLockout" asp-route-id="@u.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                    <i class="ri-lock-2-line" aria-hidden="true"></i>
                                                    <span>@(isLocked ? "Unlock" : "Lock")</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="pager" />

</div>

