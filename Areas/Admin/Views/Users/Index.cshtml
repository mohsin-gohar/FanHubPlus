@model List<AdminUserRowViewModel>
@{
    ViewData["Title"] = "Users";
    var search = (string?)ViewBag.Search;
    var pageNum = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
}

<h1 class="page-title h3 mb-3">👥 Users (@totalItems)</h1>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width:360px;">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search e-mail or name..." />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>E-mail</th>
                    <th>Roles</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var u = row.User;
                    <tr>
                        <td class="fw-semibold">@u.Name</td>
                        <td class="small">@u.Email</td>
                        <td>
                            @foreach (var role in row.Roles)
                            {
                                <span class="badge rounded-pill @(role == "Admin" ? "bg-danger" : "bg-secondary")">@role</span>
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (u.LockoutEnd is not null && u.LockoutEnd > DateTimeOffset.UtcNow)
                            {
                                <span class="badge bg-warning text-dark">Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleRole" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(row.Roles.Contains("Admin") ? "Demote" : "Promote")
                                </button>
                            </form>
                            <form asp-action="ToggleLockout" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(u.LockoutEnd is not null && u.LockoutEnd > DateTimeOffset.UtcNow ? "Unlock" : "Lock")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @((pageNum <= 1) ? "disabled" : "")">
                <a class="page-link" href="?page=@(pageNum - 1)&search=@Uri.EscapeDataString(search ?? "")">«</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @pageNum of @totalPages</span></li>
            <li class="page-item @((pageNum >= totalPages) ? "disabled" : "")">
                <a class="page-link" href="?page=@(pageNum + 1)&search=@Uri.EscapeDataString(search ?? "")">»</a>
            </li>
        </ul>
    </nav>
}
