@model ContentFormViewModel
@{
    var isEdit = Model.ContentId != 0;
    ViewData["Title"] = isEdit ? "Edit content" : "New content";

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Catalogue",
        Title = isEdit ? "Edit content" : "New content",
        Accent = isEdit ? Model.Title : null,
        Lede = isEdit
            ? "Changes go live on the streaming grid, Explorer and search the moment you save."
            : "A new title needs a cover, a category and a type - everything else can follow.",
        BackText = "Back to contents",
        BackUrl = Url.Action("Index"),
        Chips = isEdit
            ? new List<AdminHeroChip>
            {
                new("ri-fire-line", Model.PopularityScore.ToString("N0"), "popularity"),
                new("ri-film-line", Model.Type.ToString(), "type"),
            }
            : new List<AdminHeroChip>
            {
                new("ri-image-add-line", Model.Categories.Count.ToString("N0"), "categories available"),
            }
    };
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-file-edit-line" aria-hidden="true"></i>
                Details
            </h2>
            <span class="fhp-panel__hint">@(isEdit ? $"Editing #{Model.ContentId}" : "New record")</span>
        </header>
        <div class="fhp-panel__body">
            <form class="fhp-dform" action="@(isEdit ? Url.Action("Edit", new { id = Model.ContentId }) : Url.Action("Create"))"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="ContentId" />
                    <input type="hidden" asp-for="ThumbnailUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ContentType>()"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Genre" class="form-label"></label>
                        <input asp-for="Genre" class="form-control" placeholder="Action, Shonen..." />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReleaseDate" class="form-label"></label>
                        <input asp-for="ReleaseDate" class="form-control" type="date" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PopularityScore" class="form-label"></label>
                        <input asp-for="PopularityScore" class="form-control" type="number" min="0" max="10000" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Tags" class="form-label"></label>
                        <input asp-for="Tags" class="form-control" placeholder="ninja, space, romance" />
                        <div class="form-text">Comma separated — existing tags are reused, removed ones deleted.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Director" class="form-label"></label>
                        <input asp-for="Director" class="form-control" placeholder="Rian Johnson" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RuntimeMinutes" class="form-label"></label>
                        <input asp-for="RuntimeMinutes" class="form-control" type="number" min="1" max="1200" placeholder="145" />
                        <div class="form-text">Shown as 2h : 25M on the detail page.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AgeRating" class="form-label"></label>
                        <input asp-for="AgeRating" class="form-control" placeholder="PG-13" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductionCountry" class="form-label"></label>
                        <input asp-for="ProductionCountry" class="form-control" placeholder="United States" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Cast" class="form-label"></label>
                        <input asp-for="Cast" class="form-control" placeholder="Ana Cruz:Lila, Ben Osei:Marcus" />
                        <div class="form-text">Comma separated — each entry is Name:Role; the role defaults to Actor.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ThumbnailFile" class="form-label"></label>
                        <input asp-for="ThumbnailFile" class="form-control" accept="image/*" />
                        <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <div class="fhp-dform__preview">
                                <img src="@Model.ThumbnailUrl" alt="current cover" />
                                <span>Leave empty to keep the current cover.</span>
                            </div>
                        }
                    </div>
                </div>

                <hr />
                <div class="fhp-dform__actions">
                    <button type="submit" class="fhp-dbtn fhp-dbtn--gold">
                        <i class="ri-save-3-line" aria-hidden="true"></i>
                        <span>Save content</span>
                    </button>
                    <a asp-action="Index" class="fhp-dbtn fhp-dbtn--ghost">
                        <i class="ri-close-line" aria-hidden="true"></i>
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
