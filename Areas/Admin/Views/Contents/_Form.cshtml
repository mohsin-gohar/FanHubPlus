@model ContentFormViewModel
@{
    var isEdit = Model.ContentId != 0;
    ViewData["Title"] = isEdit ? "Edit content" : "New content";
}

<h1 class="page-title h3 mb-3">@(isEdit ? "✏️ Edit content" : "＋ New content")</h1>

<div class="card border-0 shadow-sm" style="max-width:820px;">
    <div class="card-body p-4">
        <form action="@(isEdit ? Url.Action("Edit", new { id = Model.ContentId }) : Url.Action("Create"))"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input type="hidden" asp-for="ContentId" />
                <input type="hidden" asp-for="ThumbnailUrl" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="new SelectList(Model.Categories, nameof(Category.CategoryId), nameof(Category.Name))">
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ContentType>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Genre" class="form-label"></label>
                    <input asp-for="Genre" class="form-control" placeholder="Action, Shonen..." />
                </div>
                <div class="col-md-4">
                    <label asp-for="ReleaseDate" class="form-label"></label>
                    <input asp-for="ReleaseDate" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-4">
                    <label asp-for="PopularityScore" class="form-label"></label>
                    <input asp-for="PopularityScore" class="form-control" type="number" min="0" max="10000" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Tags" class="form-label"></label>
                    <input asp-for="Tags" class="form-control" placeholder="ninja, space, romance" />
                    <div class="form-text">Comma separated — existing tags are reused, removed ones deleted.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ThumbnailFile" class="form-label"></label>
                    <input asp-for="ThumbnailFile" class="form-control" accept="image/*" />
                    <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ThumbnailUrl" alt="current cover"
                                 style="height:70px;border-radius:6px;" />
                            <div class="form-text">Leave empty to keep the current cover.</div>
                        </div>
                    }
                </div>
            </div>

            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save content</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
