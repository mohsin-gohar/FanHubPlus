@model AdminListViewModel<FanSubmission>
@{
    ViewData["Title"] = "Submissions";
    var statusFilter = (SubmissionStatus?)ViewBag.StatusFilter;
    var pendingCount = (int)ViewBag.PendingCount;

    // Paging keeps the status tab in the query string.
    var pager = AdminPagerViewModel.Build(Model.Page, Model.TotalPages,
        p => $"?status={statusFilter}&page={p}");

    var hero = new AdminHeroViewModel
    {
        Eyebrow = "FanHub Plus · Moderation",
        Title = "Fan submissions",
        Accent = Model.TotalItems.ToString("N0"),
        Lede = "Artwork sent in by visitors. Approving a piece publishes it to the Fan Art " +
               "wall; rejecting it leaves the fan nothing but a note.",
        Chips =
        {
            new AdminHeroChip("ri-hourglass-line", pendingCount.ToString("N0"), "waiting on you", true),
            new AdminHeroChip("ri-layout-grid-line", Model.Items.Count.ToString("N0"), "on this page"),
        }
    };
    if (statusFilter is not null)
    {
        hero.Chips.Add(new AdminHeroChip("ri-filter-2-line", statusFilter.ToString()!, "filter"));
    }
}

<div class="fhp-cine">

    <partial name="_CineHero" model="hero" />

    <section class="fhp-panel">
        <header class="fhp-panel__head">
            <h2 class="fhp-panel__title">
                <i class="ri-image-2-line" aria-hidden="true"></i>
                Submissions
            </h2>
            <span class="fhp-panel__hint">@Model.Items.Count of @Model.TotalItems</span>
        </header>
        <div class="fhp-panel__body">
            <nav class="fhp-dtabs fhp-dtoolbar" aria-label="Filter by status">
                <a class="@(statusFilter is null ? "is-active" : "")" asp-action="Index">All</a>
                @foreach (var s in Enum.GetValues<SubmissionStatus>())
                {
                    <a class="@(statusFilter == s ? "is-active" : "")" asp-action="Index" asp-route-status="@s">@s</a>
                }
            </nav>

            @if (Model.Items.Count == 0)
            {
                <div class="fhp-cine-empty">
                    <i class="ri-image-2-line" aria-hidden="true"></i>
                    <span>No submissions in this view.</span>
                </div>
            }
            else
            {
                <div class="fhp-dcards">
                    @foreach (var s in Model.Items)
                    {
                        var statusPill = s.Status == SubmissionStatus.Pending ? "fhp-pill--warn"
                                       : s.Status == SubmissionStatus.Approved ? "fhp-pill--ok" : "fhp-pill--bad";
                        <article class="fhp-dcard">
                            @if (!string.IsNullOrEmpty(s.ImageUrl))
                            {
                                <img class="fhp-dcard__img" src="@s.ImageUrl" alt="@s.Title" loading="lazy" />
                            }
                            <div class="fhp-dcard__body">
                                <div class="fhp-dcard__head">
                                    <h3 class="fhp-dcard__title">@s.Title</h3>
                                    <span class="fhp-pill @statusPill">@s.Status</span>
                                </div>
                                <div class="fhp-dcard__meta">
                                    <i class="ri-user-3-line" aria-hidden="true"></i>
                                    <span>@(s.User?.Name ?? "Unknown")</span>
                                    <i class="ri-calendar-line" aria-hidden="true"></i>
                                    <span>@s.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>
                                <p class="fhp-dcell-meta">
                                    @(s.Body.Length > 220 ? s.Body[..220] + "…" : s.Body)
                                </p>
                                <div class="fhp-dcard__actions">
                                    @if (s.Status != SubmissionStatus.Approved)
                                    {
                                        <form asp-action="SetStatus" asp-route-id="@s.SubmissionId"
                                              asp-route-status="@SubmissionStatus.Approved" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="fhp-dbtn fhp-dbtn--gold fhp-dbtn--sm">
                                                <i class="ri-check-line" aria-hidden="true"></i>
                                                <span>Approve</span>
                                            </button>
                                        </form>
                                    }
                                    @if (s.Status != SubmissionStatus.Rejected)
                                    {
                                        <form asp-action="SetStatus" asp-route-id="@s.SubmissionId"
                                              asp-route-status="@SubmissionStatus.Rejected" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="fhp-dbtn fhp-dbtn--danger fhp-dbtn--sm">
                                                <i class="ri-close-line" aria-hidden="true"></i>
                                                <span>Reject</span>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@s.SubmissionId" method="post"
                                          class="ms-auto" onsubmit="return confirm('Delete permanently?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="fhp-dbtn fhp-dbtn--ghost fhp-dbtn--sm fhp-dbtn--icon"
                                                title="Delete permanently" aria-label="Delete permanently">
                                            <i class="ri-delete-bin-6-line" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <partial name="_Pager" model="pager" />

</div>

