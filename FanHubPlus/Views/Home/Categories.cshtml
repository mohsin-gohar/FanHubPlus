@model FanHubPlus.ViewModels.BrowseViewModel
@{
    ViewData["Title"] = "Categories";
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "Browse by genre", Title = "All Categories", Subtitle = "Every genre in the FanHub library, from award season documentaries to cult anime. Pick one to see the full list.", Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), ("Categories", null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<section class="fh-wrap pb-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Home" asp-action="Movies" asp-route-genre="@category.Name" class="fh-panel fh-hover-panel fh-reveal group">
                <div class="flex items-start justify-between gap-4">
                    <span class="w-14 h-14 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl group-hover:bg-[#f41b3b] group-hover:border-transparent transition-colors">
                        @category.Icon
                    </span>
                    <i class="ri-arrow-right-up-line text-gray-600 group-hover:text-[#f41b3b] transition-colors"></i>
                </div>
                <h2 class="fh-h3 mt-5">@category.Name</h2>
                <p class="text-sm text-gray-400 mt-2">
                    @category.VideoCount title(s) available to stream in HD and 4K.
                </p>
                <span class="inline-flex items-center gap-2 text-xs font-bold text-white mt-5 group-hover:text-[#f41b3b] transition-colors">
                    Explore @category.Name <i class="ri-arrow-right-line"></i>
                </span>
            </a>
        }
    </div>

    <div class="fh-panel fh-wash mt-14 text-center py-12 px-6">
        <h2 class="fh-h2">Looking for something specific?</h2>
        <p class="fh-lead mt-3 max-w-xl mx-auto">Search across the whole catalogue by title, cast or keyword.</p>
        <form method="get" asp-controller="Home" asp-action="Movies" class="fh-newsletter max-w-lg mx-auto mt-7">
            <input type="search" name="search" class="fh-input" placeholder="Try &quot;thriller&quot; or a title..." aria-label="Search the library" />
            <button type="submit" class="fh-btn fh-btn-primary">Search</button>
        </form>
    </div>
</section>
