@model FanHubPlus.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact Us";
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "Support", Title = "We're here to help", Subtitle = "Billing, playback or account questions? Send us a note and our team replies within 24 hours, seven days a week.", Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), ("Contact Us", null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<section class="fh-wrap pb-20">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-8 items-start">

        <!-- ============ INFO ============ -->
        <aside class="space-y-6">
            <div class="fh-panel">
                <h2 class="fh-widget-title">Contact details</h2>
                <ul class="space-y-4 text-sm text-gray-400">
                    <li class="flex items-start gap-3"><i class="ri-map-pin-line text-[#f41b3b] text-lg"></i> FanHub Plus HQ, 4K Avenue, Mumbai 400001</li>
                    <li class="flex items-start gap-3"><i class="ri-mail-line text-[#f41b3b] text-lg"></i> support@fanhubplus.demo</li>
                    <li class="flex items-start gap-3"><i class="ri-phone-line text-[#f41b3b] text-lg"></i> +91 00000 00000 (9am - 9pm IST)</li>
                    <li class="flex items-start gap-3"><i class="ri-time-line text-[#f41b3b] text-lg"></i> Mon - Sat, 9am to 9pm</li>
                </ul>
            </div>

            <div class="fh-panel">
                <h2 class="fh-widget-title">Quick links</h2>
                <div class="fh-linklist">
                    <a asp-controller="Home" asp-action="Pricing">Manage subscription <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Faq">Read the FAQs <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Devices">Supported devices <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Account" asp-action="ForgotPassword">Reset your password <i class="ri-arrow-right-s-line"></i></a>
                </div>
            </div>

            <div class="fh-panel fh-wash">
                <h2 class="fh-h3">Support channels</h2>
                <div class="space-y-4 mt-4">
                    @foreach (var channel in new[]
                    {
                        new { Icon = "ri-chat-1-line", Title = "Live chat", Detail = "Average reply under 4 minutes" },
                        new { Icon = "ri-ticket-2-line", Title = "Help centre", Detail = "Guides and troubleshooting" },
                        new { Icon = "ri-feedback-line", Title = "Feature requests", Detail = "Tell us what to build next" }
                    })
                    {
                        <div class="flex items-start gap-3">
                            <span class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#f41b3b] flex-none">
                                <i class="@channel.Icon"></i>
                            </span>
                            <div>
                                <div class="text-sm font-bold text-white">@channel.Title</div>
                                <div class="text-xs text-gray-500 mt-0.5">@channel.Detail</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </aside>

        <!-- ============ FORM + MAP ============ -->
        <div class="space-y-6">
            <div class="fh-panel">
                <h2 class="fh-h2" style="font-size:1.4rem">Send us a message</h2>

                <form method="post" asp-controller="Home" asp-action="Contact" class="mt-7 grid sm:grid-cols-2 gap-5" novalidate>
                    <div>
                        <label asp-for="Name" class="fh-label"></label>
                        <input asp-for="Name" class="fh-input" placeholder="Your full name" />
                        <span asp-validation-for="Name" class="fh-input-msg"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="fh-label"></label>
                        <input asp-for="Email" class="fh-input" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="fh-input-msg"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="Subject" class="fh-label"></label>
                        <select asp-for="Subject" class="fh-input">
                            <option>Billing or subscription</option>
                            <option selected>Playback problem</option>
                            <option>Account help</option>
                            <option>Partnership enquiry</option>
                            <option>Press or media</option>
                            <option>Something else</option>
                        </select>
                        <span asp-validation-for="Subject" class="fh-input-msg"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="Message" class="fh-label"></label>
                        <textarea asp-for="Message" rows="6" class="fh-input" placeholder="Tell us a little more..."></textarea>
                        <span asp-validation-for="Message" class="fh-input-msg"></span>
                    </div>
                    <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
                        <button type="submit" class="fh-btn fh-btn-primary fh-btn-lg"><i class="ri-send-plane-line"></i> Send message</button>
                        <p class="text-[11px] text-gray-500">We never share your details with third parties.</p>
                    </div>
                </form>
            </div>

            <div class="fh-panel">
                <h2 class="fh-h3">Find the studio</h2>
                <div class="fh-still mt-4" data-theme="t5">
                    <i class="ri-map-pin-2-line fh-art-glyph"></i>
                    <div class="absolute inset-0 z-[3] flex flex-col items-center justify-center text-center px-6">
                        <i class="ri-map-pin-line text-3xl text-[#f41b3b]"></i>
                        <p class="text-sm font-bold text-white mt-2">FanHub Plus HQ</p>
                        <p class="text-[11px] text-gray-300 mt-1">4K Avenue, Mumbai 400001 &bull; Mon - Sat, 9am to 9pm</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

