@model FanHubPlus.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "FanHub Plus - Unlimited Movies, Shows & Live Sport";
    var hero = Model.FeaturedHero;
}

<!-- ============ BANNER ============ -->
<section class="fh-hero" data-fh-banner>
    <div class="swiper">
        <div class="swiper-wrapper">
            @foreach (var item in hero)
            {
                <div class="swiper-slide fh-hero-slide" data-theme="@item.PosterTheme">
                    <div class="fh-wrap fh-hero-content py-24">
                        <div class="max-w-2xl">
                            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-widest bg-white/10 border border-white/15 text-white backdrop-blur-md">
                                <span class="fh-dot-live bg-[#f41b3b]"></span>
                                FanHub Original &bull; @item.Genre
                            </div>

                            <h1 class="fh-h1 mt-5">@item.Title</h1>
                            <p class="text-white/70 text-sm sm:text-base italic mt-2">@item.Tagline</p>

                            <div class="flex flex-wrap items-center gap-4 mt-6">
                                <span class="fh-score">@item.ImdbRating.ToString("0.0")</span>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="fh-chip">@item.YearDisplay</span>
                                    <span class="fh-chip">@item.Duration</span>
                                    <span class="fh-chip">@item.Quality</span>
                                    <span class="fh-chip">@item.AgeRating</span>
                                </div>
                            </div>

                            <p class="text-gray-300 text-sm sm:text-base leading-relaxed mt-6 max-w-xl">@item.Description</p>

                            <div class="flex flex-wrap items-center gap-3 mt-8">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="fh-btn fh-btn-primary fh-btn-lg">
                                    <i class="ri-play-fill"></i> Watch Now
                                </a>
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="fh-btn fh-btn-ghost fh-btn-lg">
                                    <i class="ri-information-line"></i> More Info
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="swiper-pagination" data-fh-banner-dots></div>
        <div class="swiper-button-prev !hidden md:flex" data-fh-banner-prev></div>
        <div class="swiper-button-next !hidden md:flex" data-fh-banner-next></div>
    </div>

    <!-- Thumbnail rail -->
    <div class="fh-wrap fh-hero-thumbs pb-6" data-fh-banner-thumbs>
        <div class="swiper">
            <div class="swiper-wrapper">
                @foreach (var item in hero)
                {
                    <div class="swiper-slide" data-theme="@item.PosterTheme">
                        <div class="fh-hero-thumb"><span>@item.Title</span></div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ CATEGORY TILES ============ -->
<section class="fh-wrap fh-section">
    <div class="fh-head">
        <div>
            <span class="fh-eyebrow">Browse</span>
            <h2 class="fh-h2 mt-2">Popular Categories</h2>
        </div>
        <a asp-controller="Home" asp-action="Categories" class="fh-btn fh-btn-ghost fh-btn-sm">All categories <i class="ri-arrow-right-line"></i></a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3.5">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Home" asp-action="Movies" asp-route-genre="@category.Name" class="fh-tile">
                <span class="fh-tile-icon">@category.Icon</span>
                <span class="fh-tile-name">@category.Name</span>
                <span class="fh-tile-count">@category.VideoCount titles</span>
            </a>
        }
    </div>
</section>

<!-- ============ TRENDING ============ -->
<section id="trending" class="fh-wrap fh-section pt-0">
    <div class="fh-rail" data-fh-rail="poster">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">Stream today</span>
                <h2 class="fh-h2 mt-2">Trending Now</h2>
            </div>
            <div class="fh-rail-nav">
                <button type="button" class="fh-icon-btn" data-fh-prev aria-label="Previous"><i class="ri-arrow-left-s-line"></i></button>
                <button type="button" class="fh-icon-btn" data-fh-next aria-label="Next"><i class="ri-arrow-right-s-line"></i></button>
            </div>
        </div>

        <div class="swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model.TrendingVideos)
                {
                    <div class="swiper-slide"><partial name="_VideoCard" model="item" /></div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ LIVE NOW ============ -->
<section id="live" class="fh-wrap fh-section pt-0">
    <div class="fh-rail" data-fh-rail="poster">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">Live &amp; events</span>
                <h2 class="fh-h2 mt-2">Streaming Live Now</h2>
            </div>
            <a asp-controller="Home" asp-action="Videos" class="fh-btn fh-btn-ghost fh-btn-sm">All live <i class="ri-arrow-right-line"></i></a>
        </div>

        <div class="swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model.LiveNow)
                {
                    <div class="swiper-slide">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="fh-card group">
                            <div class="fh-still" data-theme="@item.PosterTheme">
                                <i class="ri-broadcast-line fh-art-glyph"></i>
                                <div class="fh-art-meta">
                                    <span class="fh-chip fh-chip-live"><span class="fh-dot-live"></span> LIVE</span>
                                    <span class="fh-chip">@item.WatchingDisplay</span>
                                </div>
                                <span class="fh-play-orb"><i class="ri-play-fill"></i></span>
                                <div class="absolute inset-x-0 bottom-0 z-[3] p-3.5">
                                    <span class="block text-sm font-bold text-white">@item.Title</span>
                                    <span class="block text-[11px] text-gray-300 mt-0.5">@item.Genre &bull; @item.YearDisplay</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


<!-- ============ TOP RATED ============ -->
<section id="top-rated" class="fh-wrap fh-section pt-0">
    <div class="fh-rail" data-fh-rail="poster">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">Critics &amp; viewers</span>
                <h2 class="fh-h2 mt-2">Top Rated Titles</h2>
            </div>
            <div class="fh-rail-nav">
                <button type="button" class="fh-icon-btn" data-fh-prev aria-label="Previous"><i class="ri-arrow-left-s-line"></i></button>
                <button type="button" class="fh-icon-btn" data-fh-next aria-label="Next"><i class="ri-arrow-right-s-line"></i></button>
            </div>
        </div>

        <div class="swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model.TopRated)
                {
                    <div class="swiper-slide"><partial name="_VideoCard" model="item" /></div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ LATEST RELEASES ============ -->
<section id="latest" class="fh-wrap fh-section pt-0">
    <div class="fh-rail" data-fh-rail="poster">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">Just added</span>
                <h2 class="fh-h2 mt-2">Latest Releases</h2>
            </div>
            <a asp-controller="Home" asp-action="Movies" asp-route-sortBy="year" class="fh-btn fh-btn-ghost fh-btn-sm">See all <i class="ri-arrow-right-line"></i></a>
        </div>

        <div class="swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model.LatestReleases)
                {
                    <div class="swiper-slide"><partial name="_VideoCard" model="item" /></div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ LIVE CHANNELS ============ -->
<section class="fh-wrap fh-section pt-0">
    <div class="fh-head">
        <div>
            <span class="fh-eyebrow">On air right now</span>
            <h2 class="fh-h2 mt-2">Live Channels</h2>
        </div>
        <a asp-controller="Home" asp-action="Channels" class="fh-btn fh-btn-ghost fh-btn-sm">Channel list <i class="ri-arrow-right-line"></i></a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var channel in Model.Channels)
        {
            <a asp-controller="Home" asp-action="Channels" class="fh-panel fh-hover-panel flex items-center gap-4">
                <span class="fh-still !aspect-square !w-14 !h-14 flex-none" data-theme="@channel.LogoTheme">
                    <i class="ri-tv-2-line text-2xl !text-white/70 absolute inset-0 m-auto z-[3]"></i>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2">
                        <span class="fh-chip fh-chip-live !px-1.5"><span class="fh-dot-live"></span></span>
                        <span class="text-sm font-bold text-white truncate">@channel.Name</span>
                    </span>
                    <span class="block text-[11px] text-gray-500 mt-1 truncate">Ch @channel.Number &bull; @channel.Language &bull; @channel.ViewerDisplay watching</span>
                    <span class="block text-xs text-gray-400 mt-1 truncate">Now: @channel.NowPlaying</span>
                </span>
            </a>
        }
    </div>
</section>


<!-- ============ PRICING PREVIEW ============ -->
<section class="fh-wrap fh-section pt-0">
    <div class="fh-head fh-head-center">
        <div>
            <span class="fh-eyebrow fh-eyebrow-center">Subscribe</span>
            <h2 class="fh-h2 mt-2">Simple, transparent pricing</h2>
            <p class="fh-lead mt-3 max-w-xl mx-auto">Cancel anytime. Stream on TV, phone, tablet or laptop with no commercials.</p>
        </div>
    </div>

    <div class="flex justify-center mb-9" data-fh-billing>
        <div class="fh-billing-toggle">
            <button type="button" data-fh-period="monthly" class="is-active">Monthly</button>
            <button type="button" data-fh-period="yearly">Yearly &bull; save 33%</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="fh-plan">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Standard</span>
                <h3 class="fh-h3 mt-1.5">Standard HD</h3>
                <div class="mt-5 flex items-baseline gap-1.5">
                    <span class="fh-price" data-fh-price data-fh-monthly="$8.99" data-fh-yearly="$5.99">$8.99</span>
                    <span class="fh-price-note" data-fh-price-note data-fh-monthly="/ month" data-fh-yearly="/ month, billed yearly">/ month</span>
                </div>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> Full HD 1080p quality</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> One screen at a time</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Unlimited movies &amp; shows</li>
                    <li class="fh-feat is-off"><i class="ri-close-line"></i> 4K UHD and HDR</li>
                    <li class="fh-feat is-off"><i class="ri-close-line"></i> Live sports channels</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Pricing" class="fh-btn fh-btn-outline fh-btn-block mt-8">Choose Standard</a>
        </div>

        <div class="fh-plan is-featured">
            <span class="fh-plan-flag">Most popular</span>
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-[#f41b3b]">FanHub Pro</span>
                <h3 class="fh-h3 mt-1.5">Premium 4K UHD</h3>
                <div class="mt-5 flex items-baseline gap-1.5">
                    <span class="fh-price" data-fh-price data-fh-monthly="$14.99" data-fh-yearly="$9.99">$14.99</span>
                    <span class="fh-price-note" data-fh-price-note data-fh-monthly="/ month" data-fh-yearly="/ month, billed yearly">/ month</span>
                </div>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> 4K UHD, HDR10 and Dolby Vision</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Dolby Atmos spatial audio</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Four screens at once</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Live sport and events</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Offline downloads</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Pricing" class="fh-btn fh-btn-primary fh-btn-block mt-8">Start 7-day free trial</a>
        </div>

        <div class="fh-plan">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-[#ffea00]">Best value</span>
                <h3 class="fh-h3 mt-1.5">Annual VIP</h3>
                <div class="mt-5 flex items-baseline gap-1.5">
                    <span class="fh-price">$119.99</span>
                    <span class="fh-price-note">/ year</span>
                </div>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> Everything in Premium 4K</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Unlimited devices</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Early access to premieres</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Priority VIP support</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Four free months</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Pricing" class="fh-btn fh-btn-outline fh-btn-block mt-8">Choose Annual</a>
        </div>
    </div>
</section>


<!-- ============ STORE DEALS ============ -->
@if (Model.StoreDeals.Count > 0)
{
    <section class="fh-wrap fh-section pt-0">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">FanHub store</span>
                <h2 class="fh-h2 mt-2">Member Deals</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="fh-btn fh-btn-ghost fh-btn-sm">Shop all <i class="ri-arrow-right-line"></i></a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var product in Model.StoreDeals)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}

<!-- ============ TESTIMONIALS ============ -->
<section class="fh-wrap fh-section pt-0">
    <div class="fh-head fh-head-center">
        <div>
            <span class="fh-eyebrow fh-eyebrow-center">Viewer reviews</span>
            <h2 class="fh-h2 mt-2">What people are saying</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var item in Model.Testimonials)
        {
            <article class="fh-panel fh-reveal h-full flex flex-col justify-between">
                <div>
                    <div class="text-[#ffea00] text-sm tracking-widest">
                        <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                    </div>
                    <p class="text-sm text-gray-300 leading-relaxed mt-4">&ldquo;@item.Quote&rdquo;</p>
                </div>
                <div class="fh-divider flex items-center gap-3 mt-6 pt-5">
                    <span class="fh-avatar">@(item.Name.Length > 0 ? item.Name[..1] : "?")</span>
                    <div>
                        <div class="text-sm font-bold text-white">@item.Name</div>
                        <div class="text-[11px] text-gray-500">@item.Role &bull; @item.ReviewCount.ToString("N0") reviews</div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- ============ BLOG ============ -->
<section id="blog" class="fh-wrap fh-section pt-0">
    <div class="fh-head">
        <div>
            <span class="fh-eyebrow">Editorial</span>
            <h2 class="fh-h2 mt-2">From the FanHub blog</h2>
        </div>
        <a asp-controller="Home" asp-action="Blog" class="fh-btn fh-btn-ghost fh-btn-sm">All articles <i class="ri-arrow-right-line"></i></a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        @foreach (var post in Model.BlogPosts)
        {
            <partial name="_BlogCard" model="post" />
        }
    </div>
</section>

<!-- ============ FAQ ============ -->
@if (Model.Faqs.Count > 0)
{
    <section class="fh-wrap fh-section pt-0">
        <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 items-start">
            <div>
                <span class="fh-eyebrow">Questions</span>
                <h2 class="fh-h2 mt-2">Frequently asked</h2>
                <p class="fh-lead mt-4">Everything viewers ask before their first month. Still stuck? Our support team replies within 24 hours.</p>
                <a asp-controller="Home" asp-action="Faq" class="fh-btn fh-btn-primary mt-7">See all FAQs <i class="ri-arrow-right-line"></i></a>
            </div>

            <div data-fh-single>
                @foreach (var faq in Model.Faqs)
                {
                    <div class="fh-acc">
                        <button type="button" class="fh-acc-q" aria-expanded="false">
                            <span>@faq.Question</span>
                            <i class="ri-arrow-down-s-line"></i>
                        </button>
                        <div class="fh-acc-a">@faq.Answer</div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ============ APP CTA ============ -->
<section class="fh-wrap fh-section pt-0">
    <div class="fh-panel fh-wash text-center py-14 px-6">
        <span class="fh-eyebrow fh-eyebrow-center">Everywhere you watch</span>
        <h2 class="fh-h2 mt-3">Take FanHub Plus with you</h2>
        <p class="fh-lead mt-3 max-w-xl mx-auto">Ten devices, four screens at once and thirty days of downloads. The app is free with every plan.</p>

        <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
            <a href="#" class="fh-btn fh-btn-primary fh-btn-lg"><i class="ri-play-circle-line"></i> Get the Android app</a>
            <a href="#" class="fh-btn fh-btn-ghost fh-btn-lg"><i class="ri-apple-line"></i> Download for iOS</a>
            <a asp-controller="Home" asp-action="Devices" class="fh-btn fh-btn-outline fh-btn-lg">All devices</a>
        </div>

        <div class="fh-logo-strip mt-12 pt-10 border-t border-white/5">
            <span class="fh-logo">DOLBY VISION</span>
            <span class="fh-logo">ATMOS</span>
            <span class="fh-logo">4K HDR</span>
            <span class="fh-logo">ANDROID TV</span>
            <span class="fh-logo">APPLE TV</span>
            <span class="fh-logo">ROKU</span>
        </div>
    </div>
</section>

