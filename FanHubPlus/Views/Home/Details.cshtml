@model FanHubPlus.ViewModels.DetailsViewModel
@{
    var title = Model.Title;
    ViewData["Title"] = title.Title;
}

<!-- ============ HERO ============ -->
<section class="fh-wash" data-theme="@title.PosterTheme">
    <div class="fh-wrap fh-pagehead">
        <nav class="fh-crumb mb-7" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a><i class="ri-arrow-right-s-line"></i>
            <a asp-controller="Home" asp-action="Movies" asp-route-genre="@title.Genre">@title.Genre</a><i class="ri-arrow-right-s-line"></i>
            <span class="fh-crumb-current">@title.Title</span>
        </nav>

        <div class="grid lg:grid-cols-[300px_1fr] gap-9 lg:gap-12 items-start">
            <div class="fh-poster !rounded-2xl" data-theme="@title.PosterTheme">
                <i class="fh-art-glyph fh-art-glyph-lg"></i>
                <div class="absolute inset-0 z-[3] flex items-center justify-center">
                    <span class="w-16 h-16 rounded-full bg-[#f41b3b]/90 flex items-center justify-center text-white text-3xl shadow-2xl">
                        <i class="ri-play-fill"></i>
                    </span>
                </div>
                <div class="absolute inset-x-0 bottom-0 z-[3] p-4">
                    <span class="fh-chip">@title.Quality</span>
                </div>
            </div>

            <div>
                <div class="flex flex-wrap items-center gap-2">
                    @if (title.IsLive)
                    {
                        <span class="fh-chip fh-chip-live"><span class="fh-dot-live"></span> LIVE NOW</span>
                    }
                    else if (title.IsSeries)
                    {
                        <span class="fh-chip fh-chip-primary">Series</span>
                    }
                    else
                    {
                        <span class="fh-chip fh-chip-primary">@title.Genre</span>
                    }
                    <span class="fh-chip">@title.YearDisplay</span>
                    <span class="fh-chip">@title.Duration</span>
                    <span class="fh-chip">@title.AgeRating</span>
                </div>

                <h1 class="fh-h1 mt-4">@title.Title</h1>
                <p class="text-white/60 italic text-sm mt-2">@title.Tagline</p>

                <div class="flex flex-wrap items-center gap-6 mt-6">
                    <div class="flex items-center gap-3">
                        <span class="fh-score">@title.ImdbRating.ToString("0.0")</span>
                        <div class="text-xs text-gray-400 leading-tight">
                            <div class="text-white font-bold">@title.RatingDisplay</div>
                            <div>@title.WatchingDisplay</div>
                        </div>
                    </div>
                    <div class="text-xs text-gray-400 leading-tight">
                        <div><span class="text-gray-500">Director</span> &middot; @title.Director</div>
                        <div class="mt-1"><span class="text-gray-500">Released</span> &middot; @title.ReleaseDate.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                <p class="fh-lead mt-6 max-w-3xl">@title.Description</p>

                <div class="flex flex-wrap items-center gap-3 mt-8">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@title.Id" class="fh-btn fh-btn-primary fh-btn-lg">
                        <i class="ri-play-fill"></i> @(title.IsLive ? "Join Live" : "Watch Now")
                    </a>
                    <button type="button" class="fh-btn fh-btn-ghost fh-btn-lg"><i class="ri-add-line"></i> My List</button>
                    <button type="button" class="fh-btn fh-btn-outline fh-btn-lg"><i class="ri-share-forward-line"></i> Share</button>
                    <a asp-controller="Home" asp-action="Pricing" class="fh-btn fh-btn-outline fh-btn-lg"><i class="ri-crown-line"></i> Subscribe</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ TABS: OVERVIEW / EPISODES / COMMENTS ============ -->
<section class="fh-wrap pb-20">
    <div class="fh-tabs" data-fh-tabs role="tablist">
        <button type="button" class="fh-tab is-active" data-fh-tab="pane-overview" role="tab">Overview</button>
        @if (Model.HasEpisodes)
        {
            <button type="button" class="fh-tab" data-fh-tab="pane-episodes" role="tab">Episodes (@Model.Episodes.Count)</button>
        }
        <button type="button" class="fh-tab" data-fh-tab="pane-comments" role="tab">Comments (@Model.Comments.Count)</button>
        <button type="button" class="fh-tab" data-fh-tab="pane-share" role="tab">Share</button>
    </div>

    <!-- OVERVIEW -->
    <div id="pane-overview" class="fh-tabpane is-active pt-8">
        <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-10 items-start">
            <div>
                <h2 class="fh-h3">Storyline</h2>
                <p class="fh-lead mt-4">@title.Description @title.Description This is a demonstration catalogue entry for the FanHub Plus streaming front-end, so the synopsis stands in for a full editorial summary.</p>

                <h3 class="fh-h3 mt-10">Cast &amp; crew</h3>
                <div class="grid sm:grid-cols-2 gap-3 mt-5">
                    @foreach (var member in Model.CastList)
                    {
                        <div class="fh-panel flex items-center gap-3 !py-3">
                            <span class="fh-avatar fh-avatar-sm">@member[..1]</span>
                            <div>
                                <div class="text-sm font-bold text-white">@member</div>
                                <div class="text-[11px] text-gray-500">Cast</div>
                            </div>
                        </div>
                    }
                    <div class="fh-panel flex items-center gap-3 !py-3">
                        <span class="fh-avatar fh-avatar-sm">@title.Director[..1]</span>
                        <div>
                            <div class="text-sm font-bold text-white">@title.Director</div>
                            <div class="text-[11px] text-gray-500">Director</div>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="fh-panel">
                    <h2 class="fh-widget-title">Title information</h2>
                    <dl class="space-y-3.5 text-sm">
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Genre</dt><dd class="text-white font-bold">@title.Genre</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Release</dt><dd class="text-white font-bold">@title.ReleaseDate.ToString("dd MMM yyyy")</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Runtime</dt><dd class="text-white font-bold">@title.Duration</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Quality</dt><dd class="text-white font-bold">@title.Quality</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Certificate</dt><dd class="text-white font-bold">@title.AgeRating</dd></div>
                        @if (title.IsSeries)
                        {
                            <div class="flex justify-between gap-4"><dt class="text-gray-500">Seasons</dt><dd class="text-white font-bold">@title.TotalSeasons</dd></div>
                            <div class="flex justify-between gap-4"><dt class="text-gray-500">Episodes</dt><dd class="text-white font-bold">@title.TotalEpisodes</dd></div>
                        }
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Subtitles</dt><dd class="text-white font-bold text-right">@title.Subtitles</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-gray-500">Audio</dt><dd class="text-white font-bold text-right">@title.AudioTracks</dd></div>
                    </dl>
                </div>

                <div class="fh-panel">
                    <h2 class="fh-widget-title">Viewer score</h2>
                    <div class="flex items-center gap-4">
                        <span class="fh-score">@Model.AverageScore</span>
                        <div class="flex-1 space-y-2">
                            @foreach (var bar in new[] { 82, 61, 24, 8, 3 })
                            {
                                <div class="fh-rating-bar">
                                    <span>@(11 - Array.IndexOf(new[] { 82, 61, 24, 8, 3 }, bar))</span>
                                    <span class="fh-progress"><i style="width:@bar%"></i></span>
                                </div>
                            }
                        </div>
                    </div>
                    <p class="text-[11px] text-gray-500 mt-4">@Model.WatchlistCount people have this on their list.</p>
                </div>

                <div class="fh-panel">
                    <h2 class="fh-widget-title">Content note</h2>
                    <p class="text-sm text-gray-400 leading-relaxed">@title.MaturityNote Parents can set an age filter from the profile menu to hide titles above their chosen certificate.</p>
                </div>
            </aside>
        </div>
    </div>


    <!-- EPISODES -->
    @if (Model.HasEpisodes)
    {
        var seasons = Model.Episodes.GroupBy(e => e.Season).OrderBy(g => g.Key);
        <div id="pane-episodes" class="fh-tabpane pt-8">
            <div class="flex flex-wrap items-center gap-3 mb-7">
                <h2 class="fh-h3">Episodes</h2>
                @foreach (var season in seasons)
                {
                    <span class="fh-chip">Season @season.Key &bull; @season.Count() episodes</span>
                }
            </div>

            <div class="space-y-4">
                @foreach (var episode in Model.Episodes)
                {
                    <article class="fh-panel grid sm:grid-cols-[200px_1fr] gap-5 items-center">
                        <div class="fh-still" data-theme="@episode.StillTheme">
                            <i class="ri-play-circle-line fh-art-glyph-sm"></i>
                            <span class="absolute inset-0 z-[3] flex items-center justify-center text-3xl text-white/85">
                                <i class="ri-play-circle-fill"></i>
                            </span>
                            <span class="fh-chip absolute top-2.5 left-2.5 z-[4]">@episode.Code</span>
                            @if (episode.IsFree)
                            {
                                <span class="fh-chip fh-chip-free absolute top-2.5 right-2.5 z-[4]">Free</span>
                            }
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="fh-h3">@episode.Title</h3>
                                <span class="fh-chip">@episode.Duration</span>
                                <span class="fh-chip fh-chip-rating"><i class="ri-star-fill"></i> @episode.ImdbRating.ToString("0.0")</span>
                            </div>
                            <p class="text-sm text-gray-400 leading-relaxed mt-2.5">@episode.Description</p>
                            <p class="text-[11px] text-gray-500 mt-3">Aired @episode.AiredDisplay</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    }

    <!-- COMMENTS -->
    <div id="pane-comments" class="fh-tabpane pt-8">
        <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-10 items-start">
            <div>
                <h2 class="fh-h3">Viewer comments</h2>

                @if (Model.Comments.Count == 0)
                {
                    <div class="fh-empty mt-6">
                        <i class="ri-chat-1-line"></i>
                        <p class="fh-lead mt-3">No comments yet. Be the first to share what you think.</p>
                    </div>
                }
                else
                {
                    <div class="mt-4">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="fh-comment">
                                <span class="fh-avatar">@comment.Initials</span>
                                <div class="flex-1">
                                    <div class="flex flex-wrap items-center gap-3">
                                        <span class="text-sm font-bold text-white">@comment.Author</span>
                                        <span class="text-[11px] text-gray-500">@comment.PostedDisplay</span>
                                    </div>
                                    <p class="text-sm text-gray-300 leading-relaxed mt-2">@comment.Body</p>
                                    <div class="flex items-center gap-4 mt-3 text-[11px] text-gray-500">
                                        <button type="button" class="hover:text-[#f41b3b] transition-colors"><i class="ri-thumb-up-line"></i> @comment.Likes</button>
                                        <button type="button" class="hover:text-[#f41b3b] transition-colors">Reply</button>
                                        <button type="button" class="hover:text-[#f41b3b] transition-colors">Share</button>
                                    </div>

                                    @foreach (var reply in Model.Replies.Where(r => r.ParentId == comment.Id))
                                    {
                                        <div class="fh-comment fh-comment-nested">
                                            <span class="fh-avatar fh-avatar-sm">@reply.Initials</span>
                                            <div>
                                                <div class="flex items-center gap-3">
                                                    <span class="text-xs font-bold text-white">@reply.Author</span>
                                                    <span class="text-[11px] text-gray-500">@reply.PostedDisplay</span>
                                                </div>
                                                <p class="text-xs text-gray-400 leading-relaxed mt-1.5">@reply.Body</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }


                <div class="fh-panel mt-8">
                    <h3 class="fh-h3">Add a comment</h3>
                    <form method="post" class="mt-5 grid sm:grid-cols-2 gap-4" onsubmit="event.preventDefault(); this.reset(); this.querySelector('.comment-ok').hidden = false;">
                        <div>
                            <label class="fh-label" for="commentName">Name</label>
                            <input type="text" id="commentName" class="fh-input" placeholder="Your name" required />
                        </div>
                        <div>
                            <label class="fh-label" for="commentEmail">Email</label>
                            <input type="email" id="commentEmail" class="fh-input" placeholder="you@example.com" required />
                        </div>
                        <div class="sm:col-span-2">
                            <label class="fh-label" for="commentBody">Comment</label>
                            <textarea id="commentBody" rows="4" class="fh-input" placeholder="What did you think?" required></textarea>
                        </div>
                        <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
                            <button type="submit" class="fh-btn fh-btn-primary"><i class="ri-send-plane-line"></i> Post comment</button>
                            <span class="comment-ok text-xs text-emerald-400" hidden>Thanks - your comment has been queued for review.</span>
                        </div>
                    </form>
                </div>
            </div>

            <aside>
                <div class="fh-widget">
                    <h2 class="fh-widget-title">More like this</h2>
                    <div class="fh-linklist">
                        @foreach (var item in Model.Related.Take(6))
                        {
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id">
                                <span class="truncate">@item.Title</span>
                                <i class="ri-arrow-right-s-line"></i>
                            </a>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <!-- SHARE -->
    <div id="pane-share" class="fh-tabpane pt-8">
        <div class="grid lg:grid-cols-2 gap-8">
            <div class="fh-panel">
                <h2 class="fh-h3">Share this title</h2>
                <p class="fh-lead mt-3">Send @title.Title to a friend, or copy the link for your own post.</p>
                <input type="text" class="fh-input mt-6" readonly value="https://fanhubplus.example/Home/Details/@title.Id" aria-label="Share link" />
                <div class="flex flex-wrap gap-3 mt-6">
                    <button type="button" class="fh-btn fh-btn-ghost fh-btn-sm"><i class="ri-facebook-fill"></i> Facebook</button>
                    <button type="button" class="fh-btn fh-btn-ghost fh-btn-sm"><i class="ri-twitter-x-fill"></i> X</button>
                    <button type="button" class="fh-btn fh-btn-ghost fh-btn-sm"><i class="ri-whatsapp-line"></i> WhatsApp</button>
                    <button type="button" class="fh-btn fh-btn-ghost fh-btn-sm"><i class="ri-link"></i> Copy link</button>
                </div>
            </div>

            <div class="fh-panel">
                <h2 class="fh-h3">Watch on</h2>
                <div class="grid grid-cols-2 gap-3 mt-5">
                    <a href="#" class="fh-store-badge"><i class="ri-google-play-fill text-[#f41b3b]"></i><span class="text-xs font-bold text-white">Google Play</span></a>
                    <a href="#" class="fh-store-badge"><i class="ri-apple-fill text-white"></i><span class="text-xs font-bold text-white">App Store</span></a>
                    <a href="#" class="fh-store-badge"><i class="ri-tv-line text-white"></i><span class="text-xs font-bold text-white">Apple TV</span></a>
                    <a href="#" class="fh-store-badge"><i class="ri-chrome-line text-white"></i><span class="text-xs font-bold text-white">Web player</span></a>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============ RELATED RAIL ============ -->
@if (Model.Related.Count > 0)
{
    <section class="fh-wrap fh-section">
        <div class="fh-rail" data-fh-rail="poster">
            <div class="fh-head">
                <div>
                    <span class="fh-eyebrow">You might also like</span>
                    <h2 class="fh-h2 mt-2">Related titles</h2>
                </div>
                <div class="fh-rail-nav">
                    <button type="button" class="fh-icon-btn" data-fh-prev aria-label="Previous"><i class="ri-arrow-left-s-line"></i></button>
                    <button type="button" class="fh-icon-btn" data-fh-next aria-label="Next"><i class="ri-arrow-right-s-line"></i></button>
                </div>
            </div>
            <div class="swiper">
                <div class="swiper-wrapper">
                    @foreach (var item in Model.Related)
                    {
                        <div class="swiper-slide"><partial name="_VideoCard" model="item" /></div>
                    }
                </div>
            </div>
        </div>
    </section>
}

