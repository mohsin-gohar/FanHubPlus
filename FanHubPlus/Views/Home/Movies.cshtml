@model FanHubPlus.ViewModels.BrowseViewModel
@{
    ViewData["Title"] = Model.Section;
    var action = Model.Section switch
    {
        "TV Shows" => "TvShows",
        "Videos" => "Videos",
        _ => "Movies"
    };
    var heading = Model.Section switch
    {
        "TV Shows" => "TV Shows & Series",
        "Videos" => "Live Videos & Events",
        _ => "Movies"
    };
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "FanHub library", Title = string.IsNullOrWhiteSpace(Model.Genre) || Model.Genre == "All" ? heading : Model.Genre + " movies", Subtitle = $"Filter, sort and search {Model.TotalCount} title(s) in the FanHub library. Every plan includes the full catalogue in HD and 4K.", Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), (heading, null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<section class="fh-wrap pb-20">
    <div class="grid lg:grid-cols-[280px_1fr] gap-8">

        <!-- ============ SIDEBAR FILTERS ============ -->
        <aside class="space-y-6">
            <div class="fh-panel">
                <h2 class="fh-widget-title">Filter</h2>

                <form method="get" asp-controller="Home" asp-action="@action" class="space-y-4">
                    <div>
                        <label class="fh-label" for="search">Keyword</label>
                        <div class="fh-input-group">
                            <i class="ri-search-line"></i>
                            <input type="search" id="search" name="search" value="@Model.Search" class="fh-input" placeholder="Title, actor, keyword" />
                        </div>
                    </div>

                    <div>
                        <label class="fh-label" for="genre">Genre</label>
                        <select id="genre" name="genre" class="fh-input">
                            <option value="All">All genres</option>
                            @foreach (var genre in Model.Genres)
                            {
                                <option value="@genre" selected="@(string.Equals(Model.Genre, genre, StringComparison.OrdinalIgnoreCase))">@genre</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="fh-label" for="sortBy">Sort by</label>
                        <select id="sortBy" name="sortBy" class="fh-input">
                            <option value="latest" selected="@(Model.SortBy == null || Model.SortBy == "latest")">Latest releases</option>
                            <option value="rating" selected="@(Model.SortBy == "rating")">Top rated</option>
                            <option value="year" selected="@(Model.SortBy == "year")">Newest year</option>
                            <option value="title" selected="@(Model.SortBy == "title")">Title A-Z</option>
                            <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest first</option>
                        </select>
                    </div>

                    <button type="submit" class="fh-btn fh-btn-primary fh-btn-block"><i class="ri-filter-3-line"></i> Apply filters</button>
                    <a asp-controller="Home" asp-action="@action" class="fh-btn fh-btn-outline fh-btn-block">Reset</a>
                </form>
            </div>

            <div class="fh-widget">
                <h2 class="fh-widget-title">Quick genre links</h2>
                <div class="fh-linklist">
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Action">Action &amp; Sci-Fi <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Drama">Drama &amp; Crime <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Horror">Horror &amp; Thriller <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Comedy">Comedy <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Romance">Romance <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Documentary">Documentaries <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Anime">Anime <i class="ri-arrow-right-s-line"></i></a>
                    <a asp-controller="Home" asp-action="Movies" asp-route-genre="Sports">Sports <i class="ri-arrow-right-s-line"></i></a>
                </div>
            </div>

            <div class="fh-panel text-center">
                <span class="fh-avatar fh-avatar-lg mx-auto"><i class="ri-crown-line"></i></span>
                <h3 class="fh-h3 mt-4">Unlock everything</h3>
                <p class="text-xs text-gray-400 mt-2">Get the full library in 4K HDR with zero commercials.</p>
                <a asp-controller="Home" asp-action="Pricing" class="fh-btn fh-btn-primary fh-btn-block mt-5">See plans</a>
            </div>
        </aside>

        <!-- ============ RESULTS ============ -->
        <div>
            <div class="flex flex-wrap items-center justify-between gap-3 pb-5 mb-6 border-b border-white/10">
                <p class="text-sm text-gray-400">
                    Showing <span class="text-white font-bold">@Model.Items.Count</span> of <span class="text-white font-bold">@Model.TotalCount</span> titles
                    @if (!string.IsNullOrWhiteSpace(Model.Genre) && Model.Genre != "All")
                    {
                        <span>in <span class="text-[#f41b3b]">@Model.Genre</span></span>
                    }
                </p>
                <div class="flex items-center gap-2">
                    <a asp-controller="Home" asp-action="@action" class="fh-icon-btn" aria-label="Grid view"><i class="ri-layout-grid-line"></i></a>
                    <a asp-controller="Home" asp-action="@action" asp-route-sortBy="rating" class="fh-icon-btn" aria-label="Top rated"><i class="ri-fire-line"></i></a>
                </div>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="fh-empty">
                    <i class="ri-search-2-line"></i>
                    <h2 class="fh-h3 mt-4">No titles matched your search</h2>
                    <p class="fh-lead mt-2">Try a different keyword, or clear the genre filter to see the whole library.</p>
                    <a asp-controller="Home" asp-action="@action" class="fh-btn fh-btn-primary mt-6">Clear filters</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-5">
                    @foreach (var item in Model.Items)
                    {
                        <partial name="_VideoCard" model="item" />
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="fh-pager" aria-label="Pagination">
                        @if (Model.Page > 1)
                        {
                            <a asp-controller="Home" asp-action="@action" asp-route-page="@(Model.Page - 1)"
                               asp-route-genre="@Model.Genre" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" aria-label="Previous page">
                                <i class="ri-arrow-left-s-line"></i>
                            </a>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.Page)
                            {
                                <span class="is-active">@i</span>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="@action" asp-route-page="@i"
                                   asp-route-genre="@Model.Genre" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">@i</a>
                            }
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-controller="Home" asp-action="@action" asp-route-page="@(Model.Page + 1)"
                               asp-route-genre="@Model.Genre" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy" aria-label="Next page">
                                <i class="ri-arrow-right-s-line"></i>
                            </a>
                        }
                    </nav>
                }
            }
        </div>
    </div>
</section>

