@{
    ViewData["Title"] = "Pricing";
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "Subscribe &amp; save", Title = "Pick the plan that fits you", Subtitle = "Every plan unlocks the full FanHub library in HD, no commercials, and cancel-anytime billing. Switch or upgrade whenever you like.", Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), ("Pricing", null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<!-- ============ PLANS ============ -->
<section class="fh-wrap pb-16">
    <div class="flex justify-center mb-10" data-fh-billing>
        <div class="fh-billing-toggle">
            <button type="button" data-fh-period="monthly" class="is-active">Pay monthly</button>
            <button type="button" data-fh-period="yearly">Pay yearly &bull; save 33%</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="fh-plan">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Standard</span>
                <h2 class="fh-h3 mt-1.5">Standard HD</h2>
                <div class="mt-6 flex items-baseline gap-1.5">
                    <span class="fh-price" data-fh-price data-fh-monthly="$8.99" data-fh-yearly="$5.99">$8.99</span>
                    <span class="fh-price-note" data-fh-price-note data-fh-monthly="/ month" data-fh-yearly="/ month, billed yearly">/ month</span>
                </div>
                <p class="text-xs text-gray-400 mt-3">For a single viewer on a phone, laptop or one television.</p>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> Full HD 1080p quality</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> One screen at a time</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Unlimited movies, shows and anime</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Two profiles</li>
                    <li class="fh-feat is-off"><i class="ri-close-line"></i> 4K UHD and HDR</li>
                    <li class="fh-feat is-off"><i class="ri-close-line"></i> Live sports channels</li>
                    <li class="fh-feat is-off"><i class="ri-close-line"></i> Offline downloads</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="fh-btn fh-btn-outline fh-btn-block mt-8">Choose Standard</a>
        </div>

        <div class="fh-plan is-featured">
            <span class="fh-plan-flag">Most popular</span>
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-[#f41b3b]">FanHub Pro</span>
                <h2 class="fh-h3 mt-1.5">Premium 4K UHD</h2>
                <div class="mt-6 flex items-baseline gap-1.5">
                    <span class="fh-price" data-fh-price data-fh-monthly="$14.99" data-fh-yearly="$9.99">$14.99</span>
                    <span class="fh-price-note" data-fh-price-note data-fh-monthly="/ month" data-fh-yearly="/ month, billed yearly">/ month</span>
                </div>
                <p class="text-xs text-gray-400 mt-3">The full cinematic experience for a whole household.</p>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> 4K UHD, HDR10 and Dolby Vision</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Dolby Atmos spatial audio</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Four screens at once</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Live sport, news and events</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Offline downloads for 30 days</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Six profiles including kids</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> 7-day free trial</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="fh-btn fh-btn-primary fh-btn-block mt-8">Start free trial</a>
        </div>

        <div class="fh-plan">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-[#ffea00]">Best value</span>
                <h2 class="fh-h3 mt-1.5">Annual VIP</h2>
                <div class="mt-6 flex items-baseline gap-1.5">
                    <span class="fh-price">$119.99</span>
                    <span class="fh-price-note">/ year</span>
                </div>
                <p class="text-xs text-gray-400 mt-3">Everything in Premium, paid once, with four months free.</p>
                <ul class="mt-7">
                    <li class="fh-feat"><i class="ri-check-line"></i> Everything in Premium 4K UHD</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Unlimited devices</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Early access to premieres</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Priority VIP support</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Festival and concert passes</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> Annual gift card option</li>
                    <li class="fh-feat"><i class="ri-check-line"></i> 10% off the FanHub store</li>
                </ul>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="fh-btn fh-btn-outline fh-btn-block mt-8">Choose Annual</a>
        </div>
    </div>
</section>

<!-- ============ COMPARISON ============ -->
<section class="fh-wrap pb-16">
    <div class="fh-head">
        <div>
            <span class="fh-eyebrow">Side by side</span>
            <h2 class="fh-h2 mt-2">Compare plans</h2>
        </div>
    </div>

    <div class="fh-panel-flush fh-panel overflow-x-auto">
        <table class="fh-table">
            <thead>
                <tr>
                    <th>Feature</th>
                    <th>Standard HD</th>
                    <th>Premium 4K UHD</th>
                    <th>Annual VIP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in new[]
                {
                    new { Feature = "Video quality", A = "1080p", B = "4K HDR + Dolby Vision", C = "4K HDR + Dolby Vision" },
                    new { Feature = "Screens at once", A = "1", B = "4", C = "Unlimited" },
                    new { Feature = "Profiles", A = "2", B = "6", C = "6" },
                    new { Feature = "Live channels", A = "-", B = "Included", C = "Included" },
                    new { Feature = "Offline downloads", A = "-", B = "30 days", C = "30 days" },
                    new { Feature = "Free trial", A = "-", B = "7 days", C = "7 days" },
                    new { Feature = "Store discount", A = "-", B = "5%", C = "10%" },
                    new { Feature = "Support", A = "Email", B = "Priority chat", C = "VIP concierge" }
                })
                {
                    <tr>
                        <td class="font-bold text-white">@row.Feature</td>
                        <td>@row.A</td>
                        <td class="text-white">@row.B</td>
                        <td class="text-white">@row.C</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- ============ FAQ ============ -->
<section class="fh-wrap pb-24">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
        <div>
            <span class="fh-eyebrow">Questions</span>
            <h2 class="fh-h2 mt-2">Before you subscribe</h2>
            <p class="fh-lead mt-4">Billing, cancellation, devices and refunds - answered in plain language.</p>
            <a asp-controller="Home" asp-action="Faq" class="fh-btn fh-btn-primary mt-7">All FAQs <i class="ri-arrow-right-line"></i></a>
        </div>

        <div data-fh-single>
            @foreach (var faq in new[]
            {
                new { Q = "Can I cancel at any time?", A = "Yes. Open My Account, choose Plan and hit Cancel. You keep access until the end of the period you already paid for and there is no cancellation fee." },
                new { Q = "How many devices can watch at once?", A = "Standard HD supports one screen, Premium 4K UHD supports four screens and Annual VIP supports unlimited devices on one account." },
                new { Q = "Is there a free trial?", A = "Premium 4K UHD includes seven days free. We only ask for payment details when the trial ends, and you can cancel in two clicks before that." },
                new { Q = "Do you offer refunds?", A = "If something is not playing on your device, tell support within seven days and we will either fix it or refund the month, no questions." },
                new { Q = "Which payment methods work?", A = "All major cards, net banking, UPI and supported digital wallets. Invoices are available in My Account under Billing." },
                new { Q = "Can I share my account with family?", A = "Yes, through profiles. Every person on the plan gets their own profile, watch history and recommendations, and you can PIN-lock purchases." }
            })
            {
                <div class="fh-acc">
                    <button type="button" class="fh-acc-q" aria-expanded="false">
                        <span>@faq.Q</span>
                        <i class="ri-arrow-down-s-line"></i>
                    </button>
                    <div class="fh-acc-a">@faq.A</div>
                </div>
            }
        </div>
    </div>
</section>

