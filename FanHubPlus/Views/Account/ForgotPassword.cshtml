@model FanHubPlus.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="fh-wrap fh-section">
    <div class="max-w-lg mx-auto">
        <div class="fh-panel text-center">
            <span class="fh-avatar fh-avatar-lg mx-auto"><i class="ri-lock-unlock-line"></i></span>
            <h1 class="fh-h2 mt-6" style="font-size:1.6rem">Forgot your password?</h1>
            <p class="fh-lead mt-3">
                Enter the email address on your account and we will send a single use link. It expires after thirty minutes.
            </p>

            <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="mt-8 text-left" novalidate>
                <div asp-validation-summary="ModelOnly" class="fh-input-msg mb-4"></div>

                <div class="fh-field">
                    <label asp-for="Email" class="fh-label"></label>
                    <div class="fh-input-group">
                        <i class="ri-mail-line"></i>
                        <input asp-for="Email" class="fh-input" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="fh-input-msg"></span>
                </div>

                <button type="submit" class="fh-btn fh-btn-primary fh-btn-block fh-btn-lg">
                    <i class="ri-send-plane-line"></i> Send reset link
                </button>
            </form>

            <p class="text-sm text-gray-400 mt-7">
                Remembered it?
                <a asp-controller="Account" asp-action="SignIn" class="text-[#f41b3b] font-bold hover:underline">Back to sign in</a>
            </p>
        </div>

        <div class="fh-panel mt-6">
            <h2 class="fh-h3">Trouble with the email?</h2>
            <ul class="mt-4 space-y-2.5">
                @foreach (var tip in new[]
                {
                    "Check the spam or promotions folder - reset emails are filtered aggressively.",
                    "Make sure you used the address you signed up with, not a nickname.",
                    "If you signed up with Google or Apple, use the same button on the sign-in page.",
                    "Still stuck? Our support team can reset it for you within a day."
                })
                {
                    <li class="fh-feat text-sm"><i class="ri-arrow-right-s-line text-[#f41b3b]"></i> @tip</li>
                }
            </ul>
            <a asp-controller="Home" asp-action="Contact" class="fh-btn fh-btn-outline fh-btn-block mt-6">Ask support</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
