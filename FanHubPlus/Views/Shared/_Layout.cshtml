@inject FanHubPlus.Services.CartService Cart
@{
    var action = ViewContext.RouteData.Values["action"] as string ?? "Index";
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "Home";
    var genre = ViewContext.RouteData.Values["genre"] as string ?? string.Empty;
    var flash = TempData["SuccessMessage"] as string;
    int cartCount = Cart.Count;

    bool IsActive(string ctrl, string act, string? g = null) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, act, StringComparison.OrdinalIgnoreCase)
        && (g is null || string.Equals(genre, g, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FanHub Plus</title>
    <meta name="description" content="FanHub Plus - unlimited movies, TV shows, anime, documentaries and live sport in 4K HDR." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montez&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Play:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/remixicon.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fanhub-theme.css" asp-append-version="true" />
</head>
<body class="antialiased selection:bg-[#f41b3b] selection:text-white">

    <!-- ================= TOP BAR ================= -->
    <div class="hidden md:block bg-[#07080a] border-b border-white/5 text-[12px]">
        <div class="fh-wrap flex items-center justify-between h-9">
            <p class="text-gray-500 flex items-center gap-2">
                <i class="ri-broadcast-line text-[#f41b3b]"></i>
                Live now: <a asp-controller="Home" asp-action="Videos" class="text-gray-300 hover:text-[#f41b3b] transition-colors">FanHub Cricket &bull; T20 Series</a>
            </p>
            <nav class="flex items-center gap-5 text-gray-500">
                <a asp-controller="Home" asp-action="Devices" class="hover:text-white transition-colors">Devices</a>
                <a asp-controller="Home" asp-action="Careers" class="hover:text-white transition-colors">Careers</a>
                <a asp-controller="Home" asp-action="Faq" class="hover:text-white transition-colors">Help</a>
                <a asp-controller="Account" asp-action="SignIn" class="hover:text-white transition-colors">Sign In</a>
            </nav>
        </div>
    </div>

    <!-- ================= HEADER ================= -->
    <header id="navbar" class="navbar-glass sticky top-0 z-50 w-full">
        <div class="fh-wrap">
            <div class="relative flex items-center justify-between gap-4">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex-none py-3.5 inline-block" aria-label="FanHub Plus - Home">
                    <span class="flex items-center gap-2.5">
                        <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#f41b3b] to-[#ffea00] flex items-center justify-center text-white text-xl shadow-lg shadow-red-600/25">
                            <i class="ri-play-fill"></i>
                        </span>
                        <span class="text-xl font-black tracking-tight text-white font-['Montserrat']">
                            FAN<span class="text-[#f41b3b]">HUB</span><span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-[#f41b3b]/20 text-[#f41b3b] font-bold align-middle">PLUS</span>
                        </span>
                    </span>
                </a>

                <!-- Desktop navigation -->
                <nav class="hidden xl:block flex-1">
                    <ul class="navbar-nav flex items-center gap-[28px]">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link dropdown-toggle @(IsActive("Home","Index") ? "active" : "")">Home</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link">Home</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Showcase" class="nav-link">Home - Showcase</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Index" asp-fragment="trending" class="nav-link">Trending Now</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Videos" class="nav-link">Live TV &amp; Sports</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-sortBy="rating" class="nav-link">Top Rated</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Movies" class="nav-link dropdown-toggle @(IsActive("Home","Movies") || IsActive("Home","TvShows") || IsActive("Home","Videos") || IsActive("Home","Categories") || IsActive("Home","Channels") ? "active" : "")">Browse</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" class="nav-link">Movies</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="TvShows" class="nav-link">TV Shows</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Videos" class="nav-link">Live Videos</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Channels" class="nav-link">Channels</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Categories" class="nav-link">Categories</a></li>
                            </ul>
                        </li>


                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Movies" class="nav-link dropdown-toggle @(IsActive("Home","Movies", genre) && !string.IsNullOrEmpty(genre) ? "active" : "")">Genres</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Action" class="nav-link">Action &amp; Sci-Fi</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Drama" class="nav-link">Drama &amp; Crime</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Horror" class="nav-link">Horror &amp; Thriller</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Romance" class="nav-link">Romance</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Comedy" class="nav-link">Comedy</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Documentary" class="nav-link">Documentaries</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Anime" class="nav-link">Anime</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Sports" class="nav-link">Sports</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="About" class="nav-link dropdown-toggle @(IsActive("Home","About") || IsActive("Home","Services") || IsActive("Home","Devices") || IsActive("Home","Careers") || IsActive("Home","Blog") || IsActive("Home","Testimonials") || IsActive("Home","Pricing") || IsActive("Home","Faq") ? "active" : "")">Pages</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a asp-controller="Home" asp-action="About" class="nav-link">About Us</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Services" class="nav-link">Services</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Devices" class="nav-link">Supported Devices</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Careers" class="nav-link">Careers</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Blog" class="nav-link">Blog</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Testimonials" class="nav-link">Testimonials</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Pricing" class="nav-link">Pricing</a></li>
                                <li class="nav-item"><a asp-controller="Home" asp-action="Faq" class="nav-link">FAQ</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Shop" asp-action="Index" class="nav-link dropdown-toggle @(IsActive("Shop","Index") || IsActive("Shop","Product") || IsActive("Shop","Cart") ? "active" : "")">Store</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item"><a asp-controller="Shop" asp-action="Index" class="nav-link">All Products</a></li>
                                <li class="nav-item"><a asp-controller="Shop" asp-action="Index" asp-route-category="Merch" class="nav-link">Merch</a></li>
                                <li class="nav-item"><a asp-controller="Shop" asp-action="Index" asp-route-category="Audio" class="nav-link">Audio</a></li>
                                <li class="nav-item"><a asp-controller="Shop" asp-action="Index" asp-route-category="Devices" class="nav-link">Devices</a></li>
                                <li class="nav-item"><a asp-controller="Shop" asp-action="Index" asp-route-category="Bundles" class="nav-link">Bundles</a></li>
                            </ul>
                        </li>

                        <li class="nav-item"><a asp-controller="Home" asp-action="Contact" class="nav-link @(IsActive("Home","Contact") ? "active" : "")">Contact</a></li>
                    </ul>
                </nav>


                <!-- Actions -->
                <div class="flex items-center gap-2.5 ml-auto">
                    <button type="button" id="searchBtn" class="fh-icon-btn" aria-label="Search" aria-expanded="false">
                        <i class="ri-search-line"></i>
                    </button>
                    <a asp-controller="Shop" asp-action="Cart" class="fh-icon-btn relative" aria-label="Cart">
                        <i class="ri-shopping-bag-3-line"></i>
                        @if (cartCount > 0)
                        {
                            <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-[#f41b3b] text-white text-[10px] font-black flex items-center justify-center">@cartCount</span>
                        }
                    </a>
                    <a asp-controller="Account" asp-action="Account" class="hidden lg:inline-flex fh-btn fh-btn-ghost fh-btn-sm">
                        <i class="ri-user-3-line"></i> My Account
                    </a>
                    <a asp-controller="Home" asp-action="Pricing" class="hidden md:inline-flex fh-btn fh-btn-primary fh-btn-sm">
                        <i class="ri-crown-line"></i> Subscribe
                    </a>
                    <button type="button" id="navbarBurgerToggle" class="navbar-burger-toggle xl:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="navbarSidebar">
                        <span class="h-[3px] w-[28px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[28px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[28px] my-[5px] block bg-white"></span>
                    </button>
                </div>
            </div>

            <!-- Search drawer -->
            <div id="searchBox" class="pb-4">
                <form method="get" asp-controller="Home" asp-action="Movies" class="fh-input-group">
                    <i class="ri-search-line"></i>
                    <input type="search" name="search" class="fh-input" placeholder="Search movies, shows, actors..." aria-label="Search the library" />
                    <button type="submit" class="fh-btn fh-btn-primary fh-btn-sm fh-input-btn" aria-label="Submit search">Search</button>
                </form>
            </div>
        </div>
    </header>

    <div id="navbarBackdrop" class="navbar-backdrop"></div>


    <!-- ================= MOBILE SIDEBAR ================= -->
    <aside id="navbarSidebar" class="sidebar-modal" aria-label="Mobile navigation">
        <div class="flex items-center justify-between px-6 py-5 border-b border-white/5">
            <span class="text-lg font-black text-white font-['Montserrat']">FAN<span class="text-[#f41b3b]">HUB</span><span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-[#f41b3b]/20 text-[#f41b3b] font-bold">PLUS</span></span>
            <button type="button" id="navbarSidebarClose" class="fh-icon-btn" aria-label="Close menu"><i class="ri-close-line"></i></button>
        </div>

        <div class="flex-1 overflow-y-auto px-6 py-6">
            <form method="get" asp-controller="Home" asp-action="Movies" class="fh-input-group mb-6">
                <i class="ri-search-line"></i>
                <input type="search" name="search" class="fh-input" placeholder="Search titles..." aria-label="Search" />
            </form>

            <ul class="sidebar-navbar-nav space-y-1">
                <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home","Index") ? "active" : "")">Home</a></li>
                <li class="nav-item"><a asp-controller="Home" asp-action="Showcase" class="nav-link @(IsActive("Home","Showcase") ? "active" : "")">Home - Showcase</a></li>
                <li class="nav-item"><a href="#" class="nav-link dropdown-toggle">Browse</a>
                    <ul class="dropdown-menu hidden">
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" class="nav-link">Movies</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="TvShows" class="nav-link">TV Shows</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Videos" class="nav-link">Live Videos</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Channels" class="nav-link">Channels</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Categories" class="nav-link">Categories</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a href="#" class="nav-link dropdown-toggle">Genres</a>
                    <ul class="dropdown-menu hidden">
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Action" class="nav-link">Action &amp; Sci-Fi</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Drama" class="nav-link">Drama &amp; Crime</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Horror" class="nav-link">Horror &amp; Thriller</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Romance" class="nav-link">Romance</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Documentary" class="nav-link">Documentaries</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Movies" asp-route-genre="Anime" class="nav-link">Anime</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a href="#" class="nav-link dropdown-toggle">Pages</a>
                    <ul class="dropdown-menu hidden">
                        <li class="nav-item"><a asp-controller="Home" asp-action="About" class="nav-link">About Us</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Services" class="nav-link">Services</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Devices" class="nav-link">Supported Devices</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Careers" class="nav-link">Careers</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Blog" class="nav-link">Blog</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Pricing" class="nav-link">Pricing</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Faq" class="nav-link">FAQ</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a href="#" class="nav-link dropdown-toggle">Store</a>
                    <ul class="dropdown-menu hidden">
                        <li class="nav-item"><a asp-controller="Shop" asp-action="Index" class="nav-link">All Products</a></li>
                        <li class="nav-item"><a asp-controller="Shop" asp-action="Cart" class="nav-link">Cart</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a asp-controller="Home" asp-action="Contact" class="nav-link @(IsActive("Home","Contact") ? "active" : "")">Contact</a></li>
                <li class="nav-item"><a asp-controller="Account" asp-action="Account" class="nav-link @(IsActive("Account","Account") ? "active" : "")">My Account</a></li>
            </ul>

            <div class="mt-8 grid grid-cols-2 gap-3">
                <a asp-controller="Account" asp-action="SignIn" class="fh-btn fh-btn-outline fh-btn-sm">Sign In</a>
                <a asp-controller="Account" asp-action="SignUp" class="fh-btn fh-btn-primary fh-btn-sm">Register</a>
            </div>
        </div>
    </aside>

    <main role="main">
        <partial name="_FlashMessage" />
        @RenderBody()
    </main>


    <!-- ================= FOOTER ================= -->
    <footer class="bg-[#07080a] border-t border-white/5 mt-24">
        <div class="fh-wrap pt-14 pb-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
                <div class="lg:col-span-2 space-y-5">
                    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2.5">
                        <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#f41b3b] to-[#ffea00] flex items-center justify-center text-white text-lg">
                            <i class="ri-play-fill"></i>
                        </span>
                        <span class="text-xl font-black text-white font-['Montserrat']">FAN<span class="text-[#f41b3b]">HUB</span><span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-[#f41b3b]/20 text-[#f41b3b] font-bold">PLUS</span></span>
                    </a>
                    <p class="text-gray-400 text-sm leading-relaxed max-w-sm">
                        Unlimited blockbusters, FanHub originals, anime, documentaries and 4K HDR live sport - commercial free on every plan.
                    </p>

                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-widest text-white mb-3">Get release alerts</h3>
                        <form method="post" asp-controller="Home" asp-action="Newsletter" class="fh-newsletter max-w-sm">
                            <input type="email" name="email" class="fh-input" placeholder="you@example.com" aria-label="Email for release alerts" required />
                            <button type="submit" class="fh-btn fh-btn-primary fh-btn-sm">Join</button>
                        </form>
                    </div>

                    <div class="flex items-center gap-2.5">
                        <a href="#" class="fh-icon-btn" aria-label="Facebook"><i class="ri-facebook-fill"></i></a>
                        <a href="#" class="fh-icon-btn" aria-label="X"><i class="ri-twitter-x-fill"></i></a>
                        <a href="#" class="fh-icon-btn" aria-label="Instagram"><i class="ri-instagram-line"></i></a>
                        <a href="#" class="fh-icon-btn" aria-label="YouTube"><i class="ri-youtube-fill"></i></a>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-bold text-white mb-4">Browse</h3>
                    <ul class="space-y-2.5 text-sm text-gray-400">
                        <li><a asp-controller="Home" asp-action="Movies" class="hover:text-[#f41b3b] transition-colors">Movies</a></li>
                        <li><a asp-controller="Home" asp-action="TvShows" class="hover:text-[#f41b3b] transition-colors">TV Shows</a></li>
                        <li><a asp-controller="Home" asp-action="Videos" class="hover:text-[#f41b3b] transition-colors">Live Videos</a></li>
                        <li><a asp-controller="Home" asp-action="Channels" class="hover:text-[#f41b3b] transition-colors">Channels</a></li>
                        <li><a asp-controller="Home" asp-action="Categories" class="hover:text-[#f41b3b] transition-colors">Categories</a></li>
                        <li><a asp-controller="Home" asp-action="Pricing" class="hover:text-[#f41b3b] transition-colors">Pricing Plans</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-sm font-bold text-white mb-4">Company</h3>
                    <ul class="space-y-2.5 text-sm text-gray-400">
                        <li><a asp-controller="Home" asp-action="About" class="hover:text-[#f41b3b] transition-colors">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Services" class="hover:text-[#f41b3b] transition-colors">Services</a></li>
                        <li><a asp-controller="Home" asp-action="Devices" class="hover:text-[#f41b3b] transition-colors">Supported Devices</a></li>
                        <li><a asp-controller="Home" asp-action="Careers" class="hover:text-[#f41b3b] transition-colors">Careers</a></li>
                        <li><a asp-controller="Home" asp-action="Blog" class="hover:text-[#f41b3b] transition-colors">Blog</a></li>
                        <li><a asp-controller="Home" asp-action="Testimonials" class="hover:text-[#f41b3b] transition-colors">Testimonials</a></li>
                    </ul>
                </div>


                <div>
                    <h3 class="text-sm font-bold text-white mb-4">Support</h3>
                    <ul class="space-y-2.5 text-sm text-gray-400">
                        <li><a asp-controller="Home" asp-action="Contact" class="hover:text-[#f41b3b] transition-colors">Contact Us</a></li>
                        <li><a asp-controller="Home" asp-action="Faq" class="hover:text-[#f41b3b] transition-colors">FAQ</a></li>
                        <li><a asp-controller="Account" asp-action="Account" class="hover:text-[#f41b3b] transition-colors">My Account</a></li>
                        <li><a asp-controller="Account" asp-action="SignIn" class="hover:text-[#f41b3b] transition-colors">Sign In</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-[#f41b3b] transition-colors">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" class="hover:text-[#f41b3b] transition-colors">Terms of Service</a></li>
                    </ul>
                </div>
            </div>

            <!-- Store badges -->
            <div class="mt-12 pt-8 border-t border-white/5 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3">Download the app</h3>
                    <div class="flex flex-wrap gap-3">
                        <a href="#" class="fh-store-badge">
                            <i class="ri-google-play-fill text-[#f41b3b]"></i>
                            <span class="leading-tight">
                                <span class="block text-[10px] uppercase text-gray-500">Get it on</span>
                                <span class="block text-xs font-bold text-white">Google Play</span>
                            </span>
                        </a>
                        <a href="#" class="fh-store-badge">
                            <i class="ri-apple-fill text-white"></i>
                            <span class="leading-tight">
                                <span class="block text-[10px] uppercase text-gray-500">Download on</span>
                                <span class="block text-xs font-bold text-white">App Store</span>
                            </span>
                        </a>
                        <a href="#" class="fh-store-badge">
                            <i class="ri-tv-line text-white"></i>
                            <span class="leading-tight">
                                <span class="block text-[10px] uppercase text-gray-500">Available on</span>
                                <span class="block text-xs font-bold text-white">Apple TV</span>
                            </span>
                        </a>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 text-gray-600">
                    <span class="text-[11px] uppercase tracking-widest mr-1">We accept</span>
                    <span class="fh-chip"><i class="ri-visa-line"></i> Visa</span>
                    <span class="fh-chip"><i class="ri-mastercard-line"></i> Mastercard</span>
                    <span class="fh-chip">UPI</span>
                    <span class="fh-chip">Net Banking</span>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-500">
                <p>&copy; @DateTime.Now.Year FanHubPlus. An academic demonstration project. All rights reserved.</p>
                <div class="flex flex-wrap items-center gap-6">
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-gray-300 transition-colors">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Terms" class="hover:text-gray-300 transition-colors">Terms of Service</a>
                    <a asp-controller="Home" asp-action="Faq" class="hover:text-gray-300 transition-colors">Help Center</a>
                    <a asp-controller="Home" asp-action="Contact" class="hover:text-gray-300 transition-colors">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <button id="backToTopBtn" type="button" aria-label="Back to Top"><i class="ri-arrow-up-line"></i></button>

    <script src="~/js/swiper-bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

