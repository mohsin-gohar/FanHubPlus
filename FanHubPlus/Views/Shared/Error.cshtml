@model FanHubPlus.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="fh-wrap fh-section text-center">
    <p class="fh-error-code">@Model?.StatusCode</p>
    <h1 class="fh-h2 mt-6">@(Model?.StatusCode == 404 ? "We could not find that page" : "Something went wrong")</h1>
    <p class="fh-lead mt-4 max-w-lg mx-auto">
        @(Model?.StatusCode == 404
            ? "The page or title you were looking for has moved, expired, or never existed. Try the library or head back home."
            : "An unexpected error occurred while loading this page. Try again, and if it keeps happening let us know.")
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-9">
        <a asp-controller="Home" asp-action="Index" class="fh-btn fh-btn-primary fh-btn-lg"><i class="ri-home-4-line"></i> Back to home</a>
        <a asp-controller="Home" asp-action="Movies" class="fh-btn fh-btn-ghost fh-btn-lg"><i class="ri-film-line"></i> Browse library</a>
        <a asp-controller="Home" asp-action="Contact" class="fh-btn fh-btn-outline fh-btn-lg">Report a problem</a>
    </div>

    @if (Model?.ShowRequestId == true)
    {
        <p class="text-[11px] text-gray-600 mt-10">Request ID: <code>@Model.RequestId</code></p>
    }
</section>
