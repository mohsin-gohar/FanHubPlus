@model FanHubPlus.ViewModels.ProductDetailsViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "Store / " + product.Category, Title = product.Name, Subtitle = product.Description, Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), ("Store", "/Shop/Index"), (product.Name, null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<section class="fh-wrap pb-20">
    <div class="grid lg:grid-cols-[1fr_380px] gap-10 items-start">

        <!-- ============ GALLERY + INFO ============ -->
        <div>
            <div class="fh-still !aspect-[4/3]" data-theme="@product.ArtTheme">
                <i class="@product.ArtGlyph fh-art-glyph-lg"></i>
                <span class="absolute inset-0 z-[3] flex items-center justify-center">
                    <span class="w-14 h-14 rounded-full bg-black/40 backdrop-blur-md border border-white/20 flex items-center justify-center text-white text-2xl">
                        <i class="ri-zoom-in-line"></i>
                    </span>
                </span>
                @if (!string.IsNullOrWhiteSpace(product.Badge))
                {
                    <span class="fh-chip fh-chip-primary absolute top-4 left-4 z-[4]">@product.Badge</span>
                }
            </div>

            <div class="fh-tabs mt-6" data-fh-tabs>
                <button type="button" class="fh-tab is-active" data-fh-tab="p-desc" role="tab">Description</button>
                <button type="button" class="fh-tab" data-fh-tab="p-specs" role="tab">Specifications</button>
                <button type="button" class="fh-tab" data-fh-tab="p-shipping" role="tab">Shipping &amp; returns</button>
            </div>

            <div id="p-desc" class="fh-tabpane is-active pt-6">
                <div class="fh-article">
                    <p>@product.Description</p>
                    <p>
                        Every item in the FanHub store is produced in small runs and shipped from our own warehouse. Orders
                        placed before 4pm are dispatched the same working day, and members receive early access to limited
                        drops a full day before they go on general sale.
                    </p>
                    <blockquote>"Limited runs, no reprints. When a drop is gone, it is gone."</blockquote>
                </div>
            </div>

            <div id="p-specs" class="fh-tabpane pt-6">
                <table class="fh-table">
                    <tbody>
                        @foreach (var spec in new[]
                        {
                            new { Key = "SKU", Value = product.Sku },
                            new { Key = "Category", Value = product.Category },
                            new { Key = "Availability", Value = product.InStock ? "In stock" : "Sold out" },
                            new { Key = "Units sold", Value = product.Sold.ToString("N0") },
                            new { Key = "Customer rating", Value = product.Rating.ToString("0.0") + " / 5 (" + product.Reviews.ToString("N0") + " reviews)" },
                            new { Key = "Dispatch", Value = "Same working day if ordered before 4pm" }
                        })
                        {
                            <tr>
                                <td class="font-bold text-white w-1/3">@spec.Key</td>
                                <td>@spec.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="p-shipping" class="fh-tabpane pt-6">
                <div class="fh-article">
                    <ul>
                        <li>Free tracked delivery on orders over $500, otherwise a flat $49.</li>
                        <li>Dispatched from Mumbai within one working day.</li>
                        <li>Thirty day returns on physical goods, unopened.</li>
                        <li>Digital items such as gift cards are delivered by email immediately.</li>
                        <li>Gift wrapping is available at checkout for a flat $3.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ============ BUY BOX ============ -->
        <aside class="space-y-6 lg:sticky lg:top-28">
            <div class="fh-panel">
                <span class="text-xs uppercase tracking-widest text-gray-500">@product.Category</span>
                <h2 class="fh-h2 mt-2" style="font-size:1.5rem">@product.Name</h2>

                <div class="flex items-baseline gap-3 mt-5">
                    <span class="text-3xl font-black text-white">$@product.PriceDisplay</span>
                    @if (product.OldPrice.HasValue)
                    {
                        <span class="text-sm text-gray-500 line-through">$@product.OldPriceDisplay</span>
                        <span class="fh-chip fh-chip-primary">Save @product.DiscountPercent%</span>
                    }
                </div>

                <div class="flex items-center gap-2 mt-4 text-xs text-gray-400">
                    <span class="text-[#ffea00]"><i class="ri-star-fill"></i> @product.Rating.ToString("0.0")</span>
                    <span>&bull;</span>
                    <span>@product.Reviews.ToString("N0") reviews</span>
                    <span>&bull;</span>
                    <span>@product.Sold.ToString("N0") sold</span>
                </div>

                <form method="post" asp-controller="Shop" asp-action="AddToCart" class="mt-7">
                    <input type="hidden" name="id" value="@product.Id" />
                    <div class="flex items-center gap-4">
                        <div class="fh-stepper">
                            <button type="button" data-fh-step="-1" aria-label="Decrease quantity">-</button>
                            <input type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity" />
                            <button type="button" data-fh-step="1" aria-label="Increase quantity">+</button>
                        </div>
                        <span class="text-xs text-gray-500">In stock</span>
                    </div>
                    <button type="submit" class="fh-btn fh-btn-primary fh-btn-block mt-5" disabled="@(!product.InStock)">
                        <i class="ri-shopping-bag-3-line"></i> @(product.InStock ? "Add to bag" : "Sold out")
                    </button>
                </form>

                <div class="fh-divider mt-6 pt-5 space-y-3 text-xs text-gray-400">
                    <p class="flex items-center gap-2.5"><i class="ri-truck-line text-[#f41b3b]"></i> Free delivery over $500</p>
                    <p class="flex items-center gap-2.5"><i class="ri-refresh-line text-[#f41b3b]"></i> 30 day returns</p>
                    <p class="flex items-center gap-2.5"><i class="ri-shield-check-line text-[#f41b3b]"></i> Secure checkout</p>
                </div>
            </div>

            @if (Model.SameCategory.Count > 0)
            {
                <div class="fh-widget">
                    <h2 class="fh-widget-title">More in @product.Category</h2>
                    <div class="fh-linklist">
                        @foreach (var item in Model.SameCategory)
                        {
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@item.Id">
                                <span class="truncate">@item.Name</span>
                                <span class="text-white font-bold">$@item.PriceDisplay</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</section>

<!-- ============ RELATED ============ -->
@if (Model.Related.Count > 0)
{
    <section class="fh-wrap fh-section pt-0">
        <div class="fh-head">
            <div>
                <span class="fh-eyebrow">You may also like</span>
                <h2 class="fh-h2 mt-2">Related products</h2>
            </div>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var item in Model.Related)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

