@model FanHubPlus.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "FanHub Store";
}

@{
    var pageHeader = new FanHubPlus.ViewModels.PageHeaderViewModel { Eyebrow = "FanHub store", Title = "Official merch, soundtracks and devices", Subtitle = "Limited drops, vinyl and Blu-Ray editions, posters and streaming hardware. Members get early access to every release.", Breadcrumbs = new List<(string, string?)> { ("Home", "/Home/Index"), ("Store", null) }  };
}
<partial name="_PageHeader" model="pageHeader" />

<!-- ============ FEATURED DEALS ============ -->
@if (Model.Featured.Count > 0)
{
    <section class="fh-wrap pb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @foreach (var product in Model.Featured)
            {
                <article class="fh-panel fh-panel-flush fh-hover-panel">
                    <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.Id" class="fh-still !aspect-[16/10] rounded-none border-0" data-theme="@product.ArtTheme">
                        <i class="@product.ArtGlyph fh-art-glyph-sm"></i>
                        <span class="fh-chip fh-chip-primary absolute top-3 left-3 z-[3]">Save @product.DiscountPercent%</span>
                    </a>
                    <div class="p-5">
                        <h2 class="fh-h3">
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.Id" class="hover:text-[#f41b3b] transition-colors">@product.Name</a>
                        </h2>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="text-lg font-black text-white">$@product.PriceDisplay</span>
                            @if (product.OldPrice.HasValue)
                            {
                                <span class="text-xs text-gray-500 line-through">$@product.OldPriceDisplay</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}

<!-- ============ GRID + FILTERS ============ -->
<section class="fh-wrap pb-20">
    <div class="grid lg:grid-cols-[260px_1fr] gap-8">

        <aside class="space-y-6">
            <div class="fh-panel">
                <h2 class="fh-widget-title">Filter</h2>
                <form method="get" asp-controller="Shop" asp-action="Index" class="space-y-4">
                    <div>
                        <label class="fh-label" for="search">Search</label>
                        <div class="fh-input-group">
                            <i class="ri-search-line"></i>
                            <input type="search" id="search" name="search" value="@Model.Search" class="fh-input" placeholder="Product name" />
                        </div>
                    </div>
                    <div>
                        <label class="fh-label" for="price">Max price ($@Model.MaxPrice)</label>
                        <input type="range" id="price" name="maxPrice" min="0" max="500" step="10" value="@Model.MaxPrice" class="w-full accent-[#f41b3b]" />
                    </div>
                    <button type="submit" class="fh-btn fh-btn-primary fh-btn-block"><i class="ri-filter-3-line"></i> Apply</button>
                    <a asp-controller="Shop" asp-action="Index" class="fh-btn fh-btn-outline fh-btn-block">Reset</a>
                </form>
            </div>

            <div class="fh-widget">
                <h2 class="fh-widget-title">Categories</h2>
                <div class="fh-linklist">
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="All" class="@(Model.Category == "All" || Model.Category == null ? "is-active" : "")">
                        All products <i class="ri-arrow-right-s-line"></i>
                    </a>
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-controller="Shop" asp-action="Index" asp-route-category="@category" class="@(Model.Category == category ? "is-active" : "")">
                            @category <i class="ri-arrow-right-s-line"></i>
                        </a>
                    }
                </div>
            </div>
        </aside>

        <div>
            <div class="flex flex-wrap items-center justify-between gap-4 pb-5 mb-7 border-b border-white/10">
                <p class="text-sm text-gray-400">
                    Showing <span class="text-white font-bold">@Model.Products.Count</span> of <span class="text-white font-bold">@Model.TotalCount</span> product(s)
                </p>
                <form method="get" asp-controller="Shop" asp-action="Index" class="flex items-center gap-3">
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <label class="text-xs text-gray-500 uppercase tracking-wider" for="sortBy">Sort</label>
                    <select id="sortBy" name="sortBy" class="fh-input !w-auto !py-2 text-xs" onchange="this.form.submit()">
                        <option value="popular" selected="@(Model.SortBy == "popular" || Model.SortBy == null)">Most popular</option>
                        <option value="rating" selected="@(Model.SortBy == "rating")">Top rated</option>
                        <option value="price-asc" selected="@(Model.SortBy == "price-asc")">Price: low to high</option>
                        <option value="price-desc" selected="@(Model.SortBy == "price-desc")">Price: high to low</option>
                    </select>
                </form>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="fh-empty">
                    <i class="ri-shopping-bag-3-line"></i>
                    <h2 class="fh-h3 mt-4">No products matched</h2>
                    <p class="fh-lead mt-2">Try a different keyword or raise the price filter.</p>
                    <a asp-controller="Shop" asp-action="Index" class="fh-btn fh-btn-primary mt-6">Clear filters</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }
        </div>
    </div>
</section>

