{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=FanHubPlus;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "MultiTier": {
      "EnableDistributedCache": true,
      "DefaultL1AbsoluteExpiration": "00:05:00",
      "DefaultL1SlidingExpiration": "00:02:00",
      "DefaultL2AbsoluteExpiration": "00:30:00",
      "DefaultL2SlidingExpiration": "00:10:00",
      "L1CacheSizeLimit": 104857600,
      "CompressionThreshold": 1024
    }
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "WritePermitLimit": 20,
    "WriteWindowMinutes": 1,
    "AuthPermitLimit": 10,
    "AuthWindowMinutes": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "FanHubPlus": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 52428800
    }
  }
}