# ---------------------------------------------------------------------------
#  FanHubPlus - files that must never be committed, zipped or handed in
#
#  Only the ASP.NET Core project belongs in this repository:
#     Areas/ Controllers/ Data/ Migrations/ Models/ Properties/ Repositories/
#     Services/ Views/ wwwroot/ tests/  + the .sln, .csproj, Program.cs,
#     appsettings*.json and the Markdown docs.
#  Everything else below is machine-local scratch.
# ---------------------------------------------------------------------------

# Node / npm. The UI ships pre-built CSS under wwwroot/css, so the app never
# needs an npm step - do not reinstall or recommit these.
node_modules/
package-lock.json
package.json
npm-debug.log*

# One-off scratch scripts and captured output written by tooling/debugging
# sessions. They are prefixed with "_" or live in a tool-named file.
_*.ps1
_*.sh
_*.sql
_*.tsv
_*.txt
_*.html
_*.css
_*.js
audit-*.js
audit-*.ps1
*.pid

# Build output. The patterns match any folder depth and any casing, so they
# also cover tests/FanHubPlus.Tests/bin and tests/FanHubPlus.Tests/obj.
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
TestResults/
*.binlog
*.trx
*.coverage
coverage*.json
*.coveragexml

# Packaged copies of the project / stray archives ("a zip inside the zip")
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz

# Visual Studio / VS Code / Rider / ReSharper user state
.vs/
.vscode/
.idea/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# .NET / NuGet restore artifacts
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
packages/
.nuget/

# Scratch files left behind by error/emitted by ad-hoc tooling
*.err
*.log
missing.txt
tw.check.css

# Machine-local secrets and configuration overrides.
#   Credentials for the demo accounts are supplied through environment
#   variables or user-secrets (see README.md) - never through a committed file.
appsettings.Production.json
appsettings.Local.json
appsettings.*.Local.json
appsettings.Development.local.json
secrets.json
*.pfx
*.snk

# User uploads are runtime data, not source (folders are recreated on demand)
wwwroot/uploads/**
!wwwroot/uploads/.gitkeep

# OS / editor junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~
*.swp
*.tmp
*.bak

# Local agent/editor worktrees
.kilo/
.kilocode/
.worktrees/

# Local build output used for smoke-testing the app
.verify-build/

# Before/after UI screenshots captured by the CDP screenshot scripts
shots/

# Raw HTML pages of the bought template, kept only while porting views.
# They are reference material, not project source - never hand these in.
.tpl/

# Headless-browser scratch directories (Chrome/Edge profiles and screenshots
# created while debugging the UI). These are machine-local and can be several
# hundred MB - they must never be committed.
.chrome-cdp/
.chrome-cdp2/
.chrome-dom/
.chrome-verify/
chrome-prof*/
chrome-profile*/
navbar-shots/
cdp-probe.js
shot-*.png
nav-*.png
current-nav*.png
v-*.png
live_page.html
original-*.html
