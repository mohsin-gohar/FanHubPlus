@model FanHubPlus.Models.Entities.Content
@{
    ViewData["Title"] = "Play: " + Model.Title;
    ViewData["fhpDark"] = true;
    var trail = new List<BreadcrumbItem>
    {
        new("Gaming Hub", Url.Action("Index", "Gaming")),
        new(Model.Title, Url.Action("Details", "Gaming", new { id = Model.ContentId })),
        new("Play")
    };
}

<partial name="_PageBanner" model="trail" />

<div class="fhp-py-60 fhp-md-py-80">
    <div class="container">

        <!-- Game Title Row -->
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap fhp-gap-12">
            <div>
                <span class="d-inline-block fhp-px-12 py-1 fhp-bg-success-20 text-success border fhp-border-success-30 rounded-pill fhp-fs-12 fw-bold text-uppercase mb-2">
                    <i class="ri-gamepad-line me-1"></i> Browser Game
                </span>
                <h1 class="fhp-fs-24 fs-2 fw-bolder text-white">@Model.Title</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Genre))
                {
                    <p class="fhp-text-white-60 fhp-fs-14 mt-1">@Model.Genre</p>
                }
            </div>
            <div class="d-flex fhp-gap-12">
                <a asp-controller="Gaming" asp-action="Details" asp-route-id="@Model.ContentId"
                   class="btn btn-outline-secondary text-white fhp-border-white-30 fhp-hover-bg-white-10 fhp-transition px-3 py-2 rounded-pill">
                    <i class="ri-information-line me-1"></i> Game Info
                </a>
                <a asp-controller="Gaming" asp-action="Index"
                   class="btn btn-link fhp-text-white-60 text-decoration-none">
                    <i class="ri-arrow-left-line me-1"></i> Back
                </a>
            </div>
        </div>

        <!-- Notice Banner -->
        <div class="fhp-bg-warning-10 border fhp-border-warning-30 rounded-4 p-3 mb-4 d-flex align-items-start fhp-gap-12">
            <i class="ri-shield-check-line text-warning fhp-fs-20 flex-shrink-0 fhp-mt-2"></i>
            <p class="fhp-text-warning-90 fhp-fs-14 lh-lg mb-0">
                <strong>Legal Notice:</strong> Only legally authorized, royalty-free browser games are available here.
                All games are embedded from their official or approved sources and remain the property of their respective owners.
            </p>
        </div>

        <!-- Game Embed -->
        <div class="bg-black rounded-5 border fhp-border-white-10 shadow-lg overflow-hidden fhp-mb-32"
             style="min-height: 520px;">
            <div id="gameLoadingOverlay"
                 class="position-absolute top-0 bottom-0 start-0 end-0 bg-black d-flex flex-column align-items-center justify-content-center gap-3 fhp-z-10 fhp-transition-opacity fhp-dur500">
                <div class="fhp-w-48 fhp-h-48 rounded-pill border-4 border-success fhp-border-t-transparent fhp-spin"></div>
                <p class="fhp-text-white-60 fhp-fs-14">Loading game…</p>
            </div>
            <iframe id="gameFrame"
                    src="@Model.PlayableGameUrl"
                    class="w-100 d-block border-0"
                    style="height: 620px;"
                    title="@Model.Title"
                    allowfullscreen
                    allow="fullscreen; accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; pointer-lock"
                    sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-orientation-lock allow-top-navigation-by-user-activation"
                    loading="lazy">
            </iframe>
        </div>

        <!-- Fullscreen + Controls -->
        <div class="d-flex flex-wrap fhp-gap-12 fhp-mb-40">
            <button id="btnFullscreen" type="button"
                    class="primary-btn">
                <i class="ri-fullscreen-line me-2"></i> Fullscreen
            </button>
            <button id="btnReload" type="button"
                    class="btn btn-outline-secondary text-white fhp-border-white-30 fhp-hover-bg-white-10 fhp-transition fhp-px-20 py-2 rounded-pill">
                <i class="ri-restart-line me-2"></i> Reload Game
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.OfficialWebsiteUrl))
            {
                <a href="@Model.OfficialWebsiteUrl" target="_blank" rel="noopener"
                   class="btn btn-outline-secondary text-white fhp-border-white-30 fhp-hover-bg-white-10 fhp-transition fhp-px-20 py-2 rounded-pill">
                    <i class="ri-external-link-line me-1"></i> Official Site
                </a>
            }
        </div>

        <!-- Description -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="fhp-bg-18181f border fhp-border-white-10 rounded-5 p-4 fhp-md-p-32">
                <h2 class="fhp-fs-20 fw-bold text-white mb-3">About This Game</h2>
                <p class="fhp-text-white-70 fs-6 lh-lg">@Model.Description</p>
            </div>
        }

    </div>
</div>

@section Scripts {
<script>
(function () {
    var frame = document.getElementById('gameFrame');
    var overlay = document.getElementById('gameLoadingOverlay');

    if (frame && overlay) {
        frame.addEventListener('load', function () {
            overlay.style.opacity = '0';
            setTimeout(function () { overlay.style.display = 'none'; }, 500);
        });
    }

    // Fullscreen
    document.getElementById('btnFullscreen').addEventListener('click', function () {
        var el = frame || document.documentElement;
        if (el.requestFullscreen)       el.requestFullscreen();
        else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
        else if (el.mozRequestFullScreen)    el.mozRequestFullScreen();
    });

    // Reload
    document.getElementById('btnReload').addEventListener('click', function () {
        if (frame) {
            frame.src = frame.src;
            if (overlay) {
                overlay.style.display = 'flex';
                overlay.style.opacity = '1';
            }
        }
    });
})();
</script>
}
