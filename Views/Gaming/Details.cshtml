@model GameDetailViewModel
@{
    ViewData["Title"] = Model.Game.Title;
    ViewData["fhpDark"] = true;
    var trail = new List<BreadcrumbItem>
    {
        new("Gaming Hub", Url.Action("Index", "Gaming")),
        new(Model.Game.Title)
    };
    var cover = string.IsNullOrWhiteSpace(Model.Game.ThumbnailUrl)
        ? "/assets/images/categories/category2.jpg"
        : Model.Game.ThumbnailUrl;
    var isPlayable = Model.Game.Type == ContentType.PlayableGame
                     || !string.IsNullOrWhiteSpace(Model.Game.PlayableGameUrl);
}

<partial name="_PageBanner" model="trail" />

<div class="fhp-py-60 fhp-md-py-80">
    <div class="container">

        <!-- Game Hero Card -->
        <div class="fhp-bg-18181f border fhp-border-white-10 rounded-5 overflow-hidden shadow-lg fhp-mb-40">
            <div class="row g-0">
                <!-- Cover -->
                <div class="col-lg-4">
                    <div class="position-relative fhp-aspect-3-4 fhp-md-aspect-auto fhp-md-h-100 fhp-minh-280 overflow-hidden">
                        <img src="@cover" alt="@Model.Game.Title"
                             class="w-100 h-100 fhp-object-cover" loading="eager" />
                        @if (isPlayable)
                        {
                            <div class="position-absolute top-0 bottom-0 start-0 end-0 fhp-bg-black-50 d-flex align-items-center justify-content-center opacity-0 fhp-hover-opacity-100 fhp-transition-opacity">
                                <a asp-controller="Gaming" asp-action="Play" asp-route-id="@Model.Game.ContentId"
                                   class="fhp-w-64 fhp-h-64 rounded-pill bg-success d-flex align-items-center justify-content-center fhp-fs-30 fhp-text-black shadow-lg fhp-hover-scale-110 fhp-transition-transform">
                                    <i class="ri-play-fill"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Details -->
                <div class="col-lg-8">
                    <div class="fhp-p-12 fhp-md-p-40 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 fhp-mb-12">
                                <span class="fhp-px-12 py-1 fhp-bg-success-20 text-success border fhp-border-success-30 rounded-pill fhp-fs-12 fw-bold text-uppercase">
                                    <i class="ri-gamepad-line me-1"></i>
                                    @(Model.Game.Genre ?? "Video Game")
                                </span>
                                @if (isPlayable)
                                {
                                    <span class="fhp-px-12 py-1 fhp-bg-warning-20 text-warning border fhp-border-warning-30 rounded-pill fhp-fs-12 fw-bold text-uppercase">
                                        <i class="ri-play-circle-fill me-1"></i> Browser Playable
                                    </span>
                                }
                                <span class="fhp-text-white-50 fhp-fs-12">@Model.Game.Category.Name</span>
                            </div>

                            <h1 class="fhp-fs-30 fs-1 fw-bolder text-white fhp-mb-12 lh-sm">@Model.Game.Title</h1>

                            <!-- Rating Row -->
                            <div class="d-flex align-items-center fhp-gap-12 fhp-mb-12 fhp-fs-14">
                                <div class="d-flex align-items-center gap-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= Math.Round(Model.AverageRating) ? "ri-star-fill text-warning" : "ri-star-line text-white/30")"></i>
                                    }
                                    <span class="fhp-text-white-70 ms-1">@Model.AverageRating / 5.0 (@Model.RatingCount ratings)</span>
                                </div>
                                <span class="fhp-text-white-40">|</span>
                                <span class="fhp-text-white-60"><i class="ri-eye-line me-1"></i>@Model.Game.ViewCount.ToString("N0") views</span>
                                <span class="fhp-text-white-40">|</span>
                                <span class="fhp-text-white-60"><i class="ri-fire-line text-warning me-1"></i>@Model.Game.PopularityScore score</span>
                            </div>

                            <p class="fhp-text-white-70 fs-6 lh-lg fhp-mb-12">
                                @(string.IsNullOrWhiteSpace(Model.Game.Description)
                                    ? "No description available for this title."
                                    : Model.Game.Description)
                            </p>

                            @if (Model.Game.ReleaseDate.HasValue)
                            {
                                <div class="fhp-text-white-50 fhp-fs-14 fhp-mb-12">
                                    <i class="ri-calendar-line me-1"></i>
                                    Released: <strong class="text-white">@Model.Game.ReleaseDate.Value.ToString("MMMM d, yyyy")</strong>
                                </div>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap fhp-gap-12 fhp-pt-12 border-top fhp-border-white-10">
                            @if (isPlayable)
                            {
                                <a asp-controller="Gaming" asp-action="Play" asp-route-id="@Model.Game.ContentId"
                                   class="primary-btn">
                                    <i class="ri-play-circle-line me-2"></i> Play Now
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Game.OfficialWebsiteUrl))
                            {
                                <a href="@Model.Game.OfficialWebsiteUrl" target="_blank" rel="noopener"
                                   class="btn btn-outline-secondary text-white fhp-border-white-30 fhp-hover-bg-white-10 fhp-transition fhp-px-20 py-2 rounded-pill">
                                    <i class="ri-external-link-line me-1"></i> Official Site
                                </a>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button"
                                        id="bookmarkBtn"
                                        class="btn @(Model.IsBookmarked ? "btn-danger" : "btn-outline-secondary text-white border-white/30") rounded-full px-4 py-2 transition-all"
                                        data-id="@Model.Game.ContentId"
                                        data-type="Content"
                                        title="@(Model.IsBookmarked ? "Remove Bookmark" : "Add Bookmark")">
                                    <i class="@(Model.IsBookmarked ? "ri-heart-fill" : "ri-heart-line") me-1"></i>
                                    @(Model.IsBookmarked ? "Saved" : "Save")
                                </button>
                            }
                            <a asp-controller="Gaming" asp-action="Index"
                               class="btn btn-link fhp-text-white-60 fhp-hover-text-white text-decoration-none fhp-px-12">
                                <i class="ri-arrow-left-line me-1"></i> Back to Gaming Hub
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trailer -->
        @if (Model.Trailer != null && !string.IsNullOrWhiteSpace(Model.Trailer.EmbedUrl))
        {
            <div class="fhp-mb-40">
                <h2 class="fhp-fs-24 fw-bold text-white fhp-mb-12"><i class="ri-film-line me-2 text-success"></i>Official Trailer</h2>
                @* _MediaPlayer decides <video> vs <iframe> from the url itself and runs it
                   through MediaUrl.Normalize. A raw <iframe> here used to be handed an
                   /assets/videos/*.mp4 path, which no embed host can play - the box stayed
                   blank. The wrapper keeps the frame styling, the partial supplies the
                   16:9 box (.fhp-media__player). *@
                <div class="bg-black rounded-5 overflow-hidden border fhp-border-white-10 shadow-lg">
                    <partial name="_MediaPlayer" model="new MediaPlayerViewModel
                           {
                               Url = Model.Trailer.EmbedUrl,
                               Poster = cover,
                               Title = Model.Game.Title
                           }" />
                </div>
            </div>
        }

        <!-- Related Games -->
        @if (Model.RelatedGames.Count > 0)
        {
            <h2 class="fhp-fs-24 fw-bold text-white fhp-mb-12">Related Games</h2>
            <div class="row g-4">
                @foreach (var g in Model.RelatedGames)
                {
                    var relCover = string.IsNullOrWhiteSpace(g.ThumbnailUrl) ? "/assets/images/categories/category2.jpg" : g.ThumbnailUrl;
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="fhp-bg-18181f border fhp-border-white-10 rounded-4 overflow-hidden fhp-group fhp-hover-border-success-50 fhp-transition">
                            <div class="position-relative fhp-aspect-16-9 overflow-hidden">
                                <img src="@relCover" alt="@g.Title"
                                     class="w-100 h-100 fhp-object-cover fhp-group-hover-scale-105 fhp-transition-transform fhp-dur500" loading="lazy" />
                            </div>
                            <div class="fhp-p-12">
                                <span class="fhp-fs-11 fw-bold text-success text-uppercase fhp-ls-wider d-block mb-1">@(g.Genre ?? "Game")</span>
                                <h5 class="text-white fw-bold fhp-fs-14 text-truncate mb-1" title="@g.Title">
                                    <a asp-controller="Gaming" asp-action="Details" asp-route-id="@g.ContentId"
                                       class="fhp-hover-text-success fhp-transition-colors">@g.Title</a>
                                </h5>
                                <div class="fhp-fs-12 fhp-text-white-40">
                                    <i class="ri-fire-line text-warning me-1"></i> @g.PopularityScore Score
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('bookmarkBtn');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var id   = btn.dataset.id;
        var type = btn.dataset.type;
        fetch('/Bookmarks/Toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
            body: JSON.stringify({ id: parseInt(id), type: type })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.bookmarked) {
                btn.innerHTML = '<i class="ri-heart-fill me-1"></i> Saved';
                btn.classList.remove('btn-outline-secondary', 'text-white', 'border-white/30');
                btn.classList.add('btn-danger');
            } else {
                btn.innerHTML = '<i class="ri-heart-line me-1"></i> Save';
                btn.classList.add('btn-outline-secondary', 'text-white', 'border-white/30');
                btn.classList.remove('btn-danger');
            }
        });
    });
})();
</script>
}
