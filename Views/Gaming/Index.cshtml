@model GamingViewModel
@{
    ViewData["Title"] = "Gaming Discovery Hub";
    var trail = new List<BreadcrumbItem> { new("Gaming Hub") };
}

<partial name="_PageBanner" model="trail" />

<div class="fhp-py-60 fhp-md-py-80">
    <div class="container">
        <!-- Hero Gaming Banner -->
        <div class="fhp-grad-r fhp-from-181828 fhp-to-122822 border fhp-border-white-10 rounded-5 p-4 fhp-md-p-40 fhp-mb-40 text-white shadow-lg position-relative overflow-hidden">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="d-inline-block text-uppercase fhp-fs-12 fw-bold fhp-px-12 py-1 fhp-bg-success-20 text-success border fhp-border-success-30 rounded-pill fhp-mb-12">
                        <i class="ri-gamepad-line me-1"></i> Interactive Gaming Realm
                    </span>
                    <h1 class="fhp-fs-30 fs-1 fw-bolder fhp-mb-12">Gaming Discovery &amp; Playable Hub</h1>
                    <p class="fhp-text-white-70 fs-6 fhp-maxw-672 mb-3">
                        Discover top esports titles, open-world RPGs, and retro classics. Watch official launch trailers, explore game specs, or play legally authorized web games directly in your browser.
                    </p>
                </div>
            </div>
        </div>

        <!-- Filter controls -->
        <form method="get" asp-controller="Gaming" asp-action="Index" class="fhp-mb-32">
            <div class="d-flex align-items-center flex-wrap fhp-gap-12">
                <input type="search" name="search" value="@Model.Search" class="form-control form-input !w-auto fhp-h-44" placeholder="Search game or franchise..." />

                <select name="categoryId" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="">All Fandom Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                    }
                </select>

                <div class="form-check form-switch d-flex align-items-center gap-2 text-white fhp-fs-14 ms-2">
                    <input class="form-check-input" type="checkbox" name="playableOnly" value="true" id="playableOnly" @(Model.PlayableOnly ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label fhp-cursor-pointer" for="playableOnly">Browser-Playable Only</label>
                </div>

                <button class="primary-btn" type="submit">Filter</button>
                <a asp-controller="Gaming" asp-action="Index" class="btn btn-link text-white text-decoration-none">Reset</a>
            </div>
        </form>

        <!-- Game Cards Grid -->
        @if (Model.Games.Count == 0)
        {
            <div class="text-center fhp-py-64 fhp-bg-white-5 rounded-5 border fhp-border-white-10">
                <i class="ri-gamepad-line fhp-fs-60 fhp-text-white-30 fhp-mb-12 d-block"></i>
                <h3 class="fhp-fs-20 fw-bold text-white mb-2">No Games Found</h3>
                <p class="fhp-text-white-60 mb-3">Try clearing filters or search terms.</p>
                <a asp-controller="Gaming" asp-action="Index" class="primary-btn">Explore All Games</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var game in Model.Games)
                {
                    var cover = string.IsNullOrWhiteSpace(game.ThumbnailUrl) ? "/assets/images/categories/category2.jpg" : game.ThumbnailUrl;
                    var isPlayable = game.Type == ContentType.PlayableGame || !string.IsNullOrWhiteSpace(game.PlayableGameUrl);

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="fhp-bg-18181f border fhp-border-white-10 rounded-4 overflow-hidden fhp-group fhp-hover-border-success-50 fhp-transition fhp-dur300">
                            <div class="position-relative fhp-aspect-16-9 overflow-hidden fhp-bg-black-40">
                                <img src="@cover" alt="@game.Title" class="w-100 h-100 fhp-object-cover fhp-group-hover-scale-105 fhp-transition-transform fhp-dur500" loading="lazy" />
                                @if (isPlayable)
                                {
                                    <span class="position-absolute fhp-top-8 fhp-right-8 px-2 fhp-py-2 rounded fhp-fs-10 fw-bold bg-success fhp-text-black text-uppercase fhp-ls-wider shadow">
                                        <i class="ri-play-circle-fill me-1"></i> Playable
                                    </span>
                                }
                            </div>
                            <div class="p-3">
                                <span class="fhp-fs-11 fw-bold text-success text-uppercase fhp-ls-wider d-block mb-1">@(game.Genre ?? "Video Game")</span>
                                <h4 class="text-white fw-bold fs-6 text-truncate mb-2" title="@game.Title">
                                    <a asp-controller="Gaming" asp-action="Details" asp-route-id="@game.ContentId" class="fhp-hover-text-success fhp-transition-colors">@game.Title</a>
                                </h4>
                                <div class="d-flex align-items-center justify-content-between fhp-fs-12 fhp-text-white-50 pt-2 border-top fhp-border-white-10">
                                    <span><i class="ri-fire-line text-warning"></i> @game.PopularityScore Score</span>
                                    @if (isPlayable)
                                    {
                                        <a asp-controller="Gaming" asp-action="Play" asp-route-id="@game.ContentId" class="text-success fw-bold fhp-hover-text-decoration-underline">Play Now &rarr;</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Gaming" asp-action="Details" asp-route-id="@game.ContentId" class="fhp-text-white-70 fhp-hover-text-white">Details &rarr;</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
