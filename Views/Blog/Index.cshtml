@model BlogIndexViewModel
@{
    ViewData["Title"] = "Blog";
    ViewData["fhpBanner"] = true;
    var trail = new List<BreadcrumbItem> { new("Blog") };

    string TabUrl(string? timeline) => Url.Action("Index", "Blog", new { timeline, categoryId = Model.SelectedCategoryId }) ?? "#";
    string PageUrl(int page) => Url.Action("Index", "Blog", new { timeline = Model.Timeline, categoryId = Model.SelectedCategoryId, page }) ?? "#";
}

<partial name="_PageBanner" model="trail" />

<section class="fhp-section">
    <div class="container">
        <div class="fhp-layout">
            <div>
                <nav class="fhp-tabs fhp-mb-25" aria-label="Blog filters">
                    <a class="fhp-tabs__link @(Model.Timeline is null ? "is-active" : "")" href="@TabUrl(null)">All posts</a>
                    <a class="fhp-tabs__link @(Model.Timeline == "false" ? "is-active" : "")" href="@TabUrl("false")">News</a>
                    <a class="fhp-tabs__link @(Model.Timeline == "true" ? "is-active" : "")" href="@TabUrl("true")">Timeline</a>
                </nav>

                @if (Model.Articles.Count == 0)
                {
                    <div class="fhp-empty">
                        <h2 class="fhp-empty__title">No blog posts yet</h2>
                        <p>When the editorial desk publishes an article, it will appear here.</p>
                        <a class="fhp-btn fhp-btn--primary" asp-controller="Blog" asp-action="Index">Show all posts</a>
                    </div>
                }
                else
                {
                    <div class="fhp-grid fhp-grid--2">
                        @foreach (var article in Model.Articles)
                        {
                            <partial name="_BlogCard" model="article" />
                        }
                    </div>

                    <div class="fhp-mt-25">
                        <partial name="_Pager" model="new {
                            Page = Model.Page,
                            TotalPages = Model.TotalPages,
                            UrlFor = (Func<int, string>)(p => PageUrl(p)) }" />
                    </div>
                }
            </div>

            <aside class="fhp-aside" aria-label="Blog categories">
                <div class="fhp-panel fhp-panel--flush">
                    <h2 class="fhp-side-title">Fandoms we cover</h2>
                    <ul class="fhp-list">
                        <li>
                            <a asp-controller="Blog" asp-action="Index"
                               asp-route-timeline="@Model.Timeline"
                               class="@(Model.SelectedCategoryId is null ? "is-active" : "")">
                                Every fandom <i class="ri-arrow-right-line" aria-hidden="true"></i>
                            </a>
                        </li>
                        @foreach (var category in Model.Categories)
                        {
                            <li>
                                <a asp-controller="Blog" asp-action="Index"
                                   asp-route-categoryId="@category.CategoryId"
                                   asp-route-timeline="@Model.Timeline"
                                   class="@(Model.SelectedCategoryId == category.CategoryId ? "is-active" : "")">
                                    @category.Name <i class="ri-arrow-right-line" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

<partial name="_JoinNow" />