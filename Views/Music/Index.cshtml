@model MusicViewModel
@{
    ViewData["Title"] = "Music & Soundtracks";
    var trail = new List<BreadcrumbItem> { new("Music & Soundtracks") };
}

<partial name="_PageBanner" model="trail" />

<div class="fhp-py-60 fhp-md-py-80">
    <div class="container">
        <!-- Hero Music Player Header -->
        <div class="fhp-grad-r fhp-from-18181f fhp-to-2a1b28 border fhp-border-white-10 rounded-5 p-4 fhp-md-p-32 fhp-mb-40 text-white shadow-lg position-relative overflow-hidden">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="d-inline-block text-uppercase fhp-fs-12 fw-bold fhp-px-12 py-1 fhp-bg-primary-20 text-primary border fhp-border-primary-30 rounded-pill fhp-mb-12">
                        <i class="ri-disc-line me-1"></i> Fandom Audio Universe
                    </span>
                    <h1 class="fhp-fs-30 fs-1 fw-bolder fhp-mb-12">Music, Soundtracks &amp; Playlists</h1>
                    <p class="text-body-secondary fs-6 fhp-maxw-672">
                        Listen to iconic anime openings, blockbuster soundtracks, K-Pop hits, and gaming themes. Play tracks directly, filter by fandom, or build custom playlists.
                    </p>
                </div>
                <div class="col-lg-4 text-end d-none d-lg-block">
                    <a asp-controller="Music" asp-action="Playlists" class="primary-btn">
                        <i class="ri-playlist-line me-2"></i> My Playlists
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" asp-controller="Music" asp-action="Index" class="fhp-mb-32">
            <div class="d-flex align-items-center flex-wrap fhp-gap-12">
                <input type="search" name="search" value="@Model.Search" class="form-control form-input !w-auto fhp-h-44" placeholder="Search song or artist..." />
                
                <select name="categoryId" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="">All Fandoms</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                    }
                </select>

                <select name="sort" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="popular" selected="@(Model.Sort == "popular" ? "selected" : null)">Most Popular</option>
                    <option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Recently Added</option>
                    <option value="artist" selected="@(Model.Sort == "artist" ? "selected" : null)">By Artist</option>
                    <option value="title" selected="@(Model.Sort == "title" ? "selected" : null)">Alphabetical</option>
                </select>

                <button class="primary-btn" type="submit">Filter</button>
                <a asp-controller="Music" asp-action="Index" class="btn btn-link text-white text-decoration-none">Reset</a>
            </div>
        </form>

        <!-- Song Cards Grid -->
        @if (Model.Songs.Count == 0)
        {
            <div class="text-center fhp-py-64 fhp-bg-white-5 rounded-5 border fhp-border-white-10">
                <i class="ri-music-2-line fhp-fs-60 fhp-text-white-30 fhp-mb-12 d-block"></i>
                <h3 class="fhp-fs-20 fw-bold text-white mb-2">No Music Found</h3>
                <p class="fhp-text-white-60 mb-3">Try adjusting your search terms or filters.</p>
                <a asp-controller="Music" asp-action="Index" class="primary-btn">View All Music</a>
            </div>
        }
        else
        {
            <div class="row g-4 fhp-mb-40">
                @foreach (var song in Model.Songs)
                {
                    var audio = song.MediaItems.FirstOrDefault(m => m.MediaType == FanHubPlus.Models.Enums.MediaType.Audio)
                             ?? song.MediaItems.FirstOrDefault();
                    var cover = string.IsNullOrWhiteSpace(song.ThumbnailUrl) ? "/assets/images/categories/category1.jpg" : song.ThumbnailUrl;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="fhp-bg-18181f border fhp-border-white-10 rounded-4 overflow-hidden fhp-group fhp-hover-border-primary-50 fhp-transition fhp-dur300">
                            <div class="position-relative fhp-aspect-square overflow-hidden fhp-bg-black-40">
                                <img src="@cover" alt="@song.Title" class="w-100 h-100 fhp-object-cover fhp-group-hover-scale-105 fhp-transition-transform fhp-dur500" loading="lazy" />
                                <div class="position-absolute top-0 bottom-0 start-0 end-0 fhp-bg-black-40 opacity-0 fhp-group-hover-opacity-100 fhp-transition-opacity d-flex align-items-center justify-content-center fhp-gap-12">
                                    @if (audio != null)
                                    {
                                        <button type="button" class="fhp-w-48 fhp-h-48 rounded-pill bg-primary text-white d-flex align-items-center justify-content-center fhp-fs-20 shadow-lg fhp-hover-scale-110 fhp-transition-transform"
                                                onclick="playAudioTrack('@song.Title', '@(song.Artist ?? "Unknown Artist")', '@audio.EmbedUrl', '@cover')">
                                            <i class="ri-play-fill"></i>
                                        </button>
                                    }
                                    <a asp-controller="Music" asp-action="Details" asp-route-id="@song.ContentId" class="fhp-w-40 fhp-h-40 rounded-pill fhp-bg-white-20 text-white d-flex align-items-center justify-content-center fhp-fs-18 fhp-hover-bg-white-40">
                                        <i class="ri-information-line"></i>
                                    </a>
                                </div>
                                <span class="position-absolute fhp-top-8 fhp-left-8 px-2 fhp-py-2 rounded fhp-fs-10 fw-bold fhp-bg-black-60 text-white text-uppercase fhp-ls-wider fhp-backdrop-blur">
                                    @song.Category.Name
                                </span>
                            </div>
                            <div class="p-3">
                                <h4 class="text-white fw-bold fs-6 text-truncate mb-1" title="@song.Title">
                                    <a asp-controller="Music" asp-action="Details" asp-route-id="@song.ContentId" class="fhp-hover-text-primary fhp-transition-colors">@song.Title</a>
                                </h4>
                                <p class="fhp-text-white-60 fhp-fs-12 text-truncate mb-2">@(song.Artist ?? "Original Soundtrack")</p>
                                <div class="d-flex align-items-center justify-content-between fhp-fs-12 fhp-text-white-40">
                                    <span><i class="ri-customer-service-2-line me-1"></i> @song.ViewCount.ToString("N0") plays</span>
                                    <span>@song.Genre</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<partial name="_AudioPlayerBar" />
