@model StreamingViewModel
@{
    ViewData["Title"] = "Movies & TV Shows";
    ViewData["fhpDark"] = true;
    var trail = new List<BreadcrumbItem> { new("Movies & TV Shows") };
}

<partial name="_PageBanner" model="trail" />

<div class="fhp-py-60 fhp-md-py-80">
    <div class="container">

        <!-- Hero Section -->
        <div class="fhp-grad-br fhp-from-0f0f1a fhp-via-1a0a2e fhp-to-0f1a0a border fhp-border-white-10 rounded-5 fhp-p-12 fhp-md-p-40 fhp-mb-40 shadow-lg position-relative overflow-hidden">
            <div class="position-absolute top-0 bottom-0 start-0 end-0 fhp-opacity-10 fhp-bg-url fhp-bg-cover fhp-bg-center pe-none"></div>
            <div class="position-relative row align-items-center">
                <div class="col-lg-8">
                    <span class="d-inline-block text-uppercase fhp-fs-12 fw-bold fhp-px-12 py-1 fhp-bg-primary-20 text-primary border fhp-border-primary-30 rounded-pill fhp-mb-12">
                        <i class="ri-film-line me-1"></i> Fandom Streaming Library
                    </span>
                    <h1 class="fhp-fs-30 fs-1 fw-bolder text-white fhp-mb-12 lh-sm">
                        Movies &amp; TV Shows
                    </h1>
                    <p class="fhp-text-white-70 fs-6 fhp-maxw-672 fhp-mb-20">
                        Explore legally embedded trailers and clips from blockbuster movies, anime series, K-dramas, and more. Watch official previews, browse genres, and discover your next obsession.
                    </p>
                    <div class="d-flex flex-wrap fhp-gap-12">
                        <a asp-action="Index" asp-route-contentType="Movie" class="primary-btn">
                            <i class="ri-movie-line me-2"></i> Browse Movies
                        </a>
                        <a asp-action="Index" asp-route-contentType="Series" class="btn btn-outline-secondary text-white fhp-border-white-30 fhp-hover-bg-white-10 fhp-transition fhp-px-20 py-2 rounded-pill">
                            <i class="ri-tv-2-line me-2"></i> Browse TV Shows
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                    <div class="d-grid fhp-gcol-2 fhp-gap-12 fhp-opacity-80">
                        @foreach (var f in Model.Featured.Take(4))
                        {
                            var fc = string.IsNullOrWhiteSpace(f.ThumbnailUrl) ? "/assets/images/categories/category3.jpg" : f.ThumbnailUrl;
                            <div class="rounded-4 overflow-hidden fhp-aspect-2-3 fhp-w-80">
                                <img src="@fc" alt="@f.Title" class="w-100 h-100 fhp-object-cover" loading="lazy" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" asp-controller="Streaming" asp-action="Index" class="fhp-mb-32">
            <div class="d-flex flex-wrap align-items-center fhp-gap-12">

                <input type="search" name="search" value="@Model.Search"
                       class="form-control form-input !w-auto fhp-h-44"
                       placeholder="Search title, genre, or description…" />

                <select name="contentType" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="Movie" selected="@(Model.ContentType == "Movie" ? "selected" : null)">🎬 Movies</option>
                    <option value="Series" selected="@(Model.ContentType == "Series" ? "selected" : null)">📺 TV Shows / Series</option>
                    <option value="Documentary" selected="@(Model.ContentType == "Documentary" ? "selected" : null)">🎥 Documentaries</option>
                    <option value="Special" selected="@(Model.ContentType == "Special" ? "selected" : null)">⭐ Specials / OVAs</option>
                </select>

                <select name="categoryId" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="">All Fandoms</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId ? "selected" : null)">
                            @cat.Name
                        </option>
                    }
                </select>

                <select name="sort" class="form-select !w-auto fhp-h-44" onchange="this.form.submit()">
                    <option value="popular" selected="@(Model.Sort == "popular" ? "selected" : null)">Most Popular</option>
                    <option value="newest"  selected="@(Model.Sort == "newest"  ? "selected" : null)">Newest Release</option>
                    <option value="views"   selected="@(Model.Sort == "views"   ? "selected" : null)">Most Viewed</option>
                    <option value="title"   selected="@(Model.Sort == "title"   ? "selected" : null)">A – Z</option>
                </select>

                <button class="primary-btn" type="submit">Filter</button>
                <a asp-controller="Streaming" asp-action="Index" class="btn btn-link fhp-text-white-60 text-decoration-none">Reset</a>
            </div>
        </form>

        <!-- Results Summary -->
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || !string.IsNullOrWhiteSpace(Model.ContentType))
        {
            <div class="fhp-text-white-60 fhp-fs-14 fhp-mb-12">
                Showing <strong class="text-white">@Model.TotalItems</strong> result@(Model.TotalItems != 1 ? "s" : "")
                @if (!string.IsNullOrWhiteSpace(Model.Search)) { <span> for "<em class="text-primary">@Model.Search</em>"</span> }
            </div>
        }

        <!-- Grid -->
        @if (Model.Items.Count == 0)
        {
            <div class="text-center fhp-py-80 fhp-bg-white-5 rounded-5 border fhp-border-white-10">
                <i class="ri-film-line fhp-fs-72 fhp-text-white-20 fhp-mb-12 d-block"></i>
                <h3 class="fhp-fs-24 fw-bold text-white mb-2">No Titles Found</h3>
                <p class="fhp-text-white-60 fhp-mb-20">Try adjusting your filters or search term.</p>
                <a asp-controller="Streaming" asp-action="Index" class="primary-btn">View All Titles</a>
            </div>
        }
        else
        {
            <div class="row g-4 fhp-mb-40">
                @foreach (var item in Model.Items)
                {
                    var cover = string.IsNullOrWhiteSpace(item.ThumbnailUrl) ? "/assets/images/categories/category3.jpg" : item.ThumbnailUrl;
                    var hasTrailer = item.MediaItems.Any(m => m.MediaType == FanHubPlus.Models.Enums.MediaType.Trailer ||
                                                              m.MediaType == FanHubPlus.Models.Enums.MediaType.Video);
                    var typeLabel = item.Type switch
                    {
                        FanHubPlus.Models.Enums.ContentType.Movie        => "Movie",
                        FanHubPlus.Models.Enums.ContentType.Series       => "Series",
                        FanHubPlus.Models.Enums.ContentType.Documentary  => "Documentary",
                        FanHubPlus.Models.Enums.ContentType.Special      => "Special",
                        _ => item.Type.ToString()
                    };

                    <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                        <div class="fhp-group fhp-bg-18181f border fhp-border-white-10 rounded-4 overflow-hidden fhp-hover-border-primary-50 fhp-transition fhp-dur300 h-100 d-flex flex-column">

                            <!-- Poster -->
                            <div class="position-relative fhp-aspect-2-3 overflow-hidden fhp-bg-black-40">
                                <img src="@cover" alt="@item.Title"
                                     class="w-100 h-100 fhp-object-cover fhp-group-hover-scale-105 fhp-transition-transform fhp-dur500"
                                     loading="lazy" />

                                <!-- Hover Overlay -->
                                <div class="position-absolute top-0 bottom-0 start-0 end-0 fhp-grad-t fhp-from-black-90 via-black/30 fhp-to-transparent opacity-0 fhp-group-hover-opacity-100 fhp-transition-opacity d-flex flex-column justify-content-end fhp-p-12">
                                    <a asp-controller="Streaming" asp-action="Details" asp-route-id="@item.ContentId"
                                       class="fhp-w-40 fhp-h-40 rounded-pill bg-primary d-flex align-items-center justify-content-center text-white fhp-fs-18 mx-auto mb-2 fhp-hover-scale-110 fhp-transition-transform shadow-lg">
                                        @if (hasTrailer) { <i class="ri-play-fill"></i> }
                                        else             { <i class="ri-information-line"></i> }
                                    </a>
                                </div>

                                <!-- Type Badge -->
                                <span class="position-absolute fhp-top-8 fhp-left-8 px-2 fhp-py-2 rounded fhp-fs-10 fw-bold fhp-bg-primary-80 text-white text-uppercase fhp-ls-wide fhp-backdrop-blur">
                                    @typeLabel
                                </span>

                                @if (hasTrailer)
                                {
                                    <span class="position-absolute fhp-top-8 fhp-right-8 px-2 fhp-py-2 rounded fhp-fs-10 fw-bold fhp-bg-success-80 fhp-text-black text-uppercase fhp-backdrop-blur">
                                        <i class="ri-play-circle-fill fhp-me-2"></i> Trailer
                                    </span>
                                }
                            </div>

                            <!-- Info -->
                            <div class="fhp-p-12 d-flex flex-column flex-grow-1">
                                <span class="fhp-fs-10 fhp-text-white-40 text-uppercase fhp-ls-wider mb-1">@item.Category.Name</span>
                                <h4 class="text-white fw-bold fhp-fs-14 lh-sm mb-1 fhp-line-clamp-2 flex-grow-1" title="@item.Title">
                                    <a asp-controller="Streaming" asp-action="Details" asp-route-id="@item.ContentId"
                                       class="fhp-hover-text-primary fhp-transition-colors">
                                        @item.Title
                                    </a>
                                </h4>
                                <div class="d-flex align-items-center justify-content-between fhp-fs-10 fhp-text-white-40 mt-auto pt-2 border-top fhp-border-white-10">
                                    <span>@(item.Genre?.Split(',').FirstOrDefault()?.Trim() ?? "—")</span>
                                    @if (item.ReleaseDate.HasValue)
                                    {
                                        <span>@item.ReleaseDate.Value.Year</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pager -->
            <partial name="_Pager" model="new {
                Page = Model.Page,
                TotalPages = Model.TotalPages,
                UrlFor = (Func<int, string>)(p => Model.PageUrl(p)) }" />
        }

    </div>
</div>
