@model SitemapViewModel
@{
    ViewData["Title"] = "Sitemap";
    ViewData["fhpBanner"] = true;
    var trail = new List<BreadcrumbItem> { new("Sitemap") };
}

<partial name="_PageBanner" model="trail" />

<section class="fhp-section">
    <div class="container">
        <div class="fhp-panel fhp-panel--flush">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <h2>Every corner of FanHubPlus</h2>
                </div>
                <a class="fhp-more" asp-action="Xml">sitemap.xml</a>
            </div>
            <p class="fhp-hint fhp-mb-25">
                Generated live from the database. Search engines can also read the
                machine-readable <a class="fhp-link-strong" asp-action="Xml">sitemap.xml</a>.
            </p>

            <div class="fhp-grid fhp-grid--3">
                @foreach (var block in Model.Sections)
                {
                    <div class="fhp-panel fhp-panel--flush">
                        <h3 class="fhp-side-title">
                            <a href="@block.Url">@block.Title</a>
                        </h3>
                        @if (block.Children.Count == 0)
                        {
                            <p class="fhp-hint">Nothing published here yet.</p>
                        }
                        else
                        {
                            <ul class="fhp-list">
                                @foreach (var link in block.Children)
                                {
                                    <li>
                                        <a href="@link.Url">
                                            @link.Title <i class="ri-arrow-right-line" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<partial name="_JoinNow" />