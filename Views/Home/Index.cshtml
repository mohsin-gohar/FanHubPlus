@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["fhpDark"] = true;   // the landing page keeps the template's dark bed

    var slides = Model.Trending.Take(4).ToList();
    if (slides.Count == 0)
    {
        slides = Model.Categories.Take(4).Select((c, i) => new Content
        {
            ContentId = i,
            Title = c.Name,
            CategoryId = c.CategoryId,
            Category = new Category { CategoryId = c.CategoryId, Name = c.Name, IconUrl = c.IconUrl, Description = c.Description },
            Description = c.Description,
        }).ToList();
    }

    Func<int, string> posterArt = i => $"/assets/images/banners/banner-bg{(i % 6) + 1}.jpg";
    Func<int, string> thumbArt = i => $"/assets/images/banners/banner-thumb{(i % 4) + 1}.jpg";
    Func<int, string> movieArt = i => $"/assets/images/movies/movie{(i % 24) + 1}.jpg";
    Func<int, string> categoryArt = i => $"/assets/images/categories/category{(i % 7) + 1}.jpg";
    Func<int, string> userArt = i => $"/assets/images/users/user{(i % 8) + 1}.jpg";
    string Art(string? url, Func<int, string> fallback, int i) => string.IsNullOrWhiteSpace(url) ? fallback(i) : url;

    // The template's section head: vector mark + title on the left, the
    // underlined "View More" link on the right.
    Func<string, string, string, Microsoft.AspNetCore.Html.IHtmlContent> Head = (title, href, linkText) => new Microsoft.AspNetCore.Html.HtmlString(
        "<div class=\"fhp-mb-25 fhp-md-mb-35 fhp-lg-mb-45 fhp-md-flex fhp-md-items-center fhp-md-justify-between fhp-gap-25\">" +
        "  <div class=\"fhp-flex fhp-items-center fhp-gap-13\">" +
        "    <img src=\"/assets/images/icons/vector.svg\" class=\"fhp-rtl-scale-x-n100\" alt=\"vector\">" +
        "    <h2 class=\"mb-0 fhp-fs-22 fhp-md-fs-26 fhp-lg-fs-32 lh-1 fhp-text-animation\">" + title + "</h2>" +
        "  </div>" +
        "  <a href=\"" + href + "\" class=\"fhp-flex-none fhp-mt-15 fhp-md-mt-0 lh-1 d-inline-block relative fw-bold text-secondary fhp-transition fhp-dur300 fhp-ease fhp-hover-text-primary fhp-before-absolute fhp-before-bottom-0 fhp-before-left-0 fhp-before-right-0 fhp-before-h-px fhp-before-bg-secondary fhp-before-transition fhp-before-dur300 fhp-before-ease fhp-hover-before-bg-primary fhp-hover-before-scale-x-0\">" + linkText + "</a>" +
        "</div>");

    // Hover action row the template floats over a tile or a video cover.
    const string tileActions = "fhp-flex fhp-items-center fhp-justify-center fhp-flex-wrap fhp-gap-5 fhp-absolute fhp-bottom-10px fhp-left-50 fhp-tx-n50 fhp-transition fhp-dur300 fhp-ease fhp-opacity-0 fhp-invisible fhp-group-hover-opacity-100 fhp-group-hover-visible fhp-group-hover-bottom-20px";
    const string tileAction = "fhp-flex fhp-items-center fhp-justify-center text-white fhp-bg-white-30 rounded-full fhp-w-30 fhp-h-30 fhp-transition fhp-dur300 fhp-ease fhp-hover-bg-primary fhp-hover-text-white";

    var feedback = new (string Quote, string Name, string Role)[]
    {
        ("Ratings, bookmarks and fan art in one place - finally a hub that understands how fandoms actually work.", "Ayesha Khan", "Anime fan"),
        ("The events board never lets me down. I bookmark what I love and I actually show up now.", "Daniel Reyes", "Convention regular"),
        ("Uploading my cosplay took seconds, and the feedback is what keeps me creating.", "Mei Tanaka", "Cosplayer"),
    };
}

<!-- Banner -->
<div class="fhp-px-10 fhp-pt-10 position-relative">
    <div class="swiper bannerSwiper fhp-r-10 fhp-bw-4 fhp-md-bw-6 fhp-border-white-15">
        <div class="swiper-wrapper">
            @for (var i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                var genres = (slide.Genre ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Take(4)
                    .ToList();
                <div class="swiper-slide">
                    <div class="fhp-pt-130 fhp-md-pt-160 fhp-lg-pt-180 fhp-xl-pt-280 fhp-xxl-pt-340 fhp-pb-60 fhp-md-pb-80 fhp-lg-pb-65 position-relative fhp-z-1">
                        <div class="container fhp-xxl-px-30 fhp-xl-maxw-1920">
                            <div class="text-center mx-auto">
                                <h1 class="text-uppercase fhp-font-secondary !font-extrabold fs-2 fhp-md-fs-60 fhp-lg-fs-96 fhp-xl-fs-128 fhp-xxl-fs-150 lh-1 fhp-lg-tracking-n0-05em fhp-mb-15 fhp-text-animation" data-swiper-parallax="-400" data-swiper-parallax-opacity="0.2" data-swiper-parallax-scale="0.9">
                                    @slide.Title
                                </h1>
                                <div class="d-flex align-items-center justify-content-center flex-wrap fhp-gap-15 fhp-md-gap-20 fhp-mt-25 fhp-md-mt-30" data-swiper-parallax-y="-120" data-swiper-parallax-opacity="0.6">
                                    <a asp-controller="Explore" asp-action="Details" asp-route-id="@slide.ContentId" class="primary-btn">
                                        <span>
                                            <i class="ri-play-fill"></i>
                                            Start Watching
                                        </span>
                                    </a>
                                    <a asp-controller="Explore" asp-action="Index" class="primary-btn fhp-with-border">
                                        Explore Everything
                                    </a>
                                </div>
                            </div>
                            <div class="fhp-mt-20 fhp-md-mt-80 fhp-lg-mt-65 text-center fhp-ltr-md:text-left fhp-rtl-md:text-right" data-swiper-parallax="200" data-swiper-parallax-opacity="0" data-swiper-parallax-scale="1.05">
                                <div class="d-flex align-items-center justify-content-center fhp-md-justify-start fhp-text-ff962e fs-6 fhp-md-fs-18 fhp-gap-5">
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <span class="d-block text-uppercase fw-bold fhp-fs-13 fhp-md-fs-14 fhp-tracking-0-15em fhp-text-body-70 fhp-ltr-ml-[5px] fhp-rtl-mr-[5px]">
                                        (<span class="text-secondary">@Model.TotalContents.ToString("N0")</span> Titles)
                                    </span>
                                </div>
                                <div class="d-flex align-items-center justify-content-center fhp-md-justify-start flex-wrap fhp-gap-10 fhp-mt-17 fhp-fs-12 fhp-md-fs-13 fw-bold">
                                    @foreach (var genre in genres)
                                    {
                                        <a asp-controller="Explore" asp-action="Index" asp-route-search="@genre" class="d-inline-block text-uppercase fhp-text-body-80 fhp-bg-white-12 fhp-r-2 fhp-tracking-0-15em fhp-backdrop-blur-3px fhp-py-3 fhp-px-10 fhp-transition fhp-ease fhp-dur300 fhp-hover-bg-primary fhp-hover-text-white">
                                            @genre
                                        </a>
                                    }
                                </div>
                                <ul class="fhp-fs-13 fhp-md-fs-14 fw-bold fhp-text-body-70 d-flex align-items-center justify-content-center fhp-md-justify-start flex-wrap fhp-gap-11 fhp-mt-18 fhp-md-mt-20 text-uppercase fhp-tracking-0-1em">
                                    <li>
                                        @(slide.ReleaseDate?.ToString("yyyy") ?? slide.CreatedAt.ToString("yyyy"))
                                    </li>
                                    <li>
                                        <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
                                    </li>
                                    <li>
                                        @slide.Type
                                    </li>
                                    <li>
                                        <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
                                    </li>
                                    <li>
                                        <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@slide.CategoryId" class="d-inline-block fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                                            @(slide.Category?.Name ?? "Fandom")
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="position-absolute top-0 bottom-0 start-0 end-0 fhp-z-n1 fhp-bg-cover fhp-bg-center fhp-bg-norepeat" style="background-image: url(@Art(slide.ThumbnailUrl, posterArt, i));" data-jarallax='{"speed": 0.3}' data-swiper-parallax-scale="1.15" data-swiper-parallax-opacity="0.8"></div>
                    </div>
                </div>
            }
        </div>
    </div>
    @if (slides.Count > 1)
    {
        <div class="container fhp-px-2 fhp-md-px-12 fhp-xxl-px-30 fhp-xl-maxw-1920 position-relative">
            <div class="fhp-mt-25 fhp-md-mt-0 fhp-md-maxw-220 fhp-lg-maxw-340 fhp-xxl-maxw-440 fhp-md-mx-auto position-absolute fhp-md-bottom-100px fhp-lg-bottom-69px fhp-xxl-bottom-55px fhp-ltr-md:right-[12px] fhp-rtl-md:left-[12px] fhp-ltr-xl:right-[18px] fhp-rtl-xl:left-[18px] fhp-ltr-2xl:right-[35px] fhp-rtl-2xl:left-[35px]">
                <div thumbsSlider class="swiper bannerSwiperThumbs">
                    <div class="swiper-wrapper">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            var thumb = slides[i];
                            <div class="swiper-slide">
                                <div class="banner-thumb-item position-relative fhp-p-7 fhp-cursor-pointer">
                                    <img src="@Art(thumb.ThumbnailUrl, thumbArt, i)" class="fhp-r-5" alt="@thumb.Title">
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute top-0 fhp-ltr-start-0 fhp-rtl-end-0 fhp-h-1px fhp-w-20 fhp-lg-w-50 fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute fhp-top-1 fhp-ltr-start-0 fhp-rtl-end-0 fhp-h-19 fhp-lg-h-49 fhp-w-1px fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute top-0 fhp-ltr-end-0 fhp-rtl-start-0 fhp-h-1px fhp-w-20 fhp-lg-w-50 fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute fhp-top-1 fhp-ltr-end-0 fhp-rtl-start-0 fhp-h-19 fhp-lg-h-49 fhp-w-1px fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute bottom-0 fhp-ltr-start-0 fhp-rtl-end-0 fhp-h-1px fhp-w-20 fhp-lg-w-50 fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute fhp-bottom-1 fhp-ltr-start-0 fhp-rtl-end-0 fhp-h-19 fhp-lg-h-49 fhp-w-1px fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute bottom-0 fhp-ltr-end-0 fhp-rtl-start-0 fhp-h-1px fhp-w-20 fhp-lg-w-50 fhp-bg-white-27"></div>
                                    <div class="active fhp-transition fhp-ease fhp-dur300 position-absolute fhp-bottom-1 fhp-ltr-end-0 fhp-rtl-start-0 fhp-h-19 fhp-lg-h-49 fhp-w-1px fhp-bg-white-27"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ============================ TRENDING ============================ *@
@if (Model.Trending.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Trending Videos", Url.Action("Index", "Explore")!, "View More Videos")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-xl-gcol-6 fhp-gap-25" data-cues="slideInUp" data-group="1">
                @foreach (var item in Model.Trending.Take(6))
                {
                    var views = item.ViewCount >= 1000 ? (item.ViewCount / 1000d).ToString("0.#") + "K" : item.ViewCount.ToString();
                    <div class="fhp-group text-center">
                        <div class="position-relative fhp-r-5 fhp-mb-20 fhp-lg-mb-22">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="d-block overflow-hidden fhp-r-5">
                                <img src="@Art(item.ThumbnailUrl, movieArt, item.ContentId)" class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110" alt="@item.Title" loading="lazy">
                            </a>
                            <div class="@tileActions">
                                <a asp-controller="Bookmarks" asp-action="Index" class="@tileAction" title="Keep it in your list">
                                    <i class="ri-add-line"></i>
                                </a>
                                <button type="button" class="@tileAction" title="Copy a link to share">
                                    <i class="ri-share-line"></i>
                                </button>
                                <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="@tileAction" title="Open the title">
                                    <i class="ri-play-fill"></i>
                                </a>
                            </div>
                        </div>
                        <h3 class="fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1 fhp-mb-10">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                                @item.Title
                            </a>
                        </h3>
                        <ul class="fhp-fs-13 fhp-md-fs-14 fw-bold fhp-text-body-70 d-flex align-items-center justify-content-center flex-wrap fhp-gap-11 text-uppercase fhp-tracking-0-1em">
                            <li>
                                @views Views
                            </li>
                            <li>
                                <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
                            </li>
                            <li>
                                @item.Type
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ CATEGORIES ============================ *@
@if (Model.Categories.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Categories", Url.Action("Index", "Explore")!, "View All Categories")
            <div class="d-grid fhp-gcol-2 fhp-sm-gcol-3 fhp-lg-gcol-4 fhp-xl-gcol-7 fhp-gap-25" data-cues="slideInUp" data-group="3">
                @foreach (var category in Model.Categories.Take(7))
                {
                    <div class="fhp-group text-center fhp-r-5 fhp-bg-white-8 fhp-backdrop-blur-2px fhp-px-8 fhp-pt-8 fhp-transition fhp-dur300 fhp-ease fhp-hover-bg-white-10">
                        <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId" class="d-block overflow-hidden fhp-r-5">
                            <img src="@Art(category.IconUrl, categoryArt, category.CategoryId)" class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110" alt="@category.Name" loading="lazy">
                        </a>
                        <div class="fhp-py-15 fhp-md-py-20 fhp-px-2 fhp-md-px-7">
                            <h3 class="fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1 fhp-mb-8">
                                <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                                    @category.Name
                                </a>
                            </h3>
                            <span class="d-block fw-bold fhp-fs-13 fhp-md-fs-14 fhp-text-body-60 text-uppercase fhp-tracking-0-1em">
                                @category.ContentCount @(category.ContentCount == 1 ? "Title" : "Titles")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ TOP RATED ============================ *@
@if (Model.Trending.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Top Rated Movies", Url.Action("Index", "Explore", new { sort = "views" })!, "View All Titles")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-xl-gcol-5 fhp-gap-25" data-cues="slideInUp" data-group="2">
                @foreach (var item in Model.Trending.OrderByDescending(i => i.PopularityScore).ThenByDescending(i => i.ViewCount).Take(10))
                {
                    <partial name="_ContentCard" model="item" />
                }
            </div>
        </div>
    </div>
}

@* ============================ TRAILERS ============================ *@
@if (Model.Trailers.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Trailers & Clips", Url.Action("Index", "Explore")!, "Browse The Library")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-xl-gcol-6 fhp-gap-25" data-cues="slideInUp" data-group="1">
                @foreach (var trailer in Model.Trailers)
                {
                    var poster = string.IsNullOrWhiteSpace(trailer.Poster)
                        ? movieArt(trailer.Content.ContentId)
                        : trailer.Poster;
                    <div class="fhp-group text-center">
                        <div class="position-relative fhp-r-5 fhp-mb-20 fhp-lg-mb-22">
                            <a data-fhp-video data-kind="@trailer.Kind" data-src="@trailer.Url" data-poster="@poster"
                               data-title="@trailer.Content.Title — @trailer.Label"
                               href="@trailer.Url" class="d-block overflow-hidden fhp-r-5">
                                <img src="@poster" class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110" alt="@trailer.Content.Title" loading="lazy">
                            </a>
                            <div class="@tileActions">
                                <a asp-controller="Explore" asp-action="Details" asp-route-id="@trailer.Content.ContentId" class="@tileAction" title="Open the title page">
                                    <i class="ri-information-line"></i>
                                </a>
                                <button type="button" class="@tileAction fhp-share"
                                        data-share-url="@Url.Action("Details", "Explore", new { id = trailer.Content.ContentId })"
                                        data-share-title="@trailer.Content.Title on FanHubPlus"
                                        title="Copy a link to share">
                                    <i class="ri-share-line"></i>
                                </button>
                                <button type="button" class="@tileAction" title="Play the @trailer.Label"
                                        data-fhp-video data-kind="@trailer.Kind" data-src="@trailer.Url" data-poster="@poster"
                                        data-title="@trailer.Content.Title — @trailer.Label">
                                    <i class="ri-play-fill"></i>
                                </button>
                            </div>
                        </div>
                        <h3 class="fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1 fhp-mb-10">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@trailer.Content.ContentId" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                                @trailer.Content.Title
                            </a>
                        </h3>
                        <ul class="fhp-fs-13 fhp-md-fs-14 fw-bold fhp-text-body-70 d-flex align-items-center justify-content-center flex-wrap fhp-gap-11 text-uppercase fhp-tracking-0-1em">
                            <li>
                                @trailer.Label
                            </li>
                            <li>
                                <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
                            </li>
                            <li>
                                @trailer.Content.Type
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ MERCH ============================ *@
@if (Model.FeaturedMerch.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Fan Merchandise", Url.Action("Index", "Merch")!, "Visit The Shop")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-4 fhp-gap-25 fhp-xl-gap-35" data-cues="slideInUp" data-group="4">
                @foreach (var item in Model.FeaturedMerch)
                {
                    var product = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? $"/assets/images/products/product{(item.ItemId % 9) + 1}.jpg"
                        : item.ImageUrl;
                    <div class="fhp-group">
                        <div class="text-center position-relative fhp-mb-15 fhp-md-mb-20">
                            <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="d-block fhp-r-5 overflow-hidden">
                                <img src="@product" class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110" alt="@item.Name" loading="lazy">
                            </a>
                            <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="secondary-btn text-uppercase position-absolute top-50 start-50 fhp-ty-n50 fhp-tx-n50 opacity-0 invisible fhp-group-hover-opacity-100 fhp-group-hover-visible">
                                View Product
                            </a>
                        </div>
                        <div class="d-flex align-items-center justify-content-between fhp-mb-8 fhp-gap-10">
                            <h3 class="mb-0 fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1">
                                <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="fhp-transition fhp-ease fhp-dur300 fhp-hover-text-secondary">
                                    @item.Name
                                </a>
                            </h3>
                            <div class="d-inline-block position-relative fw-bold fhp-ltr-pl-[20px] fhp-rtl-pr-[20px] flex-shrink-0">
                                <i class="ri-eye-line fhp-text-ff962e position-absolute fhp-ltr-start-0 fhp-rtl-end-0 top-50 fhp-transform fhp-ty-n50"></i>(@item.ViewCount)
                            </div>
                        </div>
                        <span class="d-block fw-bold text-secondary">
                            @(item.IsUpcoming && item.ReleaseDate is not null
                                ? $"{item.Tag} · {item.ReleaseDate:dd MMM yyyy}"
                                : item.Tag.ToString())
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ EVENTS ============================ *@
@if (Model.UpcomingEvents.Count > 0)
{
    <div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("Upcoming Fan Events", Url.Action("Index", "Events")!, "Open The Event Map")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-gap-25 fhp-lg-gap-35" data-cues="slideInUp" data-group="3">
                @for (var i = 0; i < Model.UpcomingEvents.Count; i++)
                {
                    var ev = Model.UpcomingEvents[i];
                    <div class="fhp-group">
                        <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="overflow-hidden d-block fhp-r-5 fhp-mb-20 fhp-lg-mb-25">
                            <img src="@posterArt(i + 2)" class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110" alt="@ev.Title" loading="lazy">
                        </a>
                        <ul class="fhp-fs-13 fhp-md-fs-14 text-uppercase fw-bold d-flex align-items-center flex-wrap fhp-gap-13 fhp-mb-9 fhp-md-mb-11">
                            <li>
                                @ev.EventDate.ToString("dd MMM, yyyy")
                            </li>
                            <li>
                                <div class="fhp-w-1px fhp-bg-white-20 fhp-h-12"></div>
                            </li>
                            <li>
                                @ev.City
                            </li>
                        </ul>
                        <h3 class="fhp-fs-18 fhp-md-fs-20 fhp-lg-fs-24 fhp-leading-1-3 fhp-mb-10 fhp-md-mb-13">
                            <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                                @ev.Title
                            </a>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(ev.Story))
                        {
                            <p class="fhp-mb-15 fhp-md-mb-18">
                                @(ev.Story.Length > 120 ? ev.Story[..120] + "…" : ev.Story)
                            </p>
                        }
                        <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="text-primary fw-bold d-inline-block fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary">
                            Event Details
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ FEEDBACK ============================ *@
<div class="fhp-pb-60 fhp-md-pb-80 fhp-lg-pb-100 fhp-xl-pb-120 fhp-xxl-pb-140">
    <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
        <div class="fhp-mb-25 fhp-md-mb-35 fhp-lg-mb-45 fhp-xl-mb-55 d-flex align-items-center justify-content-center fhp-gap-13">
            <img src="/assets/images/icons/vector.svg" class="fhp-rtl--scale-x-100" alt="vector">
            <h2 class="mb-0 fhp-fs-22 fhp-md-fs-26 fhp-lg-fs-32 lh-1 fhp-text-animation">
                What Our Fans Are Saying
            </h2>
        </div>
        <div class="position-relative">
            <div class="mx-auto fhp-md-maxw-550 fhp-lg-maxw-680 fhp-xl-maxw-1300 position-relative fhp-z-1">
                <div class="swiper feedbackSwiper">
                    <div class="swiper-wrapper">
                        @for (var i = 0; i < feedback.Length; i++)
                        {
                            var row = feedback[i];
                            <div class="swiper-slide">
                                <div class="d-sm-flex align-items-start fhp-gap-20 fhp-md-gap-25 fhp-xl-gap-30 text-center fhp-ltr-sm:text-left fhp-rtl-sm:text-right">
                                    <div class="flex-shrink-0 fhp-bw-10 fhp-border-white-12 fhp-r-10 fhp-w-130 mx-auto">
                                        <img src="@userArt(i + 3)" class="fhp-r-4" alt="@row.Name" loading="lazy">
                                    </div>
                                    <div class="fhp-mt-12 fhp-sm-mt-0">
                                        <div class="d-flex align-items-center justify-content-center fhp-sm-justify-start fhp-text-ff962e fs-6 fhp-md-fs-18 fhp-gap-5 fhp-mb-6">
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                        </div>
                                        <span class="fhp-mb-15 fhp-md-mb-20 d-block text-uppercase fw-bold fhp-fs-13 fhp-md-fs-14 fhp-tracking-0-15em fhp-text-body-70">
                                            (<span class="text-secondary">@Model.TotalMembers.ToString("N0")</span> Members)
                                        </span>
                                        <p class="fhp-fs-18 fhp-md-fs-20 fhp-lg-fs-22 fw-bold text-white">
                                            &ldquo;@row.Quote&rdquo;
                                        </p>
                                        <h3 class="fs-6 lh-1 fhp-mt-25 fhp-md-mt-30 fhp-lg-mt-35 fhp-mb-8">
                                            &mdash; @row.Name
                                        </h3>
                                        <span class="d-block fhp-text-body-70 fw-bold fhp-fs-13 fhp-md-fs-14 text-uppercase fhp-tracking-0-1em">
                                            @row.Role
                                        </span>
                                    </div>
                                </div>
                                @if (i < feedback.Length - 1)
                                {
                                    <div class="position-absolute fhp-w-1px top-0 bottom-0 start-50 fhp-transform fhp-tx-n50 border-start fhp-border-dashed fhp-border-white-17 d-none fhp-xl-d-block"></div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-center fhp-gap-15 fhp-mt-25 fhp-md-mt-0">
                    <div class="feedback-button-prev swiper-button-prev fhp-md-absolute fhp-md-top-50 fhp-md-transform fhp-md-ty-n50 fhp-ltr-md-left-0 fhp-rtl-md-right-0 fhp-ltr-md-right-auto fhp-rtl-md-left-auto">
                        <i class="ri-arrow-left-line"></i>
                    </div>
                    <div class="feedback-button-next swiper-button-next fhp-md-absolute fhp-md-top-50 fhp-md-transform fhp-md-ty-n50 fhp-ltr-md-right-0 fhp-rtl-md-left-0 fhp-ltr-md-left-auto fhp-rtl-md-right-auto">
                        <i class="ri-arrow-right-line"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============================ BLOG ============================ *@
@if (Model.LatestArticles.Count > 0)
{
    <div class="fhp-pb-60 fhp-md-pb-80 fhp-lg-pb-100 fhp-xl-pb-120 fhp-xxl-pb-140">
        <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
            @Head("News & Editorials", Url.Action("Index", "Blog")!, "Read The Blog")
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-gap-25 fhp-lg-gap-35" data-cues="slideInUp" data-group="3">
                @foreach (var article in Model.LatestArticles)
                {
                    <partial name="_ArticleCard" model="article" />
                }
            </div>
        </div>
    </div>
}

