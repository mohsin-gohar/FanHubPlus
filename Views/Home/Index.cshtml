@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["fhpDark"] = true;

    // Decorative art is only used when an admin has not uploaded a cover,
    // so the page always looks composed instead of half-finished.
    var heroSlides = Model.Trending.Take(4).ToList();
    if (heroSlides.Count == 0)
    {
        heroSlides = Model.Categories.Select((c, i) => new Content
        {
            ContentId = i,
            Title = c.Name,
            CategoryId = c.CategoryId,
            Category = c,
            Description = c.Description,
        }).ToList();
    }
    Func<int, string> movieCover = i => $"/assets/images/movies/movie{(i % 24) + 1}.jpg";
    Func<int, string> bannerCover = i => $"/assets/images/banners/banner-bg{(i % 6) + 1}.jpg";
    Func<int, string> categoryCover = i => $"/assets/images/categories/category{(i % 7) + 1}.jpg";
    Func<int, string> userCover = i => $"/assets/images/users/user{(i % 8) + 1}.jpg";
    string Cover(string? url, Func<int, string> fallback, int index) =>
        string.IsNullOrWhiteSpace(url) ? fallback(index) : url;
    var testimonials = new[]
    {
        new { Name = "Ayesha Khan", Role = "Anime fan", Reviews = "199+", Quote = "Ratings, bookmarks and fan art in one place - finally a hub that understands how fandoms actually work." },
        new { Name = "Daniel Reyes", Role = "Convention regular", Reviews = "342+", Quote = "The events calendar never lets me down. I bookmark what I love and actually show up now." },
        new { Name = "Mei Tanaka", Role = "Cosplayer", Reviews = "212+", Quote = "Uploading my cosplay took seconds, and the feedback is what keeps me creating." },
    };
}

@* ============================ HERO ============================ *@
@if (heroSlides.Count > 0)
{
    <div class="px-[10px] pt-[10px] relative">
        <div class="swiper bannerSwiper rounded-[10px] border-[4px] md:border-[6px] border-white/15">
            <div class="swiper-wrapper">
                @for (var i = 0; i < heroSlides.Count; i++)
                {
                    var slide = heroSlides[i];
                    <div class="swiper-slide">
                        <div class="pt-[120px] md:pt-[150px] lg:pt-[190px] pb-[60px] md:pb-[80px] relative z-[1]">
                            <div class="absolute inset-0 -z-[1] bg-cover bg-center bg-no-repeat"
                                 style="background-image: url('@Cover(slide.ThumbnailUrl, bannerCover, i)');"></div>
                            <div class="container text-center">
                                <span class="inline-block bg-primary text-white text-13 font-bold uppercase tracking-[0.15em] px-[14px] py-[5px] rounded-[5px] mb-[20px]">
                                    @(slide.Category?.Name ?? "Featured")
                                </span>
                                <h1 class="uppercase font-secondary !font-extrabold text-4xl md:text-6xl lg:text-8xl leading-none mb-[15px] text_animation">
                                    @slide.Title
                                </h1>
                                @if (!string.IsNullOrWhiteSpace(slide.Description))
                                {
                                    <p class="text-body/80 max-w-[620px] mx-auto mb-[25px] text-lg">
                                        @(slide.Description.Length > 130 ? slide.Description[..130] + "…" : slide.Description)
                                    </p>
                                }
                                <div class="flex flex-wrap items-center justify-center gap-[15px]">
                                    <a asp-controller="Explore" asp-action="Details" asp-route-id="@slide.ContentId" class="primary-btn">
                                        <i class="ri-play-fill" aria-hidden="true"></i> Watch now
                                    </a>
                                    <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@slide.CategoryId" class="secondary-btn">
                                        Browse @slide.Category?.Name
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="container mt-[15px]">
            <div class="swiper bannerSwiperThumbs">
                <div class="swiper-wrapper">
                    @for (var i = 0; i < heroSlides.Count; i++)
                    {
                        var slide = heroSlides[i];
                        <div class="swiper-slide">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@slide.ContentId" class="block">
                                <img src="@Cover(slide.ThumbnailUrl, movieCover, i)" class="w-full h-[90px] md:h-[120px] object-cover rounded-[5px]" alt="@slide.Title" loading="lazy" decoding="async" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
@* ============================ LIVE SHOWS ============================ *@
@if (Model.UpcomingEvents.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Live shows &amp; events</h2>
                </div>
                <a class="fhp-more" asp-controller="Events" asp-action="Index">See the full calendar</a>
            </div>
            <div class="swiper liveShowsSwiper">
                <div class="swiper-wrapper">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="swiper-slide">
                            <a class="fhp-event" asp-controller="Events" asp-action="Index">
                                <span class="fhp-event__date">@ev.EventDate.ToString("dd MMM")</span>
                                <span class="fhp-event__name">@ev.Title</span>
                                <span class="fhp-event__meta">@(string.IsNullOrWhiteSpace(ev.City) ? "Online" : ev.City)</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@* ============================ MARQUEE ============================ *@
<div class="fhp-marquee" aria-hidden="true">
    <div class="marquee font-secondary font-bold whitespace-nowrap leading-none uppercase text-white/20 text-6xl md:text-7xl lg:text-8xl">
        @for (var i = 0; i < 4; i++)
        {
            <text>Ratings * Bookmarks * Events * Fan art * News *&nbsp;</text>
        }
    </div>
</div>

@* ============================ TRENDING ============================ *@
@if (Model.Trending.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Trending in the fandom</h2>
                </div>
                <a class="fhp-more" asp-controller="Explore" asp-action="Index" asp-route-sort="popular">View more content</a>
            </div>
            <div class="fhp-grid fhp-grid--3">
                @foreach (var item in Model.Trending.Take(6))
                {
                    <partial name="_ContentCard" model="item" />
                }
            </div>
        </div>
    </section>
}

@* ============================ TRAILERS (play inside the site) ============================ *@
@if (Model.Trailers.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Trailers &amp; videos</h2>
                </div>
                <a class="fhp-more" asp-controller="Explore" asp-action="Index">Browse the library</a>
            </div>
            <p class="fhp-hint">Press play and the video runs right here &mdash; nothing opens in another site.</p>
            <div class="fhp-grid fhp-grid--3 fhp-mt-25">
                @foreach (var trailer in Model.Trailers)
                {
                    <partial name="_TrailerCard" model="trailer" />
                }
            </div>
        </div>
    </section>
}

@* ============================ VIDEO SHOWCASE ============================ *@
<section class="fhp-showcase"
         style="background-image: url('/assets/images/bg-images/bg-image1.jpg');"
         data-jarallax='{"speed": 0.3}'>
    <div class="container">
        <button type="button" class="fhp-showcase__play" data-fhp-video data-cue="slideInDown"
                data-kind="local" data-src="/assets/videos/movie.mp4"
                data-poster="/assets/images/videos/video7.jpg"
                data-title="FanHubPlus showreel"
                aria-label="Play the FanHubPlus showreel">
            <i class="ri-play-fill" aria-hidden="true"></i>
        </button>
        <div class="fhp-grid fhp-grid--3 fhp-mt-45">
            <a class="fhp-showcase__thumb" asp-controller="FanArt" asp-action="Index">
                <img src="/assets/images/videos/video7.jpg" alt="Fan art gallery" loading="lazy" decoding="async" />
                <span>Fan art</span>
            </a>
            <a class="fhp-showcase__thumb" asp-controller="Events" asp-action="Index">
                <img src="/assets/images/videos/video8.jpg" alt="Convention calendar" loading="lazy" decoding="async" />
                <span>Events</span>
            </a>
            <a class="fhp-showcase__thumb" asp-controller="Merch" asp-action="Index">
                <img src="/assets/images/videos/video9.jpg" alt="Merchandise showcase" loading="lazy" decoding="async" />
                <span>Merch</span>
            </a>
        </div>
    </div>
</section>
@* ============================ CATEGORIES ============================ *@
@if (Model.Categories.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Browse by fandom</h2>
                </div>
                <a class="fhp-more" asp-controller="Explore" asp-action="Index">View all categories</a>
            </div>
            <div class="fhp-grid fhp-grid--4">
                @for (var i = 0; i < Model.Categories.Count; i++)
                {
                    var cat = Model.Categories[i];
                    <a class="fhp-cat" asp-controller="Explore" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                        <img src="@Cover(cat.IconUrl, categoryCover, i)" alt="@cat.Name" loading="lazy" decoding="async" />
                        <span class="fhp-cat__body">
                            <span class="fhp-cat__name">@cat.Name</span>
                            <span class="fhp-cat__meta">Explore titles</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ============================ TESTIMONIALS ============================ *@
<section class="fhp-section--tight">
    <div class="container">
        <div class="fhp-section-head fhp-section-head--center">
            <div class="fhp-section-head__title">
                <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                <h2 class="text_animation">What fans are saying</h2>
            </div>
        </div>
        <div class="fhp-testimonial">
            <div class="swiper feedbackSwiper">
                <div class="swiper-wrapper">
                    @for (var i = 0; i < testimonials.Length; i++)
                    {
                        var t = testimonials[i];
                        <div class="swiper-slide">
                            <blockquote class="fhp-testimonial__card">
                                <div class="fhp-testimonial__avatar">
                                    <img src="@userCover(i)" alt="@t.Name" loading="lazy" decoding="async" />
                                </div>
                                <div class="fhp-stars" aria-label="Five star review">
                                    @for (var s = 0; s < 5; s++)
                                    {
                                        <i class="ri-star-fill" aria-hidden="true"></i>
                                    }
                                    <span class="fhp-stars__count">(@t.Reviews reviews)</span>
                                </div>
                                <p>&ldquo;@t.Quote&rdquo;</p>
                                <footer>
                                    <span class="fhp-testimonial__name">@t.Name</span>
                                    <span class="fhp-testimonial__role">@t.Role</span>
                                </footer>
                            </blockquote>
                        </div>
                    }
                </div>
            </div>
            <div class="fhp-slider-nav">
                <button type="button" class="feedback-button-prev" aria-label="Previous review"><i class="ri-arrow-left-line" aria-hidden="true"></i></button>
                <button type="button" class="feedback-button-next" aria-label="Next review"><i class="ri-arrow-right-line" aria-hidden="true"></i></button>
            </div>
        </div>
    </div>
</section>
@* ============================ TOP RATED ============================ *@
@if (Model.Trending.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Most watched this week</h2>
                </div>
                <a class="fhp-more" asp-controller="Explore" asp-action="Index" asp-route-sort="views">All popular titles</a>
            </div>
            <div class="fhp-grid fhp-grid--4">
                @foreach (var item in Model.Trending.OrderByDescending(i => i.ViewCount).Take(4))
                {
                    <partial name="_ContentCard" model="item" />
                }
            </div>
        </div>
    </section>
}

@* ============================ MERCH ============================ *@
@if (Model.FeaturedMerch.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <div class="fhp-section-head">
                <div class="fhp-section-head__title">
                    <img src="/assets/images/icons/vector.svg" alt="" aria-hidden="true" />
                    <h2 class="text_animation">Featured merchandise</h2>
                </div>
                <a class="fhp-more" asp-controller="Merch" asp-action="Index">View all merch</a>
            </div>
            <div class="fhp-grid fhp-grid--4">
                @foreach (var item in Model.FeaturedMerch.Take(4))
                {
                    <partial name="_MerchCard" model="item" />
                }
            </div>
        </div>
    </section>
}

<div class="fhp-marquee" aria-hidden="true">
    <div class="marquee font-secondary font-bold whitespace-nowrap leading-none uppercase text-white/20 text-6xl md:text-7xl lg:text-8xl">
        @for (var i = 0; i < 4; i++)
        {
            <text>Behind the scenes * New titles every week *&nbsp;</text>
        }
    </div>
</div>

<partial name="_JoinNow" />

@* ============================ LATEST STORIES ============================ *@
@if (Model.LatestArticles.Count > 0)
{
    <section class="fhp-section--tight">
        <div class="container">
            <h2 class="fhp-section-title fhp-mt-20">Fresh from the editorial desk</h2>
            <div class="fhp-grid fhp-grid--3">
                @foreach (var article in Model.LatestArticles.Take(3))
                {
                    <partial name="_ArticleCard" model="article" />
                }
            </div>
            <div class="fhp-center fhp-mt-25">
                <a class="fhp-btn fhp-btn--ghost fhp-btn--light" asp-controller="News" asp-action="Index">All news &amp; timeline</a>
            </div>
        </div>
    </section>
}