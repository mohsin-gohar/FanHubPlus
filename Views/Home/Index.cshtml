@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["fhpDark"] = true;   // the landing page keeps the template's dark bed

    var slides = Model.Trending.Take(4).ToList();
    if (slides.Count == 0)
    {
        slides = Model.Categories.Take(4).Select((c, i) => new Content
        {
            ContentId = i,
            Title = c.Name,
            CategoryId = c.CategoryId,
            Category = new Category { CategoryId = c.CategoryId, Name = c.Name, IconUrl = c.IconUrl, Description = c.Description },
            Description = c.Description,
        }).ToList();
    }

    Func<int, string> posterArt = i => $"/assets/images/banners/banner-bg{(i % 6) + 1}.jpg";
    Func<int, string> thumbArt = i => $"/assets/images/banners/banner-thumb{(i % 4) + 1}.jpg";
    Func<int, string> movieArt = i => $"/assets/images/movies/movie{(i % 24) + 1}.jpg";
    Func<int, string> categoryArt = i => $"/assets/images/categories/category{(i % 7) + 1}.jpg";
    Func<int, string> userArt = i => $"/assets/images/users/user{(i % 8) + 1}.jpg";
    string Art(string? url, Func<int, string> fallback, int i) => string.IsNullOrWhiteSpace(url) ? fallback(i) : url;

    // The template's section head: vector mark + title on the left, the
    // underlined "View More" link on the right.
    Func<string, string, string, Microsoft.AspNetCore.Html.IHtmlContent> Head = (title, href, linkText) => new Microsoft.AspNetCore.Html.HtmlString(
        "<div class=\"mb-[25px] md:mb-[35px] lg:mb-[45px] md:flex items-center justify-between gap-[25px]\">" +
        "  <div class=\"flex items-center gap-[13px]\">" +
        "    <img src=\"/assets/images/icons/vector.svg\" class=\"rtl:-scale-x-100\" alt=\"vector\">" +
        "    <h2 class=\"mb-0 text-[22px] md:text-[26px] lg:text-[32px] leading-none text_animation\">" + title + "</h2>" +
        "  </div>" +
        "  <a href=\"" + href + "\" class=\"flex-none mt-[15px] md:mt-0 leading-none inline-block relative font-bold text-secondary transition-all duration-300 ease-in-out hover:text-primary before:absolute before:bottom-0 before:left-0 before:right-0 before:h-px before:bg-secondary before:transition-all before:duration-300 before:ease-in-out hover:before:bg-primary hover:before:scale-x-0\">" + linkText + "</a>" +
        "</div>");

    // Hover action row the template floats over a tile or a video cover.
    const string tileActions = "flex items-center justify-center flex-wrap gap-[5px] absolute bottom-[10px] left-1/2 transform -translate-x-1/2 transition-all duration-300 ease-in-out opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:bottom-[20px]";
    const string tileAction = "flex items-center justify-center text-white bg-white/30 rounded-full w-[30px] h-[30px] transition-all duration-300 ease-in-out hover:bg-primary hover:text-white";

    var feedback = new (string Quote, string Name, string Role)[]
    {
        ("Ratings, bookmarks and fan art in one place - finally a hub that understands how fandoms actually work.", "Ayesha Khan", "Anime fan"),
        ("The events board never lets me down. I bookmark what I love and I actually show up now.", "Daniel Reyes", "Convention regular"),
        ("Uploading my cosplay took seconds, and the feedback is what keeps me creating.", "Mei Tanaka", "Cosplayer"),
    };
}

<!-- Banner -->
<div class="px-[10px] pt-[10px] relative">
    <div class="swiper bannerSwiper rounded-[10px] border-[4px] md:border-[6px] border-white/15">
        <div class="swiper-wrapper">
            @for (var i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                var genres = (slide.Genre ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Take(4)
                    .ToList();
                <div class="swiper-slide">
                    <div class="pt-[130px] md:pt-[160px] lg:pt-[180px] xl:pt-[280px] 2xl:pt-[340px] pb-[60px] md:pb-[80px] lg:pb-[65px] relative z-[1]">
                        <div class="container 2xl:!px-[30px] xl:!max-w-[1920px]">
                            <div class="text-center mx-auto">
                                <h1 class="uppercase font-secondary !font-extrabold text-4xl md:text-6xl lg:text-8xl xl:text-9xl 2xl:text-[150px] leading-none lg:-tracking-[0.05em] mb-[15px] text_animation" data-swiper-parallax="-400" data-swiper-parallax-opacity="0.2" data-swiper-parallax-scale="0.9">
                                    @slide.Title
                                </h1>
                                <div class="flex items-center justify-center flex-wrap gap-[15px] md:gap-[20px] mt-[25px] md:mt-[30px]" data-swiper-parallax-y="-120" data-swiper-parallax-opacity="0.6">
                                    <a asp-controller="Explore" asp-action="Details" asp-route-id="@slide.ContentId" class="primary-btn">
                                        <span>
                                            <i class="ri-play-fill"></i>
                                            Start Watching
                                        </span>
                                    </a>
                                    <a asp-controller="Explore" asp-action="Index" class="primary-btn with-border">
                                        Explore Everything
                                    </a>
                                </div>
                            </div>
                            <div class="mt-[20px] md:mt-[80px] lg:mt-[65px] text-center ltr:md:text-left rtl:md:text-right" data-swiper-parallax="200" data-swiper-parallax-opacity="0" data-swiper-parallax-scale="1.05">
                                <div class="flex items-center justify-center md:justify-start text-[#ff962e] text-base md:text-lg gap-[5px]">
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <i class="ri-star-fill"></i>
                                    <span class="block uppercase font-bold text-13 md:text-sm tracking-[0.15em] text-body/70 ltr:ml-[5px] rtl:mr-[5px]">
                                        (<span class="text-secondary">@Model.TotalContents.ToString("N0")</span> Titles)
                                    </span>
                                </div>
                                <div class="flex items-center justify-center md:justify-start flex-wrap gap-[10px] mt-[17px] text-xs md:text-13 font-bold">
                                    @foreach (var genre in genres)
                                    {
                                        <a asp-controller="Explore" asp-action="Index" asp-route-search="@genre" class="inline-block uppercase text-body/80 bg-white/12 rounded-[2px] tracking-[0.15em] backdrop-blur-[3px] py-[3px] px-[10px] transition-all ease-in-out duration-300 hover:bg-primary hover:text-white">
                                            @genre
                                        </a>
                                    }
                                </div>
                                <ul class="text-13 md:text-sm font-bold text-body/70 flex items-center justify-center md:justify-start flex-wrap gap-[11px] mt-[18px] md:mt-[20px] uppercase tracking-[0.1em]">
                                    <li>
                                        @(slide.ReleaseDate?.ToString("yyyy") ?? slide.CreatedAt.ToString("yyyy"))
                                    </li>
                                    <li>
                                        <div class="w-px bg-white/15 h-[12px]"></div>
                                    </li>
                                    <li>
                                        @slide.Type
                                    </li>
                                    <li>
                                        <div class="w-px bg-white/15 h-[12px]"></div>
                                    </li>
                                    <li>
                                        <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@slide.CategoryId" class="inline-block transition-all duration-300 ease-in-out hover:text-secondary">
                                            @(slide.Category?.Name ?? "Fandom")
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="absolute inset-0 -z-[1] bg-cover bg-center bg-no-repeat" style="background-image: url(@Art(slide.ThumbnailUrl, posterArt, i));" data-jarallax='{"speed": 0.3}' data-swiper-parallax-scale="1.15" data-swiper-parallax-opacity="0.8"></div>
                    </div>
                </div>
            }
        </div>
    </div>
    @if (slides.Count > 1)
    {
        <div class="container !px-[2px] md:!px-[12px] 2xl:!px-[30px] xl:!max-w-[1920px] relative">
            <div class="mt-[25px] md:mt-0 md:max-w-[220px] lg:max-w-[340px] 2xl:max-w-[440px] md:mx-auto md:absolute md:bottom-[100px] lg:bottom-[69px] 2xl:bottom-[55px] ltr:md:right-[12px] rtl:md:left-[12px] ltr:xl:right-[18px] rtl:xl:left-[18px] ltr:2xl:right-[35px] rtl:2xl:left-[35px]">
                <div thumbsSlider class="swiper bannerSwiperThumbs">
                    <div class="swiper-wrapper">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            var thumb = slides[i];
                            <div class="swiper-slide">
                                <div class="banner-thumb-item relative p-[7px] cursor-pointer">
                                    <img src="@Art(thumb.ThumbnailUrl, thumbArt, i)" class="rounded-[5px]" alt="@thumb.Title">
                                    <div class="active transition-all ease-in-out duration-300 absolute top-0 ltr:left-0 rtl:right-0 h-px w-[20px] lg:w-[50px] bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute top-px ltr:left-0 rtl:right-0 h-[19px] lg:h-[49px] w-px bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute top-0 ltr:right-0 rtl:left-0 h-px w-[20px] lg:w-[50px] bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute top-px ltr:right-0 rtl:left-0 h-[19px] lg:h-[49px] w-px bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute bottom-0 ltr:left-0 rtl:right-0 h-px w-[20px] lg:w-[50px] bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute bottom-px ltr:left-0 rtl:right-0 h-[19px] lg:h-[49px] w-px bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute bottom-0 ltr:right-0 rtl:left-0 h-px w-[20px] lg:w-[50px] bg-white/27"></div>
                                    <div class="active transition-all ease-in-out duration-300 absolute bottom-px ltr:right-0 rtl:left-0 h-[19px] lg:h-[49px] w-px bg-white/27"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ============================ TRENDING ============================ *@
@if (Model.Trending.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Trending Videos", Url.Action("Index", "Explore")!, "View More Videos")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-[25px]" data-cues="slideInUp" data-group="1">
                @foreach (var item in Model.Trending.Take(6))
                {
                    var views = item.ViewCount >= 1000 ? (item.ViewCount / 1000d).ToString("0.#") + "K" : item.ViewCount.ToString();
                    <div class="group text-center">
                        <div class="relative rounded-[5px] mb-[20px] lg:mb-[22px]">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="block overflow-hidden rounded-[5px]">
                                <img src="@Art(item.ThumbnailUrl, movieArt, item.ContentId)" class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110" alt="@item.Title" loading="lazy">
                            </a>
                            <div class="@tileActions">
                                <a asp-controller="Bookmarks" asp-action="Index" class="@tileAction" title="Keep it in your list">
                                    <i class="ri-add-line"></i>
                                </a>
                                <button type="button" class="@tileAction" title="Copy a link to share">
                                    <i class="ri-share-line"></i>
                                </button>
                                <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="@tileAction" title="Open the title">
                                    <i class="ri-play-fill"></i>
                                </a>
                            </div>
                        </div>
                        <h3 class="text-base md:text-lg lg:text-xl leading-none mb-[10px]">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@item.ContentId" class="transition-all duration-300 ease-in-out hover:text-secondary">
                                @item.Title
                            </a>
                        </h3>
                        <ul class="text-13 md:text-sm font-bold text-body/70 flex items-center justify-center flex-wrap gap-[11px] uppercase tracking-[0.1em]">
                            <li>
                                @views Views
                            </li>
                            <li>
                                <div class="w-px bg-white/15 h-[12px]"></div>
                            </li>
                            <li>
                                @item.Type
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ CATEGORIES ============================ *@
@if (Model.Categories.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Categories", Url.Action("Index", "Explore")!, "View All Categories")
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-[25px]" data-cues="slideInUp" data-group="3">
                @foreach (var category in Model.Categories.Take(7))
                {
                    <div class="group text-center rounded-[5px] bg-white/8 backdrop-blur-[2px] px-[8px] pt-[8px] transition-all duration-300 ease-in-out hover:bg-white/10">
                        <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId" class="block overflow-hidden rounded-[5px]">
                            <img src="@Art(category.IconUrl, categoryArt, category.CategoryId)" class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110" alt="@category.Name" loading="lazy">
                        </a>
                        <div class="py-[15px] md:py-[20px] px-[2px] md:px-[7px]">
                            <h3 class="text-base md:text-lg lg:text-xl leading-none mb-[8px]">
                                <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId" class="transition-all duration-300 ease-in-out hover:text-secondary">
                                    @category.Name
                                </a>
                            </h3>
                            <span class="block font-bold text-13 md:text-sm text-body/60 uppercase tracking-[0.1em]">
                                @category.ContentCount @(category.ContentCount == 1 ? "Title" : "Titles")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ TOP RATED ============================ *@
@if (Model.Trending.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Top Rated Movies", Url.Action("Index", "Explore", new { sort = "views" })!, "View All Titles")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-[25px]" data-cues="slideInUp" data-group="2">
                @foreach (var item in Model.Trending.OrderByDescending(i => i.PopularityScore).ThenByDescending(i => i.ViewCount).Take(10))
                {
                    <partial name="_ContentCard" model="item" />
                }
            </div>
        </div>
    </div>
}

@* ============================ TRAILERS ============================ *@
@if (Model.Trailers.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Trailers & Clips", Url.Action("Index", "Explore")!, "Browse The Library")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-[25px]" data-cues="slideInUp" data-group="1">
                @foreach (var trailer in Model.Trailers)
                {
                    var poster = string.IsNullOrWhiteSpace(trailer.Poster)
                        ? movieArt(trailer.Content.ContentId)
                        : trailer.Poster;
                    <div class="group text-center">
                        <div class="relative rounded-[5px] mb-[20px] lg:mb-[22px]">
                            <a data-fhp-video data-kind="@trailer.Kind" data-src="@trailer.Url" data-poster="@poster"
                               data-title="@trailer.Content.Title — @trailer.Label"
                               href="@trailer.Url" class="block overflow-hidden rounded-[5px]">
                                <img src="@poster" class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110" alt="@trailer.Content.Title" loading="lazy">
                            </a>
                            <div class="@tileActions">
                                <a asp-controller="Explore" asp-action="Details" asp-route-id="@trailer.Content.ContentId" class="@tileAction" title="Open the title page">
                                    <i class="ri-information-line"></i>
                                </a>
                                <button type="button" class="@tileAction fhp-share"
                                        data-share-url="@Url.Action("Details", "Explore", new { id = trailer.Content.ContentId })"
                                        data-share-title="@trailer.Content.Title on FanHubPlus"
                                        title="Copy a link to share">
                                    <i class="ri-share-line"></i>
                                </button>
                                <button type="button" class="@tileAction" title="Play the @trailer.Label"
                                        data-fhp-video data-kind="@trailer.Kind" data-src="@trailer.Url" data-poster="@poster"
                                        data-title="@trailer.Content.Title — @trailer.Label">
                                    <i class="ri-play-fill"></i>
                                </button>
                            </div>
                        </div>
                        <h3 class="text-base md:text-lg lg:text-xl leading-none mb-[10px]">
                            <a asp-controller="Explore" asp-action="Details" asp-route-id="@trailer.Content.ContentId" class="transition-all duration-300 ease-in-out hover:text-secondary">
                                @trailer.Content.Title
                            </a>
                        </h3>
                        <ul class="text-13 md:text-sm font-bold text-body/70 flex items-center justify-center flex-wrap gap-[11px] uppercase tracking-[0.1em]">
                            <li>
                                @trailer.Label
                            </li>
                            <li>
                                <div class="w-px bg-white/15 h-[12px]"></div>
                            </li>
                            <li>
                                @trailer.Content.Type
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ MERCH ============================ *@
@if (Model.FeaturedMerch.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Fan Merchandise", Url.Action("Index", "Merch")!, "Visit The Shop")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[25px] xl:gap-[35px]" data-cues="slideInUp" data-group="4">
                @foreach (var item in Model.FeaturedMerch)
                {
                    var product = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? $"/assets/images/products/product{(item.ItemId % 9) + 1}.jpg"
                        : item.ImageUrl;
                    <div class="group">
                        <div class="text-center relative mb-[15px] md:mb-[20px]">
                            <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="block rounded-[5px] overflow-hidden">
                                <img src="@product" class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110" alt="@item.Name" loading="lazy">
                            </a>
                            <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="secondary-btn uppercase absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 opacity-0 invisible group-hover:opacity-100 group-hover:visible">
                                View Product
                            </a>
                        </div>
                        <div class="flex items-center justify-between mb-[8px] gap-[10px]">
                            <h3 class="mb-0 text-base md:text-lg lg:text-xl leading-none">
                                <a asp-controller="Merch" asp-action="Details" asp-route-id="@item.ItemId" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                    @item.Name
                                </a>
                            </h3>
                            <div class="inline-block relative font-bold ltr:pl-[20px] rtl:pr-[20px] flex-none">
                                <i class="ri-eye-line text-[#FF962E] absolute ltr:left-0 rtl:right-0 top-1/2 transform -translate-y-1/2"></i>(@item.ViewCount)
                            </div>
                        </div>
                        <span class="block font-bold text-secondary">
                            @(item.IsUpcoming && item.ReleaseDate is not null
                                ? $"{item.Tag} · {item.ReleaseDate:dd MMM yyyy}"
                                : item.Tag.ToString())
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ EVENTS ============================ *@
@if (Model.UpcomingEvents.Count > 0)
{
    <div class="py-[60px] md:py-[80px] lg:py-[100px] xl:py-[120px] 2xl:py-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("Upcoming Fan Events", Url.Action("Index", "Events")!, "Open The Event Map")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[25px] lg:gap-[35px]" data-cues="slideInUp" data-group="3">
                @for (var i = 0; i < Model.UpcomingEvents.Count; i++)
                {
                    var ev = Model.UpcomingEvents[i];
                    <div class="group">
                        <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="overflow-hidden block rounded-[5px] mb-[20px] lg:mb-[25px]">
                            <img src="@posterArt(i + 2)" class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110" alt="@ev.Title" loading="lazy">
                        </a>
                        <ul class="text-13 md:text-sm uppercase font-bold flex items-center flex-wrap gap-[13px] mb-[9px] md:mb-[11px]">
                            <li>
                                @ev.EventDate.ToString("dd MMM, yyyy")
                            </li>
                            <li>
                                <div class="w-px bg-white/20 h-[12px]"></div>
                            </li>
                            <li>
                                @ev.City
                            </li>
                        </ul>
                        <h3 class="text-lg md:text-xl lg:text-2xl leading-[1.3] mb-[10px] md:mb-[13px]">
                            <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="transition-all duration-300 ease-in-out hover:text-secondary">
                                @ev.Title
                            </a>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(ev.Story))
                        {
                            <p class="mb-[15px] md:mb-[18px]">
                                @(ev.Story.Length > 120 ? ev.Story[..120] + "…" : ev.Story)
                            </p>
                        }
                        <a asp-controller="Events" asp-action="Index" asp-fragment="@ev.EventId" class="text-primary font-bold inline-block transition-all duration-300 ease-in-out hover:text-secondary">
                            Event Details
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================ FEEDBACK ============================ *@
<div class="pb-[60px] md:pb-[80px] lg:pb-[100px] xl:pb-[120px] 2xl:pb-[140px]">
    <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
        <div class="mb-[25px] md:mb-[35px] lg:mb-[45px] xl:mb-[55px] flex items-center justify-center gap-[13px]">
            <img src="/assets/images/icons/vector.svg" class="rtl:-scale-x-100" alt="vector">
            <h2 class="mb-0 text-[22px] md:text-[26px] lg:text-[32px] leading-none text_animation">
                What Our Fans Are Saying
            </h2>
        </div>
        <div class="relative">
            <div class="mx-auto md:max-w-[550px] lg:max-w-[680px] xl:max-w-[1300px] relative z-[1]">
                <div class="swiper feedbackSwiper">
                    <div class="swiper-wrapper">
                        @for (var i = 0; i < feedback.Length; i++)
                        {
                            var row = feedback[i];
                            <div class="swiper-slide">
                                <div class="sm:flex items-start gap-[20px] md:gap-[25px] xl:gap-[30px] text-center ltr:sm:text-left rtl:sm:text-right">
                                    <div class="flex-none border-[10px] border-white/12 rounded-[10px] w-[130px] mx-auto">
                                        <img src="@userArt(i + 3)" class="rounded-[4px]" alt="@row.Name" loading="lazy">
                                    </div>
                                    <div class="mt-[12px] sm:mt-0">
                                        <div class="flex items-center justify-center sm:justify-start text-[#ff962e] text-base md:text-lg gap-[5px] mb-[6px]">
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                            <i class="ri-star-fill"></i>
                                        </div>
                                        <span class="mb-[15px] md:mb-[20px] block uppercase font-bold text-13 md:text-sm tracking-[0.15em] text-body/70">
                                            (<span class="text-secondary">@Model.TotalMembers.ToString("N0")</span> Members)
                                        </span>
                                        <p class="text-lg md:text-xl lg:text-[22px] font-bold text-white">
                                            &ldquo;@row.Quote&rdquo;
                                        </p>
                                        <h3 class="text-base leading-none mt-[25px] md:mt-[30px] lg:mt-[35px] mb-[8px]">
                                            &mdash; @row.Name
                                        </h3>
                                        <span class="block text-body/70 font-bold text-13 md:text-sm uppercase tracking-[0.1em]">
                                            @row.Role
                                        </span>
                                    </div>
                                </div>
                                @if (i < feedback.Length - 1)
                                {
                                    <div class="absolute w-px top-0 bottom-0 left-1/2 transform -translate-x-1/2 border-l border-dashed border-white/17 hidden xl:block"></div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="flex items-center justify-center gap-[15px] mt-[25px] md:mt-0">
                    <div class="feedback-button-prev swiper-button-prev md:!absolute md:!top-1/2 md:!transform md:!-translate-y-1/2 ltr:md:!left-0 rtl:md:!right-0 ltr:md:!right-auto rtl:md:!left-auto">
                        <i class="ri-arrow-left-line"></i>
                    </div>
                    <div class="feedback-button-next swiper-button-next md:!absolute md:!top-1/2 md:!transform md:!-translate-y-1/2 ltr:md:!right-0 rtl:md:!left-0 ltr:md:!left-auto rtl:md:!right-auto">
                        <i class="ri-arrow-right-line"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============================ BLOG ============================ *@
@if (Model.LatestArticles.Count > 0)
{
    <div class="pb-[60px] md:pb-[80px] lg:pb-[100px] xl:pb-[120px] 2xl:pb-[140px]">
        <div class="container 2xl:!px-[100px] xl:!max-w-[1920px]">
            @Head("News & Editorials", Url.Action("Index", "Blog")!, "Read The Blog")
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[25px] lg:gap-[35px]" data-cues="slideInUp" data-group="3">
                @foreach (var article in Model.LatestArticles)
                {
                    <partial name="_ArticleCard" model="article" />
                }
            </div>
        </div>
    </div>
}

<partial name="_JoinNow" />






