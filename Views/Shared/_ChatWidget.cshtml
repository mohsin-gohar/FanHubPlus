@* Floating FanBot launcher - present on every page, talks to /Chatbot/Ask.
   Ids and class names are the contract with site.js; the look comes from
   css/fanhubplus-app.css (the template ships no chat widget). *@
<div id="chatWidget" class="chat-widget d-none">
    <div class="chat-header">
        <span>FanBot</span>
        <button type="button" class="chat-close" id="chatClose" aria-label="Close chat">&times;</button>
    </div>
    <div class="chat-body" id="chatBody">
        <div class="chat-msg bot">Hi! I'm FanBot. Ask me about fandoms, characters, events, ratings or how the portal works.</div>
    </div>
    <div class="chat-suggestions" id="chatSuggestions"></div>
    <form class="chat-input" id="chatForm">
        @Html.AntiForgeryToken()
        <label class="sr-only" for="chatText">Your question</label>
        <input type="text" id="chatText" maxlength="1000" placeholder="Type your question..." autocomplete="off" required />
        <button type="submit" id="chatSend">Send</button>
    </form>
</div>

<button type="button" id="chatToggle" class="chat-fab" aria-label="Open the FanBot chat" title="Chat with FanBot">
    <i class="ri-chat-3-line" aria-hidden="true"></i>
</button>
