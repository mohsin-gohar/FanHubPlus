@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var code = ViewBag.StatusCode as int?;
    var heading = code switch
    {
        404 => "This page slipped out of the timeline",
        403 => "That corner is staff only",
        500 => "Something broke on our side",
        null => "Something went sideways",
        _ => $"Error {code}",
    };
    var copy = code == 404
        ? "The address you followed does not lead anywhere. It may have been renamed, or the link may be from an older season."
        : "We could not finish that request. Try again in a moment, or head back to a page that works.";
}

<section class="fhp-section">
    <div class="container">
        <div class="fhp-empty">
            <p class="fhp-code">@(code?.ToString() ?? "!!")</p>
            <h1 class="fhp-empty__title">@heading</h1>
            <p>@copy</p>

            @if (Model.ShowRequestId)
            {
                <p class="fhp-hint">Request ID: <code>@Model.RequestId</code></p>
            }

            <div class="fhp-action-bar fhp-center fhp-mt-25">
                <a asp-controller="Home" asp-action="Index" class="fhp-btn fhp-btn--primary">Back to home</a>
                <a asp-controller="Explore" asp-action="Index" class="fhp-btn fhp-btn--ghost">Explore the library</a>
            </div>
        </div>
    </div>
</section>