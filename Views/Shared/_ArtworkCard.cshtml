@* Fan-art tile in the template's video-card shape: the artwork opens in the
   FSLightbox viewer the layout already loads (data-fslightbox), so the gallery
   needs no extra script. The author rides along in the hover action row.
   Usage: <partial name="_ArtworkCard" model="submission" /> *@
@model FanHubPlus.Models.Entities.FanSubmission
@{
    var art = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? $"/assets/images/releases/release{(Model.SubmissionId % 6) + 1}.jpg"
        : Model.ImageUrl;
    var author = string.IsNullOrWhiteSpace(Model.User?.Name) ? "Former member" : Model.User!.Name;
    var story = (Model.Body ?? string.Empty).Trim();
    var excerpt = story.Length > 120 ? story[..120].TrimEnd() + "…" : story;
}
<div class="fhp-group text-center">
    <div class="position-relative fhp-r-5 fhp-mb-20 fhp-lg-mb-22">
        <a href="@art" data-fslightbox="fan-art" class="d-block overflow-hidden fhp-r-5">
            <img
                src="@art"
                class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110"
                alt="@Model.Title"
                loading="lazy"
            >
        </a>
        <div class="d-flex align-items-center justify-content-center flex-wrap fhp-gap-5 position-absolute fhp-bottom-10px start-50 fhp-transform fhp-tx-n50 fhp-transition fhp-dur300 fhp-ease opacity-0 invisible fhp-group-hover-opacity-100 fhp-group-hover-visible fhp-group-hover-bottom-20px">
            <span class="d-flex align-items-center justify-content-center text-white fhp-bg-white-30 rounded-pill fhp-px-12 fhp-h-30 fhp-fs-13 fw-bold">
                @author
            </span>
            <a href="@art" data-fslightbox="fan-art" class="d-flex align-items-center justify-content-center text-white fhp-bg-white-30 rounded-pill fhp-w-30 fhp-h-30 fhp-transition fhp-dur300 fhp-ease fhp-hover-bg-primary fhp-hover-text-white" title="View the full artwork">
                <i class="ri-eye-line"></i>
            </a>
        </div>
    </div>
    <h3 class="fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1 fhp-mb-10">
        @Model.Title
    </h3>
    <ul class="fhp-fs-13 fhp-md-fs-14 fw-bold fhp-text-body-70 d-flex align-items-center justify-content-center flex-wrap fhp-gap-11 text-uppercase fhp-tracking-0-1em">
        <li>
            @Model.CreatedAt.ToString("dd MMM yyyy")
        </li>
        <li>
            <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
        </li>
        <li>
            Fan Art
        </li>
    </ul>
    @if (!string.IsNullOrEmpty(excerpt))
    {
        <p class="fhp-mt-12 mb-0">
            @excerpt
        </p>
    }
</div>
