                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Support" asp-action="Index" class="@SideItem@Mark("support")">
                                FAQ &amp; Support
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Contact" asp-action="Index" class="@SideItem@Mark("contact")">
                                Contact Us
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Bookmarks" asp-action="Index" class="@SideItem@Mark("bookmarks")">
                                My Bookmarks
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Account" asp-action="Profile" class="@SideItem@Mark("account")">
                                My Account
                            </a>
                        </li>
