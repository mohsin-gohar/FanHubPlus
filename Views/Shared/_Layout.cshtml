@using System.Text.RegularExpressions
@{
    // Public site theme: the FanHubPlus build of the streaming template. The
    // markup below is the template's own header / sidebar / footer verbatim -
    // same element nesting, same class strings (Bootstrap 5.3 + the fhp-utilities
    // utility sheet, so every class has to appear exactly as the template wrote it).
    var pref = Context.Request.Cookies["fhp_pref"];
    var fontMatch = Regex.Match(pref ?? "", @"\|(\d+)$");
    var fontPx = fontMatch.Success ? fontMatch.Groups[1].Value : "16";

    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var userName = User.Identity?.Name ?? "";

    var controller = (Context.Request.RouteValues["controller"]?.ToString() ?? "Home").ToLowerInvariant();
    var action = (Context.Request.RouteValues["action"]?.ToString() ?? "Index").ToLowerInvariant();

    // The template's home page wears the translucent, inset header; every other
    // page the plain fixed one. Inner pages also paint their own white bed
    // (bg-white text-[#666666]) while the home page keeps the dark bed.
    var isHome = controller == "home" && action == "index";
    var darkBed = ViewData["fhpDark"] is true;
    var headerClass = isHome
        ? "py-[15px] lg:!py-0 bg-[#585151]/44 backdrop-blur-[4.5px] mx-[10px] mt-[10px] rounded-t-[10px] fixed top-0 left-0 right-0 z-[4] transition-all duration-300 ease-in-out"
        : "py-[15px] lg:py-0 xl:py-[10px] fixed top-0 left-0 right-0 z-[4] !rounded-none transition-all duration-300 ease-in-out";

    string Mark(string name) => (controller == name || (name == "explore" && controller == "streaming")) ? " active" : "";

    // ---- header class strings ----------------------------------------
    // They are declared here instead of inline because Razor will not
    // evaluate an expression that starts in the MIDDLE of an HTML
    // attribute value and also contains quotes: class="@NavPlain@Mark("x")"
    // renders correctly, class="nav-link@Mark("x")" ships as literal text.
    const string NavPlain = "nav-link";
    const string NavDrop = "nav-link dropdown-toggle";
    // ---- sidebar class strings (unchanged) --------------------------
    const string SideDrop = "nav-link dropdown-toggle font-bold text-15 lg:text-base relative block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string SidePlain = "nav-link font-bold text-15 lg:text-base relative block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string SideItem = "nav-link font-bold text-sm lg:text-15 relative text-white block transition-all duration-300 ease-in-out hover:text-secondary";
    const string SideMenu = "dropdown-menu hidden transition-all duration-300 ease-in-out mt-[15px] py-[10px] ltr:border-l rtl:border-r border-white/15";
}
<!DOCTYPE html>
<html lang="en" dir="ltr" style="font-size: @(fontPx)px">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")FanHubPlus</title>

    <!-- Links Of CSS File -->
    @* Bootstrap 5.3 is the base CSS framework. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    @* FanHubPlus theme: maps the palette to Bootstrap CSS custom properties. *@
    <link rel="stylesheet" href="~/css/bootstrap-fhp-theme.css" asp-append-version="true" />
    @* Core component sheet: variables, dark-mode overrides, and all .fhp-*
       component rules for forms, panels, tabs, media, timeline, map, etc.
       Loads before the utility sheet so the utility layer wins on shared
       selectors. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Utility classes used by the Razor views (replaces the previous Tailwind
       build). Provides every .flex / .bg-white etc. utility the markup needs. *@
    <link rel="stylesheet" href="~/css/fhp-utilities.css" asp-append-version="true" />
    @* Regenerated Tailwind build (tailwind.config.js + tailwind.src.css). The
       utility sheet above is a pre-purged build that predates several views, so
       it lacks things like .h-full / .aspect-[16/9] / .object-cover / .truncate;
       without them media and cards lose their sizing. Loaded last so the
       utilities win over the older sheet's copies of the same names. *@
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/assets/css/flaticon_fanhubplus.css" />
    <link rel="stylesheet" href="~/assets/css/scrollCue.css" />
    <link rel="stylesheet" href="~/assets/css/remixicon.css" />
    @* Application widgets the template has no rule for (flash notices, FanBot,
       bookmark + rating controls). Loaded last so it always wins. *@
    <link rel="stylesheet" href="~/css/fanhubplus-app.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico" />

    <!-- Font Family -->
    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montez&amp;family=Montserrat:ital,wght@0,100..900;1,100..900&amp;family=Play:wght@400;700&amp;display=swap" rel="stylesheet" />

    <script>
        // Apply the stored font-size preference before the first paint.
        (function () {
            try {
                var ls = localStorage.getItem('fhp_pref');
                if (ls) {
                    var p = ls.split('|');
                    document.documentElement.style.fontSize = (parseInt(p[1] || '16', 10)) + 'px';
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
</head>
<body class="min-vh-100 d-flex flex-column">

    <!-- Preloader -->
    <div
        id="preloader"
        class="position-fixed top-0 start-0 end-0 bottom-0 fhp-z-999 bg-black d-flex align-items-center justify-content-center"
    >
        <div class="loader"></div>
    </div>
    <!-- End Preloader -->

    <!-- Header -->
    <header
        class="@headerClass fhp-nav"
        id="navbar"
    >
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a
                    class="navbar-brand fhp-nav__brand"
                    asp-controller="Home" asp-action="Index"
                >
                    @* Live HTML wordmark instead of the logo.svg: SVG <text> depends
                       on Montserrat having loaded, and without it the browser falls
                       back to a different face (or renders nothing at all), so the
                       brand name silently disappeared from the navbar. Real text is
                       always painted, stays selectable and readable by screen
                       readers, and picks up the theme colours. *@
                    <span class="fhp-nav__logo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="15" height="15" focusable="false">
                            <path d="M8 5.2 19 12 8 18.8V5.2Z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="fhp-nav__wordmark">Fan<em>HubPlus</em></span>
                    <span class="fhp-nav__mark d-inline-flex d-sm-none">FHP</span>
                </a>

                <button
                    type="button"
                    id="navbarBurgerToggle"
                    class="navbar-burger-toggle fhp-nav__burger"
                    aria-label="Open the menu"
                >
                    <span class="fhp-nav__burger-bar"></span>
                    <span class="fhp-nav__burger-bar"></span>
                    <span class="fhp-nav__burger-bar"></span>
                </button>

                <ul class="navbar-nav fhp-nav__links d-none d-lg-flex">
                    <li class="nav-item dropdown">
                        <a
                            href="javascript:void(0);"
                            class="@NavDrop@Mark("home")"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            Home <i class="ri-arrow-down-s-line"></i>
                        </a>
                        <ul class="dropdown-menu fhp-nav__dropdown">
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("home")" asp-controller="Home" asp-action="Index">
                                    Main Portal
                                </a>
                            </li>
                            @if (isAuth)
                            {
                                <li class="nav-item">
                                    <a class="@NavPlain" asp-controller="Account" asp-action="Profile">
                                        User Dashboard
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a
                            href="javascript:void(0);"
                            class="@NavDrop"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            Pages <i class="ri-arrow-down-s-line"></i>
                        </a>
                        <ul class="dropdown-menu fhp-nav__dropdown">
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("characters")" asp-controller="Characters" asp-action="Index">
                                    Character Profiles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("fanart")" asp-controller="FanArt" asp-action="Index">
                                    Fan Art Gallery
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("merch")" asp-controller="Merch" asp-action="Index">
                                    Merchandise Showcase
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("bookmarks")" asp-controller="Bookmarks" asp-action="Index">
                                    My Bookmarks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("events")" asp-controller="Events" asp-action="Index">
                                    Events &amp; Calendar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("chatbot")" asp-controller="Chatbot" asp-action="Index">
                                    FanBot Assistant
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("support")" asp-controller="Support" asp-action="Index">
                                    Help &amp; FAQ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("contact")" asp-controller="Contact" asp-action="Index">
                                    Contact Support
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("sitemap")" asp-controller="Sitemap" asp-action="Index">
                                    Site Map
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a
                            href="javascript:void(0);"
                            class="@NavDrop@Mark("streaming")"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            Movies &amp; TV <i class="ri-arrow-down-s-line"></i>
                        </a>
                        <ul class="dropdown-menu fhp-nav__dropdown">
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("streaming")" asp-controller="Streaming" asp-action="Index">
                                    Streaming Library
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain" asp-controller="Streaming" asp-action="Index" asp-route-contentType="Movie">
                                    Movies
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain" asp-controller="Streaming" asp-action="Index" asp-route-contentType="Series">
                                    TV Shows / Series
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain" asp-controller="Streaming" asp-action="Index" asp-route-contentType="Documentary">
                                    Documentaries
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("explore")" asp-controller="Explore" asp-action="Index">
                                    Full Explorer
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a
                            href="javascript:void(0);"
                            class="@NavDrop"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            Videos <i class="ri-arrow-down-s-line"></i>
                        </a>
                        <ul class="dropdown-menu fhp-nav__dropdown">
                            <li class="nav-item">
                                <a class="@NavPlain" asp-controller="Explore" asp-action="Index" asp-route-type="Movie">
                                    Movie Trailers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain" asp-controller="Explore" asp-action="Index" asp-route-type="Series">
                                    TV Show Clips
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a
                            href="javascript:void(0);"
                            class="@NavDrop@Mark("blog")"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            Blog <i class="ri-arrow-down-s-line"></i>
                        </a>
                        <ul class="dropdown-menu fhp-nav__dropdown">
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("blog")" asp-controller="Blog" asp-action="Index">
                                    Latest Articles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavPlain@Mark("news")" asp-controller="News" asp-action="Index">
                                    News &amp; Timeline
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a
                            class="@NavPlain@Mark("explore")"
                            asp-controller="Explore" asp-action="Index"
                        >
                            Movies &amp; TV Shows
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="@NavPlain@Mark("gaming")"
                            asp-controller="Gaming" asp-action="Index"
                        >
                            Gaming
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="@NavPlain@Mark("music")"
                            asp-controller="Music" asp-action="Index"
                        >
                            Music
                        </a>
                    </li>
                </ul>

                <div class="fhp-nav__actions">
                    <div class="fhp-nav__search">
                        <button
                            type="button"
                            id="searchBtn"
                            class="fhp-nav__icon"
                            aria-label="Search" aria-expanded="false" aria-controls="searchBox"
                        >
                            <i class="ri-search-line"></i>
                        </button>
                        <div id="searchBox" class="fhp-nav__searchbox" role="search">
                            <form
                                asp-controller="Explore" asp-action="Index" method="get"
                                class="position-relative"
                            >
                                <input type="text" name="search" class="form-control form-input" placeholder="Search for anything" aria-label="Search">
                                <button
                                    class="position-absolute top-50 translate-middle-y end-0 fhp-me-12 border-0 bg-transparent p-0 fs-5 lh-1"
                                    type="submit"
                                    aria-label="Submit search"
                                >
                                    <i class="ri-search-line"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <a
                        asp-controller="Merch" asp-action="Index"
                        class="fhp-nav__icon fhp-nav__cart position-relative"
                        aria-label="Merchandise Showcase, 0 items"
                        title="Merchandise Showcase"
                    >
                        <i class="ri-shopping-cart-line"></i>
                        <span class="fhp-nav__badge">0</span>
                    </a>

                    <a
                        asp-controller="Bookmarks" asp-action="Index"
                        class="fhp-nav__icon d-none d-sm-inline-flex"
                        aria-label="My bookmarks"
                        title="My Bookmarks"
                    >
                        <i class="ri-heart-3-line"></i>
                    </a>

                    <span class="fhp-nav__divider d-none d-sm-block"></span>

                    @if (isAuth)
                    {
                        <a
                            class="fhp-nav__user"
                            asp-controller="Account" asp-action="Profile"
                            title="@userName"
                        >
                            <i class="ri-user-3-line" aria-hidden="true"></i>
                            <span>@(userName.Length > 10 ? userName[..10] + "…" : userName)</span>
                        </a>
                        @if (isAdmin)
                        {
                            <a
                                class="fhp-nav__cta"
                                asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                            >
                                Admin Panel
                            </a>
                        }
                    }
                    else
                    {
                        <a
                            class="fhp-nav__cta"
                            asp-controller="Account" asp-action="Login"
                        >
                            Sign In
                        </a>
                    }
                </div>
            </div>

            @* Reading-progress hairline along the bottom edge of the bar. *@
            <div class="fhp-nav__progress" aria-hidden="true"><span></span></div>
        </nav>
    </header>
    <!-- End Header -->


    <!-- Sidebar Modal -->
    <div class="sidebar-modal">
        <div class="fhp-p-20 fhp-md-p-30 fhp-lg-px-40 d-flex align-items-center justify-content-between bg-black border-bottom fhp-border-white-8">
            <a
                asp-controller="Home" asp-action="Index"
                class="flex-shrink-0 d-inline-block"
            >
                <img src="~/assets/images/logo.svg" alt="FanHubPlus logo">
            </a>
            <button
                type="button"
                class="d-inline-block fhp-fs-20 lh-1 text-white fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary"
            >
                <i class="flaticon-close"></i>
            </button>
        </div>
        <div
            class="overflow-y-scroll fhp-h-screen fhp-scrollbar"
            data-lenis-prevent
        >
            <ul class="sidebar-navbar-nav fhp-p-20 fhp-md-p-30 fhp-lg-px-40">
                <li class="nav-item fhp-mb-20 fhp-last-mb-0">
                    <a
                        asp-controller="Home" asp-action="Index"
                        class="@SidePlain@Mark("home")"
                    >
                        Home
                    </a>
                </li>
                <li class="nav-item fhp-mb-20 fhp-last-mb-0">
                    <a
                        href="javascript:void(0);"
                        class="@SideDrop@Mark("explore")"
                    >
                        Explore
                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Explore" asp-action="Index" class="@SideItem@Mark("explore")">
                                All Titles
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Characters" asp-action="Index" class="@SideItem@Mark("characters")">
                                Characters
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="FanArt" asp-action="Index" class="@SideItem@Mark("fanart")">
                                Fan Art
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Merch" asp-action="Index" class="@SideItem@Mark("merch")">
                                Merchandise
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Gaming" asp-action="Index" class="@SideItem@Mark("gaming")">
                                Gaming Hub
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Music" asp-action="Index" class="@SideItem@Mark("music")">
                                Music &amp; Soundtracks
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Bookmarks" asp-action="Index" class="@SideItem@Mark("bookmarks")">
                                My Bookmarks
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item fhp-mb-20 fhp-last-mb-0">
                    <a
                        href="javascript:void(0);"
                        class="@SideDrop@Mark("news")"
                    >
                        Community
                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="News" asp-action="Index" class="@SideItem@Mark("news")">
                                News &amp; Timeline
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Blog" asp-action="Index" class="@SideItem@Mark("blog")">
                                Blog
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Events" asp-action="Index" class="@SideItem@Mark("events")">
                                Events
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
                            <a asp-controller="Chatbot" asp-action="Index" class="@SideItem@Mark("chatbot")">
                                FanBot Chat
                            </a>
                        </li>
                        <li class="nav-item fhp-px-20 fhp-mb-15 fhp-last-mb-0">
