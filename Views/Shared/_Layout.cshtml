@using System.Text.RegularExpressions
@{
    // Public site theme: the FanHubPlus build of the streaming template. The
    // markup below is the template's own header / sidebar / footer verbatim -
    // same element nesting, same class strings (Bootstrap 5.3 + the fhp-utilities
    // utility sheet, so every class has to appear exactly as the template wrote it).
    var pref = Context.Request.Cookies["fhp_pref"];
    var fontMatch = Regex.Match(pref ?? "", @"\|(\d+)$");
    var fontPx = fontMatch.Success ? fontMatch.Groups[1].Value : "16";

    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var userName = User.Identity?.Name ?? "";

    var controller = (Context.Request.RouteValues["controller"]?.ToString() ?? "Home").ToLowerInvariant();
    var action = (Context.Request.RouteValues["action"]?.ToString() ?? "Index").ToLowerInvariant();

    // The template's home page wears the translucent, inset header; every other
    // page the plain fixed one. Inner pages also paint their own white bed
    // (bg-white text-[#666666]) while the home page keeps the dark bed.
    var isHome = controller == "home" && action == "index";
    var darkBed = ViewData["fhpDark"] is true;
    var headerClass = isHome
        ? "py-[15px] lg:!py-0 bg-[#585151]/44 backdrop-blur-[4.5px] mx-[10px] mt-[10px] rounded-t-[10px] fixed top-0 left-0 right-0 z-[4] transition-all duration-300 ease-in-out"
        : "py-[15px] lg:py-0 xl:py-[10px] fixed top-0 left-0 right-0 z-[4] !rounded-none transition-all duration-300 ease-in-out";

    string Mark(string name) => controller == name ? " active" : "";

    // ---- class strings, copied from the template ----
    const string NavDrop = "nav-link dropdown-toggle font-bold text-15 relative py-[30px] xl:py-[40px] block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string NavPlain = "nav-link font-bold text-15 relative py-[30px] xl:py-[40px] block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string ItemLink = "nav-link font-bold text-15 relative text-white px-[25px] block transition-all duration-300 ease-in-out hover:text-secondary";
    const string SideDrop = "nav-link dropdown-toggle font-bold text-15 lg:text-base relative block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string SidePlain = "nav-link font-bold text-15 lg:text-base relative block text-white transition-all duration-300 ease-in-out hover:text-secondary";
    const string SideItem = "nav-link font-bold text-sm lg:text-15 relative text-white block transition-all duration-300 ease-in-out hover:text-secondary";
    const string DropMenu = "dropdown-menu absolute min-w-[270px] xl:min-w-[290px] bg-navy-black py-[25px] transition-all duration-300 ease-in-out";
    const string SideMenu = "dropdown-menu hidden transition-all duration-300 ease-in-out mt-[15px] py-[10px] ltr:border-l rtl:border-r border-white/15";
}
<!DOCTYPE html>
<html lang="en" dir="ltr" style="font-size: @(fontPx)px">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")FanHubPlus</title>

    <!-- Links Of CSS File -->
    @* Bootstrap 5.3 is the base CSS framework. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    @* FanHubPlus theme: maps the palette to Bootstrap CSS custom properties. *@
    <link rel="stylesheet" href="~/css/bootstrap-fhp-theme.css" asp-append-version="true" />
    @* Core component sheet: variables, dark-mode overrides, and all .fhp-*
       component rules for forms, panels, tabs, media, timeline, map, etc.
       Loads before the utility sheet so the utility layer wins on shared
       selectors. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Utility classes used by the Razor views (replaces the previous Tailwind
       build). Provides every .flex / .bg-white etc. utility the markup needs. *@
    <link rel="stylesheet" href="~/css/fhp-utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/assets/css/flaticon_fanhubplus.css" />
    <link rel="stylesheet" href="~/assets/css/scrollCue.css" />
    <link rel="stylesheet" href="~/assets/css/remixicon.css" />
    @* Application widgets the template has no rule for (flash notices, FanBot,
       bookmark + rating controls). Loaded last so it always wins. *@
    <link rel="stylesheet" href="~/css/fanhubplus-app.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico" />

    <!-- Font Family -->
    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montez&amp;family=Montserrat:ital,wght@0,100..900;1,100..900&amp;family=Play:wght@400;700&amp;display=swap" rel="stylesheet" />

    <script>
        // Apply the stored font-size preference before the first paint.
        (function () {
            try {
                var ls = localStorage.getItem('fhp_pref');
                if (ls) {
                    var p = ls.split('|');
                    document.documentElement.style.fontSize = (parseInt(p[1] || '16', 10)) + 'px';
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Preloader -->
    <div
        id="preloader"
        class="fixed top-0 left-0 right-0 bottom-0 z-[999] bg-black flex items-center justify-center"
    >
        <div class="loader"></div>
    </div>
    <!-- End Preloader -->

    <!-- Header -->
    <header
        class="@headerClass"
        id="navbar"
    >
        <div class="container 2xl:!px-[30px] lg:!max-w-full xl:!max-w-[1920px]">
            <div class="relative flex items-center flex-wrap lg:flex-nowrap justify-between lg:justify-start">
                <a
                    asp-controller="Home" asp-action="Index"
                    class="flex-none inline-block"
                >
                    <img src="~/assets/images/logo.svg" alt="FanHubPlus logo">
                </a>
                <div class="flex-none lg:hidden">
                    <button
                        type="button"
                        id="navbarBurgerToggle"
                        class="navbar-burger-toggle inline-block leading-none"
                    >
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                    </button>
                </div>
                <div class="hidden lg:flex items-center grow basis-full basis-auto">
                    <ul class="navbar-nav flex items-center flex-row gap-[30px] xl:gap-[40px] 2xl:gap-[50px] mx-auto">
                        <li class="nav-item relative">
                            <a
                                asp-controller="Home" asp-action="Index"
                                class="@NavPlain@Mark("home")"
                            >
                                Home
                            </a>
                        </li>
                        <li class="nav-item relative">
                            <a
                                href="javascript:void(0);"
                                class="@NavDrop@Mark("explore")"
                            >
                                Explore
                            </a>
                            <ul class="@DropMenu">
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Explore" asp-action="Index" class="@ItemLink@Mark("explore")">
                                        All Titles
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Characters" asp-action="Index" class="@ItemLink@Mark("characters")">
                                        Characters
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="FanArt" asp-action="Index" class="@ItemLink@Mark("fanart")">
                                        Fan Art
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Merch" asp-action="Index" class="@ItemLink@Mark("merch")">
                                        Merchandise
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Bookmarks" asp-action="Index" class="@ItemLink@Mark("bookmarks")">
                                        My Bookmarks
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item relative">
                            <a
                                href="javascript:void(0);"
                                class="@NavDrop@Mark("news")"
                            >
                                Community
                            </a>
                            <ul class="@DropMenu">
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="News" asp-action="Index" class="@ItemLink@Mark("news")">
                                        News &amp; Timeline
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Blog" asp-action="Index" class="@ItemLink@Mark("blog")">
                                        Blog
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Events" asp-action="Index" class="@ItemLink@Mark("events")">
                                        Events
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Chatbot" asp-action="Index" class="@ItemLink@Mark("chatbot")">
                                        FanBot Chat
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Sitemap" asp-action="Index" class="@ItemLink@Mark("sitemap")">
                                        Sitemap
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item relative">
                            <a
                                href="javascript:void(0);"
                                class="@NavDrop@Mark("support")"
                            >
                                Pages
                            </a>
                            <ul class="@DropMenu">
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Support" asp-action="Index" class="@ItemLink@Mark("support")">
                                        FAQ &amp; Support
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Contact" asp-action="Index" class="@ItemLink@Mark("contact")">
                                        Contact Us
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a asp-controller="Sitemap" asp-action="Index" class="@ItemLink@Mark("sitemap")">
                                        Sitemap
                                    </a>
                                </li>
                                <li class="nav-item relative mb-[17px] last:mb-0">
                                    <a
                                        href="javascript:void(0);"
                                        class="nav-link dropdown-toggle font-bold text-15 relative px-[25px] block text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                    >
                                        My Account
                                    </a>
                                    <ul class="@DropMenu">
                                        <li class="nav-item relative mb-[17px] last:mb-0">
                                            <a asp-controller="Account" asp-action="Profile" class="@ItemLink@Mark("account")">
                                                My Account
                                            </a>
                                        </li>
                                        <li class="nav-item relative mb-[17px] last:mb-0">
                                            <a asp-controller="Account" asp-action="Login" class="@ItemLink">
                                                Sign In
                                            </a>
                                        </li>
                                        <li class="nav-item relative mb-[17px] last:mb-0">
                                            <a asp-controller="Account" asp-action="Register" class="@ItemLink">
                                                Sign Up
                                            </a>
                                        </li>
                                        <li class="nav-item relative mb-[17px] last:mb-0">
                                            <a asp-controller="Account" asp-action="ResetPassword" class="@ItemLink">
                                                Forgot Password
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item relative">
                            <a
                                asp-controller="Blog" asp-action="Index"
                                class="@NavPlain@Mark("blog")"
                            >
                                Blog
                            </a>
                        </li>
                    </ul>
                    <div class="flex items-center gap-[25px] xl:gap-[35px]">
                            <div class="flex items-center gap-[13px]">
                                <div class="relative">
                                    <button
                                        type="button"
                                        id="searchBtn"
                                        class="text-xl relative inline-block text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                    >
                                        <i class="ri-search-line"></i>
                                    </button>
                                    <div
                                        id="searchBox"
                                        class="absolute mt-[28px] xl:mt-[36px] top-full ltr:right-0 rtl:left-0 w-[380px] xl:w-[420px] bg-black p-[25px] xl:p-[30px] invisible opacity-0 transition-all duration-300 ease-in-out"
                                    >
                                        <form
                                            asp-controller="Explore" asp-action="Index" method="get"
                                            class="relative"
                                        >
                                            <input type="text" name="search" class="form-input" placeholder="Search for anything">
                                            <button
                                                class="absolute top-1/2 -translate-y-1/2 ltr:right-[20px] rtl:left-[20px] text-xl leading-none transition-all duration-300 ease-in-out hover:text-primary"
                                                type="submit"
                                            >
                                                <i class="ri-search-line"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div class="w-px bg-white/20 h-[20px]"></div>
                                <a
                                    asp-controller="Bookmarks" asp-action="Index"
                                    class="text-xl relative inline-block text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                >
                                    <i class="ri-heart-3-line"></i>
                                </a>
                                <div class="w-px bg-white/20 h-[20px] xl:hidden"></div>
                                <a
                                    asp-controller="Account" asp-action="Profile"
                                    class="text-xl relative inline-block xl:hidden text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                >
                                    <i class="ri-user-3-line"></i>
                                </a>
                            </div>
                            @if (isAuth)
                            {
                                <a asp-controller="Account" asp-action="Profile" class="primary-btn !hidden xl:!inline-block">
                                    @(userName.Length > 12 ? userName[..12] + "…" : userName)
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="primary-btn !hidden xl:!inline-block">
                                    Sign In
                                </a>
                            }
                        </div>
                </div>
            </div>
        </div>
    </header>
    <!-- End Header -->

    <!-- Sidebar Modal -->
    <div class="sidebar-modal">
        <div class="p-[20px] md:p-[30px] lg:px-[40px] flex items-center justify-between bg-black border-b border-white/8">
            <a
                asp-controller="Home" asp-action="Index"
                class="flex-none inline-block"
            >
                <img src="~/assets/images/logo.svg" alt="FanHubPlus logo">
            </a>
            <button
                type="button"
                class="inline-block text-xl leading-none text-white transition-all duration-300 ease-in-out hover:text-secondary"
            >
                <i class="flaticon-close"></i>
            </button>
        </div>
        <div
            class="overflow-y-scroll h-screen scrollbar"
            data-lenis-prevent
        >
            <ul class="sidebar-navbar-nav p-[20px] md:p-[30px] lg:px-[40px]">
                <li class="nav-item mb-[20px] last:mb-0">
                    <a
                        asp-controller="Home" asp-action="Index"
                        class="@SidePlain@Mark("home")"
                    >
                        Home
                    </a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a
                        href="javascript:void(0);"
                        class="@SideDrop@Mark("explore")"
                    >
                        Explore
                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Explore" asp-action="Index" class="@SideItem@Mark("explore")">
                                All Titles
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Characters" asp-action="Index" class="@SideItem@Mark("characters")">
                                Characters
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="FanArt" asp-action="Index" class="@SideItem@Mark("fanart")">
                                Fan Art
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Merch" asp-action="Index" class="@SideItem@Mark("merch")">
                                Merchandise
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Bookmarks" asp-action="Index" class="@SideItem@Mark("bookmarks")">
                                My Bookmarks
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a
                        href="javascript:void(0);"
                        class="@SideDrop@Mark("news")"
                    >
                        Community
                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="News" asp-action="Index" class="@SideItem@Mark("news")">
                                News &amp; Timeline
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Blog" asp-action="Index" class="@SideItem@Mark("blog")">
                                Blog
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Events" asp-action="Index" class="@SideItem@Mark("events")">
                                Events
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Chatbot" asp-action="Index" class="@SideItem@Mark("chatbot")">
                                FanBot Chat
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Sitemap" asp-action="Index" class="@SideItem@Mark("sitemap")">
                                Sitemap
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a
                        href="javascript:void(0);"
                        class="@SideDrop@Mark("support")"
                    >
                        Pages
                    </a>
                    <ul class="@SideMenu">
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Support" asp-action="Index" class="@SideItem@Mark("support")">
                                FAQ &amp; Support
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Contact" asp-action="Index" class="@SideItem@Mark("contact")">
                                Contact Us
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Bookmarks" asp-action="Index" class="@SideItem@Mark("bookmarks")">
                                My Bookmarks
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Account" asp-action="Profile" class="@SideItem@Mark("account")">
                                My Account
                            </a>
                        </li>
                        <li class="nav-item px-[20px] mb-[15px] last:mb-0">
                            <a asp-controller="Account" asp-action="ResetPassword" class="@SideItem">
                                Forgot Password
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a
                        asp-controller="Blog" asp-action="Index"
                        class="@SidePlain@Mark("blog")"
                    >
                        Blog
                    </a>
                </li>
            </ul>
        </div>
        <div class="p-[20px] md:p-[30px] lg:px-[40px] bg-black border-t border-white/8">
            <div class="flex items-center gap-[25px] md:gap-[30px] mb-[20px] md:mb-[25px]">
                <a
                    asp-controller="Bookmarks" asp-action="Index"
                    class="text-xl relative inline-block text-white transition-all duration-300 ease-in-out hover:text-secondary"
                >
                    <i class="ri-heart-3-line"></i>
                </a>
                @if (isAuth)
                {
                    <a asp-controller="Account" asp-action="Profile" class="primary-btn">
                        @(userName.Length > 12 ? userName[..12] + "…" : userName)
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="primary-btn">
                            Sign Out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="primary-btn">
                        Sign In
                    </a>
                }
            </div>
            <form
                asp-controller="Explore" asp-action="Index" method="get"
                class="relative"
            >
                <input type="text" name="search" class="form-input" placeholder="Search for anything">
                <button
                    class="absolute top-1/2 -translate-y-1/2 ltr:right-[20px] rtl:left-[20px] text-xl leading-none transition-all duration-300 ease-in-out hover:text-primary"
                    type="submit"
                >
                    <i class="ri-search-line"></i>
                </button>
            </form>
        </div>
    </div>
    <div class="backdrop"></div>
    <!-- End Sidebar Modal -->

    <!-- Main content -->
    <main class="flex-1@(darkBed ? "" : " bg-white text-[#666666]")">
        @if (TempData["StatusMessage"] != null || TempData["StatusError"] != null || TempData["PasswordError"] != null)
        {
            <div class="fixed top-[90px] md:top-[100px] left-0 right-0 z-[5] px-[15px]">
                <div class="container">
                    <partial name="_Alerts" />
                </div>
            </div>
        }
        @RenderBody()
    </main>
    <!-- End Main content -->

    <!-- Footer -->
    <footer
        class="pt-[60px] md:pt-[80px] lg:pt-[100px] xl:pt-[120px] 2xl:pt-[140px] bg-navy-black bg-cover bg-center bg-no-repeat"
        style="background-image: url(/assets/images/bg-images/bg-image3.jpg);"
    >
        <div class="container">
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-[25px]">
                <div>
                    <h3 class="mb-[20px] md:mb-[25px] lg:mb-[30px] text-base md:text-lg lg:text-xl leading-none">
                        Explore
                    </h3>
                    <ul class="text-body/80 font-bold text-13 md:text-sm lg:text-15 ltr:md:border-l rtl:md:border-r md:border-white/10 ltr:md:pl-[20px] rtl:md:pr-[20px]">
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="Explore" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                All Titles
                            </a>
                        </li>
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="Characters" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                Characters
                            </a>
                        </li>
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="FanArt" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                Fan Art
                            </a>
                        </li>
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="Merch" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                Merchandise
                            </a>
                        </li>
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="Events" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">
                                Events
                            </a>
                        </li>
                    </ul>
                </div>
                <div>
