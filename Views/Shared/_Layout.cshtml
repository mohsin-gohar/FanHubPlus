                            <a asp-controller="Account" asp-action="ResetPassword" class="@SideItem">
                                Forgot Password
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item fhp-mb-20 fhp-last-mb-0">
                    <a
                        asp-controller="Blog" asp-action="Index"
                        class="@SidePlain@Mark("blog")"
                    >
                        Blog
                    </a>
                </li>
            </ul>
        </div>
        <div class="fhp-p-20 fhp-md-p-30 fhp-lg-px-40 bg-black border-top fhp-border-white-8">
            <div class="d-flex align-items-center fhp-gap-25 fhp-md-gap-30 fhp-mb-20 fhp-md-mb-25">
                <a
                    asp-controller="Bookmarks" asp-action="Index"
                    class="fhp-fs-20 position-relative d-inline-block text-white fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary"
                >
                    <i class="ri-heart-3-line"></i>
                </a>
                @if (isAuth)
                {
                    <a asp-controller="Account" asp-action="Profile" class="primary-btn">
                        @(userName.Length > 12 ? userName[..12] + "…" : userName)
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="primary-btn">
                            Sign Out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="primary-btn">
                        Sign In
                    </a>
                }
            </div>
            <form
                asp-controller="Explore" asp-action="Index" method="get"
                class="position-relative"
            >
                <input type="text" name="search" class="form-input" placeholder="Search for anything">
                <button
                    class="position-absolute top-50 fhp-ty-n50 fhp-ltr-right-20px fhp-rtl-left-20px fhp-fs-20 lh-1 fhp-transition fhp-dur300 fhp-ease fhp-hover-text-primary"
                    type="submit"
