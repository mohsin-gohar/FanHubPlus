@* Page banner - the template's inner-page header, element for element.
   Model: the breadcrumb trail; the LAST item is the current page.
   Example:
     <partial name="_PageBanner" model="new List<BreadcrumbItem> { new("Explore", "/Explore"), new("Drama") }" />
   Every inner page of the template paints bg-image7.jpg behind it; a page that
   needs its own artwork sets ViewData["bannerArt"] first. *@
@model List<FanHubPlus.Models.ViewModels.BreadcrumbItem>
@{
    var trail = Model ?? new List<FanHubPlus.Models.ViewModels.BreadcrumbItem>();
    var current = trail.Count > 0 ? trail[^1].Text : string.Empty;
    var art = ViewData["bannerArt"] as string ?? "/assets/images/bg-images/bg-image7.jpg";

    // The trail can carry intermediate levels; the template shows them as
    // "Home / level / current" with the current one in the accent colour.
    var middle = trail.Take(Math.Max(0, trail.Count - 1)).ToList();
}
<div
    class="pt-[130px] md:pt-[140px] lg:pt-[155px] xl:pt-[195px] 2xl:pt-[205px] pb-[60px] md:pb-[80px] lg:pb-[105px] xl:pb-[125px] 2xl:pb-[140px] rounded-b-[10px] relative bg-no-repeat bg-center bg-cover text-center"
    style="background-image: url(@art);"
>
    <div class="container">
        <h1 class="!font-black font-secondary uppercase tracking-[0.05em] text-[22px] md:text-[26px] lg:text-[32px] leading-none mb-[15px]">
            @current
        </h1>
        <ul class="flex items-center justify-center flex-wrap gap-[10px] uppercase font-bold tracking-[0.1em] text-13 md:text-sm text-body">
            <li>
                <a asp-controller="Home" asp-action="Index" class="transition-all duration-300 ease-in-out hover:text-primary">
                    Home
                </a>
            </li>
            @foreach (var crumb in middle)
            {
                <li>
                    /
                </li>
                <li>
                    @if (!string.IsNullOrWhiteSpace(crumb.Url))
                    {
                        <a href="@crumb.Url" class="transition-all duration-300 ease-in-out hover:text-primary">@crumb.Text</a>
                    }
                    else
                    {
                        @crumb.Text
                    }
                </li>
            }
            <li>
                /
            </li>
            <li class="text-secondary">
                @current
            </li>
        </ul>
    </div>
    <div class="h-[15px] mx-auto max-w-[535px] xl:max-w-[635px] absolute bottom-0 left-0 right-0 bg-white rounded-t-[10px] hidden lg:block"></div>
</div>
