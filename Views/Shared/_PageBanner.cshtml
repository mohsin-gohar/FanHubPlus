@* Page banner - the template's inner-page header, element for element.
   Model: the breadcrumb trail; the LAST item is the current page.
   Example:
     <partial name="_PageBanner" model="new List<BreadcrumbItem> { new("Explore", "/Explore"), new("Drama") }" />
   Every inner page of the template paints bg-image7.jpg behind it; a page that
   needs its own artwork sets ViewData["bannerArt"] first. *@
@model List<FanHubPlus.Models.ViewModels.BreadcrumbItem>
@{
    var trail = Model ?? new List<FanHubPlus.Models.ViewModels.BreadcrumbItem>();
    var current = trail.Count > 0 ? trail[^1].Text : string.Empty;

    // ---- Header background artwork -------------------------------------------
    // Every inner page paints a background image behind its header; the home page
    // (Home/Index) is excluded on purpose - it already has its own full-bleed hero,
    // so a banner behind it would double up the artwork.
    //
    // A view can still pin its own image with ViewData["bannerArt"]. Otherwise the
    // image is picked from the controller, so each section gets a different photo
    // instead of all 30 pages sharing one picture. Anything unmapped falls back to
    // the template default (bg-image7).
    var controller = (Context.Request.RouteValues["controller"]?.ToString() ?? "").ToLowerInvariant();
    var bannerArtByController = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["explore"]   = "/assets/images/bg-images/bg-image1.jpg",
        ["characters"] = "/assets/images/bg-images/bg-image2.jpg",
        ["blog"]      = "/assets/images/bg-images/bg-image3.jpg",
        ["news"]      = "/assets/images/bg-images/bg-image4.jpg",
        ["music"]     = "/assets/images/bg-images/bg-image5.jpg",
        ["streaming"] = "/assets/images/bg-images/bg-image6.jpg",
        ["gaming"]    = "/assets/images/bg-images/bg-image8.jpg",
        ["merch"]     = "/assets/images/bg-images/bg-image1.jpg",
        ["events"]    = "/assets/images/bg-images/bg-image2.jpg",
        ["fanart"]    = "/assets/images/bg-images/bg-image3.jpg",
        ["bookmarks"] = "/assets/images/bg-images/bg-image4.jpg",
        ["account"]   = "/assets/images/bg-images/bg-image5.jpg",
        ["contact"]   = "/assets/images/bg-images/bg-image6.jpg",
        ["support"]   = "/assets/images/bg-images/bg-image8.jpg",
        ["chatbot"]   = "/assets/images/bg-images/bg-image3.jpg",
        ["sitemap"]   = "/assets/images/bg-images/bg-image4.jpg",
    };

    var art = ViewData["bannerArt"] as string
              ?? (bannerArtByController.TryGetValue(controller, out var mapped) ? mapped : null)
              ?? "/assets/images/bg-images/bg-image7.jpg";

    // The trail can carry intermediate levels; the template shows them as
    // "Home / level / current" with the current one in the accent colour.
    var middle = trail.Take(Math.Max(0, trail.Count - 1)).ToList();
}
<div
    class="fhp-pt-130 fhp-md-pt-140 fhp-lg-pt-155 fhp-xl-pt-195 fhp-xxl-pt-205 fhp-pb-60 fhp-md-pb-80 fhp-lg-pb-105 fhp-xl-pb-125 fhp-xxl-pb-140 fhp-rb-10 position-relative fhp-bg-norepeat fhp-bg-center fhp-bg-cover text-center"
    style="background-image: url(@art);"
>
    <div class="container">
        <h1 class="!font-black fhp-font-secondary text-uppercase fhp-tracking-0-05em fhp-fs-22 fhp-md-fs-26 fhp-lg-fs-32 lh-1 fhp-mb-15">
            @current
        </h1>
        <ul class="d-flex align-items-center justify-content-center flex-wrap fhp-gap-10 text-uppercase fw-bold fhp-tracking-0-1em fhp-fs-13 fhp-md-fs-14 fhp-text-body">
            <li>
                <a asp-controller="Home" asp-action="Index" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-primary">
                    Home
                </a>
            </li>
            @foreach (var crumb in middle)
            {
                <li>
                    /
                </li>
                <li>
                    @if (!string.IsNullOrWhiteSpace(crumb.Url))
                    {
                        <a href="@crumb.Url" class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-primary">@crumb.Text</a>
                    }
                    else
                    {
                        @crumb.Text
                    }
                </li>
            }
            <li>
                /
            </li>
            <li class="text-secondary">
                @current
            </li>
        </ul>
    </div>
    <div class="fhp-h-15 mx-auto fhp-maxw-535 fhp-xl-maxw-635 position-absolute bottom-0 start-0 end-0 bg-white fhp-rt-10 d-none d-lg-block"></div>
</div>
