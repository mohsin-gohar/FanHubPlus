@model MediaPlayerViewModel
@{
    var raw = (Model.Url ?? string.Empty).Trim();
    var isAudio = MediaUrl.IsAudioFile(raw);
    var isLocal = MediaUrl.IsLocalFile(raw);
    var src = MediaUrl.Normalize(raw);
    var title = string.IsNullOrWhiteSpace(Model.Title) ? "Media player" : Model.Title;
}
@if (!string.IsNullOrWhiteSpace(src))
{
    <div class="fhp-media__player @Model.CssClass">
        @if (isAudio)
        {
            <audio controls preload="metadata" title="@title">
                <source src="@src" />
                Your browser cannot play this file — <a href="@src">open the audio</a>.
            </audio>
        }
        else if (isLocal)
        {
            <video controls playsinline preload="metadata"
                   poster="@Model.Poster" title="@title"
                   @(Model.Loop ? "loop" : "")>
                <source src="@src" />
                Your browser cannot play this file — <a href="@src">open the video</a>.
            </video>
        }
        else
        {
            <iframe src="@src" title="@title" loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        }
    </div>
}
