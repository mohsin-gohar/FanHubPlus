@* Shop card, the template's product tile: cover, the "View Product" button
   that fades in on hover, the name with its view chip and the accent line
   underneath. The catalogue has no prices, so the accent line carries the
   tag (and the drop date for pre-orders) instead of a price.
   Set ViewData["fhpDark"] = true on dark pages. *@
@model FanHubPlus.Models.Entities.MerchandiseItem
@{
    var dark = (bool?)ViewData["fhpDark"] == true;
    var cover = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? $"/assets/images/products/product{(Model.ItemId % 9) + 1}.jpg"
        : Model.ImageUrl;
    var name = (dark ? "" : "fhp-text-black ") + "mb-0 fhp-fs-16 fhp-md-fs-18 fhp-lg-fs-20 lh-1";
    var hover = dark ? "fhp-hover-text-secondary" : "fhp-hover-text-primary";
    var accent = dark ? "text-secondary" : "text-primary";
    var status = Model.IsUpcoming && Model.ReleaseDate is { } d
        ? $"{Model.Tag} · drops {d:dd MMM yyyy}"
        : Model.Tag.ToString();
}
<div class="fhp-group">
    <div class="text-center position-relative fhp-mb-15 fhp-md-mb-20">
        <a asp-controller="Merch" asp-action="Details" asp-route-id="@Model.ItemId" class="d-block fhp-r-5 overflow-hidden">
            <img
                src="@cover"
                class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110"
                alt="@Model.Name"
                loading="lazy"
            >
        </a>
        <a
            asp-controller="Merch" asp-action="Details" asp-route-id="@Model.ItemId"
            class="secondary-btn text-uppercase position-absolute top-50 start-50 fhp-ty-n50 fhp-tx-n50 opacity-0 invisible fhp-group-hover-opacity-100 fhp-group-hover-visible"
        >
            View Product
        </a>
    </div>
    <div class="d-flex align-items-center justify-content-between fhp-mb-8 fhp-gap-10">
        <h3 class="@name">
            <a asp-controller="Merch" asp-action="Details" asp-route-id="@Model.ItemId" class="fhp-transition fhp-ease fhp-dur300 @hover">
                @Model.Name
            </a>
        </h3>
        <div class="d-inline-block position-relative fw-bold fhp-ltr-pl-[20px] fhp-rtl-pr-[20px] flex-shrink-0">
            <i class="ri-eye-line fhp-text-ff962e position-absolute fhp-ltr-start-0 fhp-rtl-end-0 top-50 fhp-transform fhp-ty-n50"></i>(@Model.ViewCount)
        </div>
    </div>
    <span class="d-block fw-bold @accent">
        @status
    </span>
</div>
