@*
    _AudioPlayerBar.cshtml
    Global persistent audio player bar — rendered at the bottom of Music pages.
    Controlled entirely via JavaScript (playAudioTrack / window.fhpPlayer).
*@
<div id="audioPlayerBar"
     class="position-fixed bottom-0 start-0 end-0 fhp-z-100 fhp-bg-0e0e14 border-top fhp-border-white-10 shadow-lg fhp-transform fhp-translate-y-full fhp-transition-transform fhp-dur500 fhp-ease"
     role="region"
     aria-label="Audio Player">

    <div class="container fhp-py-12">
        <div class="d-flex align-items-center fhp-gap-12">

            <!-- Album Art -->
            <img id="apBarCover"
                 src="/assets/images/categories/category1.jpg"
                 alt="Now Playing"
                 class="fhp-w-48 fhp-h-48 rounded-3 fhp-object-cover flex-shrink-0 border fhp-border-white-10 shadow" />

            <!-- Track Info -->
            <div class="flex-grow-1 fhp-minw-0">
                <p id="apBarTitle" class="text-white fw-bold fhp-fs-14 text-truncate lh-sm">Track Title</p>
                <p id="apBarArtist" class="fhp-text-white-50 fhp-fs-12 text-truncate">Artist</p>
            </div>

            <!-- Controls -->
            <div class="d-flex align-items-center fhp-gap-12">
                <button id="apBarPrev" type="button"
                        class="fhp-text-white-60 fhp-hover-text-white fhp-fs-20 fhp-transition-colors"
                        aria-label="Previous track" title="Previous">
                    <i class="ri-skip-back-fill"></i>
                </button>

                <button id="apBarPlay" type="button"
                        class="fhp-w-40 fhp-h-40 rounded-pill bg-primary text-white d-flex align-items-center justify-content-center fhp-fs-20 fhp-hover-scale-110 fhp-transition-transform shadow-lg"
                        aria-label="Play / Pause">
                    <i class="ri-play-fill" id="apBarPlayIcon"></i>
                </button>

                <button id="apBarNext" type="button"
                        class="fhp-text-white-60 fhp-hover-text-white fhp-fs-20 fhp-transition-colors"
                        aria-label="Next track" title="Next">
                    <i class="ri-skip-forward-fill"></i>
                </button>
            </div>

            <!-- Progress -->
            <div class="d-none d-md-flex align-items-center gap-2 flex-grow-1 fhp-maxw-280">
                <span id="apBarCurrentTime" class="fhp-fs-12 fhp-text-white-50 fhp-nums fhp-w-38 text-end">0:00</span>
                <input id="apBarSeek" type="range" min="0" max="100" value="0"
                       class="flex-grow-1 fhp-accent-primary fhp-h-3 fhp-cursor-pointer"
                       aria-label="Seek" />
                <span id="apBarDuration" class="fhp-fs-12 fhp-text-white-50 fhp-nums fhp-w-38">0:00</span>
            </div>

            <!-- Volume -->
            <div class="d-none d-lg-flex align-items-center gap-2">
                <button id="apBarMute" type="button" class="fhp-text-white-60 fhp-hover-text-white fhp-transition-colors fhp-fs-18" aria-label="Mute">
                    <i class="ri-volume-up-line" id="apBarMuteIcon"></i>
                </button>
                <input id="apBarVolume" type="range" min="0" max="1" step="0.05" value="0.8"
                       class="fhp-w-80 fhp-accent-primary fhp-h-3 fhp-cursor-pointer"
                       aria-label="Volume" />
            </div>

            <!-- Close -->
            <button id="apBarClose" type="button"
                    class="fhp-text-white-40 fhp-hover-text-white fhp-transition-colors fhp-fs-18 ms-2"
                    aria-label="Close player">
                <i class="ri-close-line"></i>
            </button>

        </div>
    </div>

    <!-- Hidden native audio element -->
    <audio id="apBarAudio" preload="none"></audio>
</div>

<script>
(function () {
    'use strict';

    var bar       = document.getElementById('audioPlayerBar');
    var audio     = document.getElementById('apBarAudio');
    var cover     = document.getElementById('apBarCover');
    var titleEl   = document.getElementById('apBarTitle');
    var artistEl  = document.getElementById('apBarArtist');
    var playBtn   = document.getElementById('apBarPlay');
    var playIcon  = document.getElementById('apBarPlayIcon');
    var muteBtn   = document.getElementById('apBarMute');
    var muteIcon  = document.getElementById('apBarMuteIcon');
    var seekEl    = document.getElementById('apBarSeek');
    var volEl     = document.getElementById('apBarVolume');
    var curTimeEl = document.getElementById('apBarCurrentTime');
    var durEl     = document.getElementById('apBarDuration');
    var closeBtn  = document.getElementById('apBarClose');

    // Queue support
    var queue = [];
    var queueIndex = 0;

    function fmt(sec) {
        if (!isFinite(sec)) return '0:00';
        var m = Math.floor(sec / 60);
        var s = Math.floor(sec % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function showBar() { bar.style.transform = 'translateY(0)'; }
    function hideBar() { bar.style.transform = 'translateY(100%)'; }

    function loadTrack(url, title, artist, imgSrc) {
        titleEl.textContent  = title  || 'Unknown Track';
        artistEl.textContent = artist || '';
        cover.src = imgSrc || '/assets/images/categories/category1.jpg';
        cover.alt = title;
        audio.src = url || '';
        audio.load();
        audio.play().catch(function() {});
        showBar();
    }

    function syncPlayIcon() {
        playIcon.className = audio.paused ? 'ri-play-fill' : 'ri-pause-fill';
    }

    // Public API
    window.fhpPlayer = {
        play: function(url, title, artist, imgSrc) {
            loadTrack(url, title, artist, imgSrc);
            queue = [{ url: url, title: title, artist: artist, imgSrc: imgSrc }];
            queueIndex = 0;
        },
        setQueue: function(tracks, startIndex) {
            queue = tracks || [];
            queueIndex = Math.max(0, Math.min(startIndex || 0, queue.length - 1));
            if (queue[queueIndex]) {
                var t = queue[queueIndex];
                loadTrack(t.url, t.title, t.artist, t.imgSrc);
            }
        }
    };

    // Legacy inline helper used in Music views
    window.playAudioTrack = function (title, artist, url, imgSrc) {
        window.fhpPlayer.play(url, title, artist, imgSrc);
    };

    // Play / Pause
    playBtn.addEventListener('click', function () {
        if (audio.paused) { audio.play(); } else { audio.pause(); }
    });
    audio.addEventListener('play',  syncPlayIcon);
    audio.addEventListener('pause', syncPlayIcon);

    // Seek
    audio.addEventListener('timeupdate', function () {
        if (!audio.duration) return;
        var pct = (audio.currentTime / audio.duration) * 100;
        seekEl.value = pct;
        curTimeEl.textContent = fmt(audio.currentTime);
        durEl.textContent     = fmt(audio.duration);
    });
    seekEl.addEventListener('input', function () {
        if (audio.duration) {
            audio.currentTime = (seekEl.value / 100) * audio.duration;
        }
    });

    // Volume
    audio.volume = parseFloat(volEl.value);
    volEl.addEventListener('input', function () {
        audio.volume = parseFloat(volEl.value);
        muteIcon.className = audio.volume === 0 ? 'ri-volume-mute-line' : 'ri-volume-up-line';
    });
    muteBtn.addEventListener('click', function () {
        audio.muted = !audio.muted;
        muteIcon.className = audio.muted ? 'ri-volume-mute-line' : 'ri-volume-up-line';
    });

    // Prev
    document.getElementById('apBarPrev').addEventListener('click', function () {
        if (queueIndex > 0) {
            queueIndex--;
            var t = queue[queueIndex];
            loadTrack(t.url, t.title, t.artist, t.imgSrc);
        }
    });

    // Next
    document.getElementById('apBarNext').addEventListener('click', function () {
        if (queueIndex < queue.length - 1) {
            queueIndex++;
            var t = queue[queueIndex];
            loadTrack(t.url, t.title, t.artist, t.imgSrc);
        } else {
            audio.pause();
            audio.currentTime = 0;
        }
    });

    // Auto-advance
    audio.addEventListener('ended', function () {
        if (queueIndex < queue.length - 1) {
            queueIndex++;
            var t = queue[queueIndex];
            loadTrack(t.url, t.title, t.artist, t.imgSrc);
        }
    });

    // Close
    closeBtn.addEventListener('click', function () {
        audio.pause();
        hideBar();
    });
})();
</script>
