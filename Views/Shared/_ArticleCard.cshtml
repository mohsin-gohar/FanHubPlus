@* Blog card, exactly as the template draws it: cover, uppercase meta row and
   the title. The dark landing page variant tints the meta and hovers in the
   yellow accent; the white listing pages use the black/primary variant the
   template uses there.
   Set ViewData["fhpDark"] = true on dark pages, ViewData["fhpArticleController"]
   to point the card at another controller (Blog instead of News). *@
@model FanHubPlus.Models.Entities.Article
@{
    var dark = (bool?)ViewData["fhpDark"] == true;
    var controller = ViewData["fhpArticleController"] as string ?? "News";
    var cover = $"/assets/images/blogs/blog{(Model.ArticleId % 6) + 1}.jpg";
    var author = string.IsNullOrWhiteSpace(Model.Author?.Name) ? "FanHubPlus Editorial" : Model.Author!.Name;

    var meta = "fhp-fs-13 fhp-md-fs-14 text-uppercase fw-bold fhp-flex fhp-items-center fhp-flex-wrap fhp-gap-13 fhp-mb-9 fhp-md-mb-11"
               + (dark ? " fhp-text-body-70" : "");
    var divider = dark ? "fhp-bg-white-20" : "fhp-bg-black-20";
    var byLink = "d-inline-block fhp-text-ae99fa fhp-transition fhp-dur300 fhp-ease "
                 + (dark ? "fhp-hover-text-secondary" : "fhp-hover-text-primary");
    var title = (dark ? "" : "fhp-text-black ") + "mb-0 fhp-fs-16 fhp-md-fs-18 fhp-lg-fs-20 fhp-leading-1-4";
    var hover = dark ? "fhp-group-hover-text-secondary" : "fhp-group-hover-text-primary";
}
<div class="fhp-group">
    <a
        asp-controller="@controller" asp-action="Details" asp-route-id="@Model.ArticleId"
        class="overflow-hidden d-block fhp-r-5 fhp-mb-20 fhp-lg-mb-25"
    >
        <img
            src="@cover"
            class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110"
            alt="@Model.Title"
            loading="lazy"
        >
    </a>
    <ul class="@meta">
        <li>
            @Model.PublishedAt.ToString("dd MMM, yyyy")
        </li>
        <li>
            <div class="fhp-w-1px @divider fhp-h-12"></div>
        </li>
        <li>
            By
            <a asp-controller="@controller" asp-action="Details" asp-route-id="@Model.ArticleId" class="@byLink">
                @author
            </a>
        </li>
    </ul>
    <h3 class="@title">
        <a asp-controller="@controller" asp-action="Details" asp-route-id="@Model.ArticleId" class="fhp-transition fhp-dur300 fhp-ease @hover">
            @Model.Title
        </a>
    </h3>
</div>
