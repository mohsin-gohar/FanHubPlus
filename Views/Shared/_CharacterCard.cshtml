@* Character portrait tile - the template's movie-tile geometry with the
   character's fandom as the meta line instead of a rating.
   Usage: <partial name="_CharacterCard" model="character" /> *@
@model FanHubPlus.Models.Entities.CharacterProfile
@{
    var portrait = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? $"/assets/images/categories/category{(Model.CharacterId % 7) + 1}.jpg"
        : Model.ImageUrl;
    var lore = string.IsNullOrWhiteSpace(Model.Fandom)
        ? Model.Category?.Name ?? "Fandom"
        : Model.Fandom;
}
<div class="fhp-group text-center position-relative">
    <a
        asp-controller="Characters" asp-action="Details" asp-route-id="@Model.CharacterId"
        class="d-block overflow-hidden fhp-r-5"
    >
        <img
            src="@portrait"
            class="fhp-r-5 fhp-transition fhp-dur300 fhp-ease fhp-group-hover-scale-110"
            alt="@Model.Name"
            loading="lazy"
        >
    </a>
    <div class="fhp-bg-navy fhp-py-20 fhp-md-py-25 fhp-lg-py-30 position-absolute bottom-0 start-0 end-0 fhp-rb-5 fhp-transition fhp-dur300 fhp-ease opacity-0 invisible fhp-group-hover-opacity-100 fhp-group-hover-visible">
        <h3 class="fs-6 fhp-md-fs-18 fhp-lg-fs-20 lh-1 fhp-mb-14 fhp-md-mb-16">
            <a
                asp-controller="Characters" asp-action="Details" asp-route-id="@Model.CharacterId"
                class="fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary"
            >
                @Model.Name
            </a>
        </h3>
        <ul class="fhp-fs-13 fhp-md-fs-14 fw-bold fhp-text-body-70 d-flex align-items-center justify-content-center flex-wrap fhp-gap-11 text-uppercase fhp-tracking-0-1em">
            <li>
                @lore
            </li>
            <li>
                <div class="fhp-w-1px fhp-bg-white-15 fhp-h-12"></div>
            </li>
            <li>
                <a
                    asp-controller="Characters" asp-action="Details" asp-route-id="@Model.CharacterId"
                    class="d-inline-block fhp-text-ae99fa fhp-transition fhp-dur300 fhp-ease fhp-hover-text-secondary"
                >
                    View Profile
                </a>
            </li>
        </ul>
    </div>
</div>
