@* Pagination in the Misao language: square mist buttons, red active state.
   Model (anonymous): int Page, int TotalPages, Func<int,string> UrlFor
   Example:
     <partial name="_Pager" model="new {
         Page = Model.Page, TotalPages = Model.TotalPages,
         UrlFor = (Func<int, string>)(p => Model.PageUrl(p)) }" /> *@
@model dynamic
@{
    var page = (int)Model.Page;
    var total = (int)Model.TotalPages;
    var urlFor = (Func<int, string>)Model.UrlFor;
}
@if (total > 1)
{
    <nav class="fhp-pager" aria-label="Pagination">
        @if (page > 1)
        {
            <a class="fhp-pager__btn" href="@urlFor(page - 1)" aria-label="Previous page">
                <i class="ri-arrow-left-line" aria-hidden="true"></i>
            </a>
        }
        else
        {
            <span class="fhp-pager__btn" aria-disabled="true"><i class="ri-arrow-left-line" aria-hidden="true"></i></span>
        }

        @for (var p = 1; p <= total; p++)
        {
            if (p == page)
            {
                <span class="fhp-pager__btn is-active" aria-current="page">@p</span>
            }
            else
            {
                <a class="fhp-pager__btn" href="@urlFor(p)">@p</a>
            }
        }

        @if (page < total)
        {
            <a class="fhp-pager__btn" href="@urlFor(page + 1)" aria-label="Next page">
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
        }
        else
        {
            <span class="fhp-pager__btn" aria-disabled="true"><i class="ri-arrow-right-line" aria-hidden="true"></i></span>
        }
    </nav>
}