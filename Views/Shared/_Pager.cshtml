@model dynamic
@{
    var page = (int)Model.Page;
    var total = (int)Model.TotalPages;
    var urlFor = (Func<int, string>)Model.UrlFor;
    const int window = 2;
    var first = Math.Max(1, page - window);
    var last = Math.Min(total, page + window);
}
@if (total > 1)
{
    <nav class="mt-5" aria-label="Pagination">
        <ul class="pagination justify-content-center flex-wrap">
            @if (page > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@urlFor(page - 1)" aria-label="Previous page">
                        <i class="ri-arrow-left-line"></i>
                    </a>
                </li>
            }
            @if (first > 1)
            {
                <li class="page-item"><a class="page-link" href="@urlFor(1)">1</a></li>
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
            @for (var p = first; p <= last; p++)
            {
                if (p == page)
                {
                    <li class="page-item active"><span class="page-link">@p</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@urlFor(p)">@p</a></li>
                }
            }
            @if (last < total)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
                <li class="page-item"><a class="page-link" href="@urlFor(total)">@total</a></li>
            }
            @if (page < total)
            {
                <li class="page-item">
                    <a class="page-link" href="@urlFor(page + 1)" aria-label="Next page">
                        <i class="ri-arrow-right-line"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}
