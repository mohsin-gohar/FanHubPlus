@* TempData flash messages. One shape for every notice on the site: a dark
   panel in the template's language, icon, copy, close. Dismissing is handled
   once in site.js (.fhp-alert__close); the panel itself is painted by
   css/fanhubplus-app.css so the template stylesheet stays untouched. *@
@{
    var ok = TempData["StatusMessage"] as string;
    var err = TempData["StatusError"] as string;
    var perr = TempData["PasswordError"] as string;
}
@if (ok != null || err != null || perr != null)
{
    <div class="fhp-notices">
        @if (ok != null)
        {
            <div class="fhp-alert fhp-alert--success" role="status">
                <i class="ri-check-line" aria-hidden="true"></i>
                <span>@ok</span>
                <button type="button" class="fhp-alert__close" aria-label="Dismiss">&times;</button>
            </div>
        }
        @if (err != null)
        {
            <div class="fhp-alert fhp-alert--warning" role="alert">
                <i class="ri-alert-line" aria-hidden="true"></i>
                <span>@err</span>
                <button type="button" class="fhp-alert__close" aria-label="Dismiss">&times;</button>
            </div>
        }
        @if (perr != null)
        {
            <div class="fhp-alert fhp-alert--warning" role="alert">
                <i class="ri-lock-line" aria-hidden="true"></i>
                <span>@perr</span>
                <button type="button" class="fhp-alert__close" aria-label="Dismiss">&times;</button>
            </div>
        }
    </div>
}
