@model FanHubPlus.Models.Entities.Content
@{
    var cover = string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
        ? $"/assets/images/movies/movie{(Model.ContentId % 24) + 1}.jpg"
        : Model.ThumbnailUrl;
    var year = Model.ReleaseDate?.ToString("yyyy") ?? Model.CreatedAt.ToString("yyyy");
    var dest = ContentLinks.ControllerFor(Model.Type);
}
<article class="fhp-poster">
    <a asp-controller="@dest" asp-action="Details" asp-route-id="@Model.ContentId">
        <img src="@cover" alt="@Model.Title poster" loading="lazy" />
    </a>
    <div class="fhp-poster__body">
        <h3>
            <a asp-controller="@dest" asp-action="Details" asp-route-id="@Model.ContentId" class="text-white text-decoration-none">
                @Model.Title
            </a>
        </h3>
        <p class="fhp-poster__meta mb-0">
            @year · @Model.Type · @(Model.Category?.Name ?? "Fandom")
        </p>
    </div>
</article>
