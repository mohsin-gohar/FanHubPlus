@* A movie tile exactly as the template draws it: cover, and on hover a
   navy-black panel sliding up with the title, the IMDb chip and the meta row.
   The artwork falls back to the template's own poster set when an admin has
   not uploaded a cover, so a tile always looks composed. *@
@model FanHubPlus.Models.Entities.Content
@{
    var cover = string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
        ? $"/assets/images/movies/movie{(Model.ContentId % 24) + 1}.jpg"
        : Model.ThumbnailUrl;
    var year = Model.ReleaseDate?.ToString("yyyy") ?? Model.CreatedAt.ToString("yyyy");
    // 1-5 stars in the catalogue, shown on the template's 10-point IMDb chip.
    var avg = Model.Ratings.Count > 0 ? Model.Ratings.Average(r => r.Stars) : 0;
    var score = avg > 0 ? (avg / 5.0 * 10.0).ToString("0.0") : "—";
}
<div class="group text-center relative">
    <a
        asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId"
        class="block overflow-hidden rounded-[5px]"
    >
        <img
            src="@cover"
            class="rounded-[5px] transition-all duration-300 ease-in-out group-hover:scale-110"
            alt="@Model.Title poster"
            loading="lazy"
        >
    </a>
    <div class="bg-navy-black py-[20px] md:py-[25px] lg:py-[30px] absolute bottom-0 left-0 right-0 rounded-b-[5px] transition-all duration-300 ease-in-out opacity-0 invisible group-hover:opacity-100 group-hover:visible">
        <h3 class="text-base md:text-lg lg:text-xl leading-none mb-[14px] md:mb-[16px]">
            <a
                asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId"
                class="transition-all duration-300 ease-in-out hover:text-secondary"
            >
                @Model.Title
            </a>
        </h3>
        <div class="inline-block relative font-bold text-13 md:text-sm tracking-[0.15em] text-body/70 bg-black rounded-[5px] py-[4px] ltr:pr-[10px] rtl:pl-[10px] ltr:pl-[30px] rtl:pr-[30px]">
            <i class="ri-star-fill text-[#FF962E] absolute ltr:left-[9px] rtl:right-[9px] top-1/2 transform -translate-y-1/2"></i>
            <span class="text-secondary">@score</span>/10 IMDb
        </div>
        <ul class="text-13 md:text-sm font-bold text-body/70 flex items-center justify-center flex-wrap gap-[11px] mt-[11px] md:mt-[14px] uppercase tracking-[0.1em]">
            <li>
                @year
            </li>
            <li>
                <div class="w-px bg-white/15 h-[12px]"></div>
            </li>
            <li>
                @Model.Type
            </li>
            <li>
                <div class="w-px bg-white/15 h-[12px]"></div>
            </li>
            <li>
                <a
                    asp-controller="Explore" asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                    class="inline-block text-[#ae99fa] transition-all duration-300 ease-in-out hover:text-secondary"
                >
                    @(Model.Category?.Name ?? "Fandom")
                </a>
            </li>
        </ul>
    </div>
</div>
