@model ContactViewModel
@{
    ViewData["Title"] = "Contact us";
    ViewData["fhpBanner"] = true;
    var trail = new List<BreadcrumbItem> { new("Contact us") };

    // ContactController reports its success as a single model-level ("") state error
    var statusMessage = ViewData.ModelState.TryGetValue("", out var entry) && entry is not null && entry.Errors.Count > 0
        ? entry.Errors[0].ErrorMessage
        : null;
}

<partial name="_PageBanner" model="trail" />

<section class="fhp-section">
    <div class="container">
        <div class="fhp-layout">
            <div>
                <div class="fhp-panel fhp-panel--flush">
                    <h1 class="fhp-panel__title">Get in touch</h1>
                    <p>Questions about your account, bug reports or partnership ideas &mdash; a human reads every message and replies by e-mail.</p>

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert alert-success" role="status">@statusMessage</div>
                    }

                    <form asp-controller="Contact" asp-action="SendMessage" method="post" class="fhp-form">
                        <div class="fhp-field">
                            <label asp-for="Name" class="fhp-field__label"></label>
                            <input asp-for="Name" class="form-control form-input" placeholder="Your name" />
                            <span asp-validation-for="Name" class="fhp-field__error"></span>
                        </div>
                        <div class="fhp-field">
                            <label asp-for="Email" class="fhp-field__label"></label>
                            <input asp-for="Email" type="email" class="form-control form-input" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="fhp-field__error"></span>
                        </div>
                        <div class="fhp-field">
                            <label asp-for="Subject" class="fhp-field__label"></label>
                            <input asp-for="Subject" class="form-control form-input" placeholder="What is this about?" />
                            <span asp-validation-for="Subject" class="fhp-field__error"></span>
                        </div>
                        <div class="fhp-field">
                            <label asp-for="Message" class="fhp-field__label"></label>
                            <textarea asp-for="Message" rows="6" class="form-control form-input" placeholder="Tell us everything..."></textarea>
                            <span asp-validation-for="Message" class="fhp-field__error"></span>
                        </div>
                        <button type="submit" class="fhp-btn fhp-btn--primary fhp-btn--block">Send message</button>
                        <p class="fhp-hint fhp-mt-10">We usually reply within one business day.</p>
                    </form>
                </div>
            </div>

            <aside class="fhp-aside" aria-label="Other contact options">
                <div class="fhp-panel fhp-panel--flush">
                    <h2 class="fhp-side-title">Other ways to reach us</h2>
                    <ul class="fhp-list">
                        <li>
                            <a href="mailto:support@fanhubplus.com">support@fanhubplus.com <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a asp-controller="Support" asp-action="Index">Help centre &amp; FAQ <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a asp-controller="Chatbot" asp-action="Index">Ask the chatbot <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

<partial name="_JoinNow" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}