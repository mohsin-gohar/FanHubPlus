@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    ViewData["fhpBanner"] = true;
    var trail = new List<BreadcrumbItem> { new("Reset password") };
}

<partial name="_PageBanner" model="trail" />

<section class="fhp-section">
    <div class="container">
        <div class="fhp-auth">
            <div class="fhp-panel fhp-panel--flush">
                <span class="fhp-eyebrow">Account recovery</span>
                <h1 class="fhp-panel__title">Choose a new password</h1>
                <p class="fhp-hint fhp-mb-25">
                    Pick something you have not used before. You will be signed in straight away.
                </p>

                <form asp-action="ResetPassword" method="post" class="fhp-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="fhp-field__error"></div>

                    <div class="fhp-field">
                        <label asp-for="Email" class="fhp-field__label"></label>
                        <input asp-for="Email" class="form-control form-input" readonly />
                        <span asp-validation-for="Email" class="fhp-field__error"></span>
                    </div>
                    <div class="fhp-field">
                        <label asp-for="Password" class="fhp-field__label"></label>
                        <input asp-for="Password" class="form-control form-input" placeholder="At least 8 characters" />
                        <span asp-validation-for="Password" class="fhp-field__error"></span>
                    </div>
                    <div class="fhp-field">
                        <label asp-for="ConfirmPassword" class="fhp-field__label"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-input" />
                        <span asp-validation-for="ConfirmPassword" class="fhp-field__error"></span>
                    </div>
                    <button type="submit" class="fhp-btn fhp-btn--primary fhp-btn--block">Update password</button>
                </form>

                <p class="fhp-hint fhp-mt-20 mb-0">
                    Remembered it after all? <a class="fhp-link-strong" asp-action="Login">Back to sign in</a>
                </p>
            </div>
        </div>
    </div>
</section>

<partial name="_JoinNow" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}