@model ExploreViewModel
@{
    ViewData["Title"] = "Movies & TV Shows";
    var trail = new List<BreadcrumbItem> { new("Explore") };

    var sorts = new (string Value, string Label)[]
    {
        ("popular", "Popularity"),
        ("newest", "Recently Added"),
        ("views", "Most Watched"),
        ("title", "Alphabetical"),
    };

    // "Showing results 1-12 of 50", the template's own results line.
    var from = Model.TotalItems == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var to = from == 0 ? 0 : from + Model.Items.Count - 1;

    string Tab(bool active) =>
        "inline-block fw-bold fhp-fs-18 fhp-md-fs-20 fhp-lg-fs-22 fhp-transition fhp-ease fhp-dur300 fhp-hover-text-primary"
        + (active ? " text-primary text-decoration-underline" : "");

    // The filter row's own controls, copied from the template.
    const string Select = "form-select w-auto h-auto px-0 fhp-ltr-pr-25px fhp-rtl-pl-25px bg-transparent border-0 text-black fw-bold fhp-ltr-bg-right-center fhp-rtl-bg-left-center";

    string Label(ContentType t) => t switch
    {
        ContentType.Series => "TV Shows",
        ContentType.Movie => "Movies",
        _ => t.ToString(),
    };
}

<partial name="_PageBanner" model="trail" />

<!-- Movies & TV Shows -->
<div class="fhp-py-60 fhp-md-py-80 fhp-lg-py-100 fhp-xl-py-120 fhp-xxl-py-140">
    <div class="container fhp-xxl-px-100 fhp-xl-maxw-1920">
        <form method="get" asp-controller="Explore" asp-action="Index">
            <div class="d-flex align-items-center flex-wrap fhp-gap-15 fhp-md-gap-20 fhp-lg-gap-25 fhp-mb-20">
                <a
                    asp-controller="Explore" asp-action="Index"
                    asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-sort="@Model.Sort"
                    class="@Tab(Model.Type is null)"
                >
                    All
                </a>
                @foreach (var type in Enum.GetValues<ContentType>())
                {
                    <a
                        asp-controller="Explore" asp-action="Index"
                        asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId"
                        asp-route-type="@type" asp-route-sort="@Model.Sort"
                        class="@Tab(Model.Type == type)"
                    >
                        @Label(type)
                    </a>
                }
                <span class="d-inline-block position-relative fhp-ltr-pl-[20px] fhp-rtl-pr-[20px]">
                    <i class="ri-filter-2-fill position-absolute top-50 fhp-ty-n50 fhp-ltr-start-0 fhp-rtl-end-0"></i>
                    Filters
                </span>
                <select name="categoryId" class="@Select" onchange="this.form.submit()" aria-label="Fandom">
                    <option value="">
                        Fandoms
                    </option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId ? "selected" : null)">
                            @category.Name
                        </option>
                    }
                </select>
                <select name="type" class="@Select" onchange="this.form.submit()" aria-label="Type">
                    <option value="">
                        Type
                    </option>
                    @foreach (var type in Enum.GetValues<ContentType>())
                    {
                        <option value="@type" selected="@(Model.Type == type ? "selected" : null)">
                            @Label(type)
                        </option>
                    }
                </select>
                <label class="visually-hidden" for="exploreSearch">Search titles</label>
                <input
                    id="exploreSearch" type="search" name="search" value="@Model.Search"
                    class="form-input !w-auto fhp-h-44" placeholder="Search titles"
                />
                <button class="primary-btn" type="submit">
                    Apply
                </button>
                <a asp-controller="Explore" asp-action="Index" class="d-inline-block text-primary fhp-transition fhp-ease fhp-dur300 fhp-hover-text-black">
                    Reset
                </a>
            </div>
            <div class="d-sm-flex align-items-center justify-content-between fhp-gap-15 fhp-mb-25">
                <p class="!mb-0 flex-shrink-0">
                    Showing results @from–@to of @Model.TotalItems
                </p>
                <div class="d-flex align-items-center fhp-gap-5 fhp-mt-10 fhp-sm-mt-0">
                    <span class="d-block flex-shrink-0">
                        Sort by:
                    </span>
                    <select name="sort" class="@Select" onchange="this.form.submit()" aria-label="Sort by">
                        @foreach (var (value, label) in sorts)
                        {
                            <option value="@value" selected="@(Model.Sort == value ? "selected" : null)">
                                @label
                            </option>
                        }
                    </select>
                </div>
            </div>
        </form>
        @if (Model.Items.Count == 0)
        {
            <div class="text-center fhp-py-40 fhp-md-py-60">
                <h3 class="fhp-fs-22 fhp-md-fs-26 fhp-leading-1-07 fhp-mb-15">
                    Nothing matches those filters
                </h3>
                <p class="fhp-mb-25">
                    Try a broader search, or reset the filters to see the whole library.
                </p>
                <a asp-controller="Explore" asp-action="Index" class="primary-btn">
                    Browse everything
                </a>
            </div>
        }
        else
        {
            <div class="d-grid fhp-gcol-1 fhp-sm-gcol-2 fhp-lg-gcol-3 fhp-xl-gcol-5 fhp-gap-25">
                @foreach (var item in Model.Items)
                {
                    <partial name="_ContentCard" model="item" />
                }
            </div>

            <partial name="_Pager" model="new {
                Page = Model.Page,
                TotalPages = Model.TotalPages,
                UrlFor = (Func<int, string>)(p => Model.PageUrl(p)) }" />
        }
    </div>
</div>
<!-- End Movies & TV Shows -->

<partial name="_JoinNow" />

