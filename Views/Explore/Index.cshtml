@model ExploreViewModel
@{
    ViewData["Title"] = "Explore";
    ViewData["fhpBanner"] = true;
    var trail = new List<BreadcrumbItem> { new("Explore") };

    var sorts = new (string Value, string Label)[]
    {
        ("popular", "Most Popular"),
        ("newest", "Newest First"),
        ("views", "Most Viewed"),
        ("title", "Title A-Z"),
    };
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
                     || Model.CategoryId is > 0
                     || Model.Type is not null
                     || Model.Sort != "popular";
}

<partial name="_PageBanner" model="trail" />

<section class="fhp-section">
    <div class="container">
        <div class="fhp-layout">

            <div>
                <div class="fhp-panel fhp-panel--flush">
                    <h1 class="fhp-panel__title">Find your next obsession</h1>
                    <form method="get" class="fhp-form" role="search">
                        <div class="fhp-field">
                            <label class="fhp-field__label" for="exploreSearch">Search</label>
                            <input id="exploreSearch" type="search" name="search" value="@Model.Search"
                                   class="form-control form-input" placeholder="Title, genre or keyword" />
                        </div>
                        <div class="fhp-grid fhp-grid--2">
                            <div class="fhp-field">
                                <label class="fhp-field__label" for="exploreCategory">Fandom</label>
                                <select id="exploreCategory" name="categoryId" class="form-select form-input">
                                    <option value="">All fandoms</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="fhp-field">
                                <label class="fhp-field__label" for="exploreType">Type</label>
                                <select id="exploreType" name="type" class="form-select form-input">
                                    <option value="">All types</option>
                                    @foreach (var type in Enum.GetValues<ContentType>())
                                    {
                                        <option value="@type" selected="@(Model.Type == type)">@type</option>
                                    }
                                </select>
                            </div>
                            <div class="fhp-field">
                                <label class="fhp-field__label" for="exploreSort">Sort by</label>
                                <select id="exploreSort" name="sort" class="form-select form-input">
                                    @foreach (var (value, label) in sorts)
                                    {
                                        <option value="@value" selected="@(Model.Sort == value)">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="fhp-field fhp-field--action">
                                <button type="submit" class="fhp-btn fhp-btn--primary fhp-btn--block">Apply filters</button>
                            </div>
                        </div>
                    </form>
                    <p class="fhp-hint">
                        @Model.TotalItems @(Model.TotalItems == 1 ? "title" : "titles") found
                        @if (hasFilters)
                        {
                            <span>&middot; <a class="fhp-link-strong" asp-controller="Explore" asp-action="Index">Clear all</a></span>
                        }
                    </p>
                </div>
                @if (Model.Items.Count == 0)
                {
                    <div class="fhp-empty">
                        <h2 class="fhp-empty__title">Nothing here yet</h2>
                        <p>No titles match those filters. Try a broader search or clear the filters.</p>
                        <a class="fhp-btn fhp-btn--primary" asp-controller="Explore" asp-action="Index">Browse everything</a>
                    </div>
                }
                else
                {
                    <div class="fhp-grid fhp-grid--3 fhp-mt-25">
                        @foreach (var item in Model.Items)
                        {
                            <partial name="_ContentCard" model="item" />
                        }
                    </div>
                    <partial name="_Pager" model="new {
                        Page = Model.Page,
                        TotalPages = Model.TotalPages,
                        UrlFor = (Func<int, string>)(p => Model.PageUrl(p)) }" />
                }
            </div>

            @* ---- sticky fandom rail ---- *@
            <aside class="fhp-aside" aria-label="Fandom navigation">
                <div class="fhp-panel fhp-panel--flush">
                    <h2 class="fhp-side-title">Browse fandoms</h2>
                    <ul class="fhp-list">
                        <li>
                            <a asp-controller="Explore" asp-action="Index" class="@(Model.CategoryId is null ? "is-active" : "")">
                                All titles <span>@Model.TotalItems</span>
                            </a>
                        </li>
                        @foreach (var category in Model.Categories)
                        {
                            <li>
                                <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@category.CategoryId"
                                   class="@(Model.CategoryId == category.CategoryId ? "is-active" : "")">
                                    @category.Name <i class="ri-arrow-right-line" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>

                    <h2 class="fhp-side-title fhp-mt-25">Quick filters</h2>
                    <div class="fhp-chips">
                        @foreach (var type in Enum.GetValues<ContentType>())
                        {
                            <a class="fhp-chip @(Model.Type == type ? "is-active" : "")"
                               asp-controller="Explore" asp-action="Index"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-type="@type">@type</a>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

<partial name="_JoinNow" />