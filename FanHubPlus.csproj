<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables "dotnet user-secrets set <key> <value>" for Development, so the SQL
         password and the demo-account passwords can live outside the repository.
         No credentials are ever committed (see README.md and .gitignore). -->
    <UserSecretsId>fanhubplus-local-development</UserSecretsId>
  </PropertyGroup>

  <!-- Tests are a separate project; do not compile them into the deployed web app. -->
  <ItemGroup>
    <Compile Remove="FanHubPlus\**" />
    <Content Remove="FanHubPlus\**" />
    <None Remove="FanHubPlus\**" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity tables (IdentityUser, IdentityRole) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <!-- EF Core provider for Microsoft SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- Design-time tools => needed by "dotnet ef migrations" commands -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Package Manager Console / dotnet-ef helpers -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

