<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables "dotnet user-secrets set <key> <value>" for Development, so the SQL
         password and the demo-account passwords can live outside the repository.
         No credentials are ever committed (see README.md and .gitignore). -->
    <UserSecretsId>fanhubplus-local-development</UserSecretsId>
    <!-- Enable built-in container support -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:8.0</ContainerBaseImage>
  </PropertyGroup>

  <!-- Tests are a separate project; do not compile them into the deployed web app. -->
  <ItemGroup>
    <Compile Remove="FanHubPlus\**" />
    <Content Remove="FanHubPlus\**" />
    <None Remove="FanHubPlus\**" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity tables (IdentityUser, IdentityRole) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <!-- EF Core provider for Microsoft SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- Design-time tools => needed by "dotnet ef migrations" commands -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Package Manager Console / dotnet-ef helpers -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Caching. Microsoft.Extensions.Caching.Memory is NOT listed on purpose: it
         ships inside the Microsoft.AspNetCore.App shared framework that the Web
         SDK already references, and there is no 8.0.x package on nuget.org for it,
         so asking for 8.0.11 made restore fall back to 9.0.0 (warning NU1603) and
         dragged a .NET 9 assembly into a net8.0 app. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.11" />
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
    <!-- OpenAPI / Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
    <!-- Structured Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.3.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <!-- HTML Sanitization for XSS prevention: dropped, Ganss.Xss is not
         available from the configured NuGet source and no code uses it. -->
    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <!-- Rate Limiting + Response Compression: NO PackageReference needed.
         Both live in the Microsoft.AspNetCore.App shared framework that the
         Web SDK already references, so `using Microsoft.AspNetCore.RateLimiting;`
         and AddRateLimiter/AddResponseCompression in Program.cs compile fine.
         (Referencing them as packages fails restore - they are not on nuget.org.) -->
    <!-- WebOptimizer: dropped - nothing in the app calls AddWebOptimizer, and
         LigerShark.WebOptimizer.Mvc does not exist on nuget.org. -->
    <!-- Problem Details for RFC 9457 compliance -->
    <PackageReference Include="Hellang.Middleware.ProblemDetails" Version="6.5.1" />
    <!-- Azure Key Vault (optional, for production secrets) -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.1" />
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
  </ItemGroup>

</Project>

